// Lola Retro - pass 3: glass glow (halation), horizontal blur and downsample.
// Works in linear light so bright areas spread the right amount of light.

// Lola Retro - shared parameters, uniforms and helpers for every pass.
//
// The chain simulates the whole analog path:
//   console encoder -> cable -> TV decoder -> electron beam -> phosphor mask -> glass.
// Console timing (pixel clock, subcarrier cycles per line) decides how composite
// artefacts look, so it is part of the model.

const float TAU = 6.28318530718;

// Dither blend (RGB and S-Video, off by default): composite blended 1-pixel dither
// patterns into new colours or transparency; on RGB they stay visible as stripes.
// The blend finds the part of the picture that alternates from one console pixel to
// the next (a Gaussian window of 1.25 pixels with alternating signs, a narrow notch at
// half the pixel clock) and takes it out. Flat areas, gradients and wider detail are
// left alone. How much: Dither blend, or with Dither blend auto what composite would take
// (ditherBlend, below getTiming). Weights for offsets 0..4 and the normalisation 4 * (w1 + w3):
const float DBW[5] = float[5](1.0, 0.726149, 0.278037, 0.056135, 0.005976);
const float DBN = 3.129136;
float dbSign(int k) { return (abs(k) & 1) == 1 ? -1.0 : 1.0; }

// RF: the echo (multipath ghost) added by the antenna path
const float RF_ECHO = 0.12;      // strength
const float RF_ECHO_US = 0.8;    // delay in microseconds

// TV show (cable 4): the game seen on a TV programme. The console's RGB goes into the studio,
// where a frame synchronizer turns its 240p/288p frames into a standard interlaced picture
// (each console frame becomes one field, the next one lands half a line lower; the CRT pass
// draws every console line in both fields), onto Betacam SP tape (LR_TAPE copies), through
// the station's colour encoder and the transmitter, and from a roof antenna into an ordinary
// TV, which decodes it like composite. Bandwidths in MHz at -3 dB.
// Sony BVW-75P: Y 5.5 MHz -3 dB, colour 1.5 MHz -1.5 dB (about 2.1 MHz at -3 dB);
// ITU-R BT.470: PAL U and V less than 3 dB down at 1.3 MHz. The transmitter's 5 MHz limit
// (PAL B/G) and the receiving TV's IF filter: the same IF filter as on RF (IF_PAL, IF_NTSC in decode.inc).
const float SHOW_TAPE_Y = 5.5;   // Betacam SP luma, one copy
const float SHOW_TAPE_C = 2.1;   // Betacam SP colour difference signals, one copy
const float SHOW_ENC_C = 1.3;    // the station's colour encoder (U and V)
const float SHOW_GHOST_US = 1.2; // delay of the antenna ghost: a reflection about 360 m longer

bool isShow(float cable) { return cable > 3.5; }

// Echo on the antenna path: x = strength, y = delay in microseconds
vec2 rfEcho(float cable)
{
    if (cable < 0.5) return vec2(RF_ECHO, RF_ECHO_US);
    if (isShow(cable)) return vec2(LR_GHOST, SHOW_GHOST_US);
    return vec2(0.0, 1.0);
}

// The console's TV standard from the core's frame rate (OriginalFPS, docs/sources/core-frame-rates.md).
// Every 50 Hz system reports 49.7 to 50.2 frames a second, every 60 Hz one 54.7 or more (the consoles
// 59.2 to 60.1), so below 52 is PAL whatever the line count: most PAL SNES games and the Mega Drive's
// 224-line mode have 224 lines. Exactly 60 says nothing: the image viewer, Play! (PAL games too) and
// FinalBurn Neo's default report it whatever the content, and the cores that report it for NTSC
// (PicoDrive, Mupen64Plus-Next) send at most 240 lines a field, which the line count takes as NTSC
// too. Returns 1 PAL, 0 NTSC, -1 when the rate is missing (RetroArch before 1.20, the Amiberry and
// 86Box ports) or says nothing: then the line count decides (getTiming).
float rateStandard()
{
    return -1.0;
}

// TV show: how the programme's lines map to the console's. x: raster lines per console line
// (2 for a 240p/288p console, whose line is drawn in both fields), y: console lines per
// programme line (1 unless the studio's standards converter scaled the picture to the other
// TV standard), z: the console line of programme line 0 (a shorter frame sits in the middle),
// w: the programme's lines (one field for a 240p/288p console, the whole frame for an
// interlaced one). lines: the console's native lines.
vec4 showLines(float pal, float interlace, float lines)
{
    bool prog = interlace < 0.5;
    float field = pal > 0.5 ? 288.0 : 240.0;
    float plines = prog ? field : 2.0 * field;
    // the console's own standard by the same rule as TV standard auto (getTiming): the frame rate
    // where it says, otherwise the line count
    float rs = rateStandard();
    bool ownPal = rs < -0.5 ? (prog ? lines : lines * 0.5) > 240.5 : rs > 0.5;
    float own = (ownPal ? 288.0 : 240.0) * (prog ? 1.0 : 2.0);
    float scv = own / plines;
    // (lines of an upscaled frame can be a hair off a whole number: a margin)
    return vec4(prog ? 2.0 : 1.0, scv, 0.5 * scv - 0.5 - floor(0.5 * (own - lines) + 0.01), plines);
}

// The TV presets run the encoder and decoder at a fixed 1280 samples per line (about 27 MHz,
// 4 per pixel of a 320-wide console), whatever the frame's width: the signal needs no more,
// and an upscaled frame (internal resolution) then costs no more than a native one. A frame
// wider than that is averaged down to it in the native pass. (The PC and Amiga presets keep
// 4 samples per frame pixel: their beam reads every pixel exactly.)
const float ENC_SAMPLES = 1280.0;

// The tv-show-broadcast preset has one more pass (show-lines.slang) that makes one beam row
// per programme line, so the CRT pass does not interpolate at every screen pixel. Its output
// is this many rows high: more than any programme has, and a height the beam pass of the other
// presets never has, so the CRT pass can tell which rows it gets.
const float SHOW_LINES_ROWS = 577.0;

float hash13(vec3 p3)
{
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}

// ---------------------------------------------------------------------------
// Console timing
// ---------------------------------------------------------------------------
// Console ids: 1 SNES/NES, 2 Mega Drive H40, 3 Mega Drive H32 and Master System, 4 PlayStation,
// 5 PlayStation 2, 6 Amiga, 7 PC VGA (also the PC-98's 640x400), 8 Arcade 15 kHz, 9 Arcade 24 kHz,
// 10 Sharp X68000 on its own monitor, 11 the same with 256-line frames at 15 kHz (see x68Raster).
// Other systems use the id with their timing (PC Engine, Saturn, N64: 4).

float autoConsole(vec2 s)
{
    float w = s.x, h = s.y;
    bool mon15 = LR_MON_MM > 0.5;    // a 15 kHz monitor cannot show 31 kHz VGA
    // 640x400 is VGA's 400 lines and the PC-98's: on a computer monitor the same picture
    if (!mon15 && ((w == 320.0 && h == 200.0) || (w == 640.0 && (h == 350.0 || h == 400.0)))) return 7.0;
    if (h == 256.0 || h == 512.0 || (w == 640.0 && h == 200.0)) return 6.0;
    if (mon15 && (h == 200.0 || h == 400.0) && (w == 320.0 || w == 640.0)) return 6.0;
    // PUAE's default frames: the whole overscan area, 360, 720 or 1440 wide (PAL 287 or 574 rows, NTSC 242 or 484)
    if ((w == 360.0 || w == 720.0 || w == 1440.0) && (h == 287.0 || h == 574.0 || h == 242.0 || h == 484.0)) return 6.0;
    if (h >= 336.0 && h <= 400.0 && w >= 400.0) return 9.0;
    if (h > 300.0) return 5.0;
    if (w > 420.0) return 4.0;
    // 192 lines: the Master System (and MSX, ColecoVision), 228 cycles per line like the Mega Drive
    if (w == 256.0 && h == 192.0) return 3.0;
    if (w <= 300.0) return 1.0;
    if (h >= 232.0) return 4.0;
    return 2.0;
}

// a: pixel clock NTSC, pixel clock PAL (MHz), nominal width, scan mode (0 TV, 1 VGA, 2 fill,
//    3 the X68000's monitor: 15 and 31 kHz on one tube, see x68Raster)
// b: subcarrier phase step per line (NTSC, PAL), per field (NTSC, PAL)
// c: x = 1 when the PAL line count per field is odd (V-switch flips every field)
void consoleTable(float id, out vec4 a, out vec4 b, out float c)
{
    if (id < 1.5)      { a = vec4(5.369318, 5.320342, 256.0, 0.0); b = vec4(1.0 / 3.0, 1.0 / 6.0, 1.0 / 3.0, 0.0);  c = 0.0; }
    else if (id < 2.5) { a = vec4(6.711647, 6.650428, 320.0, 0.0); b = vec4(0.0, 0.0, 0.0, 0.0);                    c = 1.0; }
    else if (id < 3.5) { a = vec4(5.369318, 5.320342, 256.0, 0.0); b = vec4(0.0, 0.0, 0.0, 0.0);                    c = 1.0; }
    else if (id < 4.5) { a = vec4(6.711647, 6.652800, 320.0, 0.0); b = vec4(0.5, 0.75, 0.5, 0.5);                  c = 0.0; }
    else if (id < 5.5) { a = vec4(13.5, 13.5, 640.0, 0.0);        b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else if (id < 6.5) { a = vec4(7.15909, 7.09379, 320.0, 0.0);  b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else if (id < 7.5) { a = vec4(12.5875, 12.5875, 320.0, 1.0);  b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else if (id < 8.5) { a = vec4(6.711647, 6.711647, 320.0, 0.0); b = vec4(0.5, 0.75, 0.5, 0.5);                  c = 0.0; }
    else if (id < 9.5) { a = vec4(16.0, 16.0, 496.0, 2.0);        b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else               { a = vec4(34.78, 34.78, 768.0, 3.0);      b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
}

// TV timings (and auto): everything but the Amiga, VGA, 24 kHz arcade and X68000 (6, 7, 9, 10, 11)
bool tvTiming(float id) { return id < 5.5 || (id > 7.5 && id < 8.5); }

// The Sharp X68000 on its own monitor (Console timing 10 and 11): the CZ-600D and its family took
// 15, 24 and 31 kHz on one tube, and Sharp's manuals (CZ-605D/613D, CZ-614D) give one picture size,
// 278 x 209 mm, for all of them: 240 active lines at 15 kHz (52.69 us of each line), 400 at 24 kHz,
// 512 at 31 kHz (22.08 us). px68k sends the CRTC's display window, no borders (TextDotX x TextDotY),
// so the frame's rows tell the mode (docs/sources/x68000-video.md):
// - up to 240 rows: 15 kHz, one raster per row, in the 240 lines of the picture: the gaps show;
// - 241-300 rows: 31 kHz with every line scanned twice (512 rasters, no gaps), the X68000's usual
//   game mode (256x256, 512x256). Console timing 11 takes them as 15 kHz instead, for the games
//   with a 256-line window at 15 kHz: the frame alone cannot tell (only the frame rate, 55 or 61 Hz);
// - more: every row is a raster, filling the height: 512 lines at 31 kHz (768x512, the Human68k
//   prompt), both fields of 15 kHz interlace (512x480), 24 kHz modes (400 lines).
// Returns x: rasters per row, y: rasters across the picture height, z: active line time (us).
vec3 x68Raster(float rows, float id)
{
    bool k15 = id > 10.5;
    if (rows <= 240.5 || (k15 && rows <= 300.0)) return vec3(1.0, 240.0, 52.69);
    if (rows <= 300.0) return vec3(2.0, 512.0, 22.08);
    return vec3(1.0, rows, rows <= 480.5 ? 52.69 : 22.08);
}

// Internal resolution: an upscaled frame (more than 576 lines, or a console set by hand
// whose native mode is smaller) is read as k x k blocks of one native pixel.
// The frame's size cannot tell a console's own 480i from a 240-line game at 2x: both are 480
// lines. Frames over 300 lines 1 says it is always the console's 480i/576i, on every TV timing:
// the 480-line base of the PlayStation 2 (Console timing 5). For cores that never upscale
// (Beetle Saturn sends its 480i as 640x448 or 704x480) and cores at 1x. An upscaled interlaced
// frame is still found: 960 lines are 480i at 2x, 1152 lines 576i at 2x. 0 keeps the guess below.
// 2 (the computer monitor, see getTiming) finds the native lines the same way.
// More than one k can fit: 1440 lines are 240 lines at 6x and 288 at 5x, 1120 lines 224 at 5x
// and 280 at 4x. A k that gives a standard height wins: 240 or 224 lines for NTSC, 288 or 256
// for PAL (twice that in the 480i class), NTSC first unless TV standard is set to PAL or, on auto,
// the frame rate says PAL (rateStandard). Without one, the smallest k that fits
// (docs/sources/internal-resolution.md).
// Returns k (1 for native frames).
float upscaleOf(vec2 orig)
{
    float id = LR_CONSOLE;
    bool tv = tvTiming(id);                              // VGA, Amiga and 24 kHz modes are never scaled
    // 480i class: PS2 by hand, or any TV timing with Frames over 300 lines 1 or 2; otherwise 240p class
    bool il = tv && (LR_HIRES > 0.5 || (id > 4.5 && id < 5.5));
    float base = il ? 480.0 : 240.0;
    bool scaled = (id < 0.5 && !il) ? orig.y > 576.0 : (tv && orig.y > base * 1.5);
    if (!scaled) return 1.0;
    // the standard heights, the preferred one first
    bool palFirst = LR_NORM > 1.5 || (LR_NORM < 0.5 && rateStandard() > 0.5);
    vec4 hs = (palFirst ? vec4(288.0, 256.0, 240.0, 224.0) : vec4(240.0, 224.0, 288.0, 256.0))
            * (il ? 2.0 : 1.0);
    float first = 0.0, best = 0.0, rank = 4.0;
    for (float k = 2.0; k <= 16.0; k += 1.0)
    {
        // whole lines: rounded and multiplied back, as a division can land a hair off a whole number
        float lines = floor(orig.y / k + 0.5);
        if (lines * k != orig.y || lines < base * 0.83 || lines > base * 1.21) continue;
        if (first < 0.5) first = k;
        for (int j = 0; j < 4; j++)
        {
            if (lines == hs[j] && float(j) < rank) { best = k; rank = float(j); }
        }
    }
    if (best > 0.5) return best;
    if (first > 0.5) return first;
    // the computer monitor takes any other frame as it is: 1024x768 is a computer's own mode
    if (il && LR_HIRES > 1.5) return 1.0;
    return max(1.0, floor(orig.y / base + 0.5));
}

struct Timing
{
    float pclk;        // pixel clock for this source width (MHz)
    float fsc;         // colour subcarrier (MHz)
    float lineFrac;    // subcarrier phase advance per line (cycles)
    float fieldStep;   // phase advance per field (cycles)
    float framePhase;  // phase offset of the current field (cycles)
    float altStep;     // > 0: the phase only alternates between 0 and this from frame to frame (NES, SNES)
    float vsw;         // PAL V-switch offset for this field
    float vswStep;     // change of the V-switch offset per field (1 when the line count per field is odd)
    float pal;         // 1 = PAL
    float scan;        // 0 TV raster, 1 VGA line doubling, 2 fill (24 kHz arcade)
    float interlace;   // 1 = 480i/576i source
    float scale;       // internal resolution factor of the core (1 = native)
    float id;          // console timing id (see consoleTable)
    float hres;        // frame pixels per console pixel (Amiga: 1 lores, 2 hires, 4 superhires)
    float monitor;     // 1 = drawn on the computer monitor (Frames over 300 lines 2)
    float cable;       // the cable in use: Cable, or 3 (RGB) on the computer monitor
};

bool isAmiga(Timing t) { return t.id > 5.5 && t.id < 6.5; }

Timing getTiming(vec2 orig, uint frameCount)
{
    Timing t;
    t.scale = upscaleOf(orig);
    vec2 nat = orig / t.scale;                          // the console's native mode
    float id = LR_CONSOLE < 0.5 ? autoConsole(nat) : LR_CONSOLE;
    // Frames over 300 lines 2: a frame with more than 300 native lines on a TV timing is drawn
    // as if the user had switched to a separate computer monitor, as people did (an Atari ST
    // owner had a high-res monitor for the desktop and a TV for games). That monitor is the PC
    // monitor model: VGA timing (scan mode 1: every line once, filling the height), the tube in
    // mm from the Monitor values, RGB, sRGB phosphors and a dot mask (phosphorSet, maskType),
    // whatever the preset's cable and timing; frames of 300 lines or fewer keep the preset.
    // A compromise: one screen stands in for two and switches by itself, and the rest of the
    // preset (the glass and its curvature, overscan, convergence, white point, the TV's knobs)
    // stays as it is. Passes read the cable from here (t.cable), never from Cable directly.
    t.monitor = (LR_HIRES > 1.5 && tvTiming(id) && nat.y > 300.0) ? 1.0 : 0.0;
    if (t.monitor > 0.5) id = 7.0;
    bool x68 = id > 9.5;                                // the X68000's monitor: RGB only
    t.cable = (t.monitor > 0.5 || x68) ? 3.0 : LR_CABLE;
    vec4 a; vec4 b; float c;
    consoleTable(id, a, b, c);
    t.id = id;
    if (id > 4.5 && id < 5.5 && nat.x > 700.0) a.z = 720.0;   // PS2 720-wide modes keep 13.5 MHz
    t.scan = a.w;
    t.interlace = (t.scan < 0.5 && nat.y > 300.0) ? 1.0 : 0.0;
    bool amiga = id > 5.5 && id < 6.5;
    if (t.monitor > 0.5) t.pal = 0.0;                   // a computer monitor has no TV standard
    else if (LR_NORM > 1.5) t.pal = 1.0;
    else if (LR_NORM > 0.5) t.pal = 0.0;
    else
    {
        // the core's frame rate where it says (rateStandard), otherwise the line count: an Amiga
        // NTSC frame with its overscan border has up to 243 lines, a PAL one 256 or more
        float lines = t.interlace > 0.5 ? nat.y * 0.5 : nat.y;
        float rs = rateStandard();
        bool palLines = lines > (amiga ? 249.5 : 240.5);
        t.pal = (t.scan < 0.5 && (rs < -0.5 ? palLines : rs > 0.5)) ? 1.0 : 0.0;
    }
    // full source width: a wider (upscaled) line still takes the same time
    float base = mix(a.x, a.y, t.pal);
    t.pclk = base * orig.x / a.z;
    // Amiga: the width tells lores, hires or superhires. Emulators often send the whole
    // overscan area (PUAE and Amiberry: 720 wide in hires), so a wider frame is a longer
    // line at the same pixel clock, not faster pixels.
    float cls = orig.x < 480.0 ? 1.0 : (orig.x < 960.0 ? 2.0 : 4.0);
    if (amiga) t.pclk = base * (320.0 * cls) / a.z;
    // SVGA modes run faster lines: VESA 75 Hz clocks (800x600 49.5 MHz, 1024x768 78.75 MHz)
    if (t.scan > 0.5 && t.scan < 1.5 && orig.x > 720.0) t.pclk = 78.75 * orig.x * orig.y / (1024.0 * 768.0);
    // the computer monitor: an upscaled frame runs at its native mode's clock (k pixels per pixel)
    if (t.monitor > 0.5) t.pclk = (nat.x > 720.0 ? 78.75 * nat.x * nat.y / (1024.0 * 768.0) : base * nat.x / a.z) * t.scale;
    // X68000: the window's pixels across the mode's active line time
    if (x68) t.pclk = orig.x / x68Raster(orig.y, id).z;
    t.hres = amiga ? cls : orig.x / a.z;
    t.fsc = t.pal > 0.5 ? 4.433619 : 3.579545;
    // TV show: the station's encoder makes the subcarrier of a standard interlaced broadcast,
    // so its rhythm is the standard's (the PlayStation 2 row), not the console's
    if (isShow(t.cable)) { b = vec4(0.5, 0.75, 0.75, 0.875); c = 0.0; }
    // PlayStation, Saturn and N64 in 480i/576i: 525 (625) lines per frame, as the standard, not
    // twice their 263 (314) progressive lines: psx-spx gives 262.5 lines per NTSC field and 312.5
    // per PAL field, n64brew 525 half-lines (VI_V_TOTAL 524), Mednafen's Saturn alternates fields
    // of 263 and 262 lines. With 227.5 (283.75) cycles per line the phase then moves 3/4 (7/8) of
    // a cycle per field, as on the PlayStation 2.
    if (id > 3.5 && id < 4.5 && t.interlace > 0.5) { b.z = 0.75; b.w = 0.875; }
    t.lineFrac = mix(b.x, b.y, t.pal);
    t.fieldStep = mix(b.z, b.w, t.pal);
    // 24 is a multiple of every field cycle above (1, 2, 3, 4, 8), so the phase never drifts
    float fc = LR_STEADY > 0.5 ? 0.0 : float(frameCount % 24u);
    // NES and SNES (NTSC, not interlaced): 1364 master clocks per line, 227 1/3 cycles, so a
    // 262-line frame moves the phase by 1/3 cycle. But every other frame is 4 clocks short (the
    // NES skips a dot, the SNES shortens one line), which moves it by 2/3 instead, so the phase
    // only alternates between two values, 2/3 cycle apart: the dots jitter instead of crawling.
    // (A 3-frame crawl only happens in the few NES games that blank the start of the frame.)
    t.altStep = (id < 1.5 && t.pal < 0.5 && t.interlace < 0.5) ? 2.0 / 3.0 : 0.0;
    t.framePhase = t.altStep > 0.0 ? t.altStep * mod(fc, 2.0) : fract(fc * t.fieldStep);
    t.vsw = mod(fc * c, 2.0);
    t.vswStep = c;
    return t;
}

// The gain of a Gaussian low-pass with -3 dB at fc (MHz) at frequency f (MHz), the filters of the
// encoder and decoder: exp(-2 pi^2 (0.1325 / fc)^2 f^2)
float gaussGain(float f, float fc)
{
    float s = 0.1325 / fc;
    return exp(-19.7392 * s * s * f * f);
}

// How much Dither blend takes out of a 1-pixel pattern (the part that alternates from one console
// pixel to the next, at half the pixel clock): x of its luma, y of its colour. Dither blend sets both.
// Dither blend auto takes what composite would have taken (docs/sources/dither-blend.md): the luma
// share from the filters of the composite path at that frequency, the console's luma trap
// (encode.inc) and the TV's luma filter with Sharpness and its trap or comb filter (decode.inc),
// against the path in use (cable 3 RGB: the video amplifier; 2 S-Video: its luma filter), so the
// pattern keeps the contrast it would have had on composite. Composite took all of its colour (the
// chroma band is 0.6 to 0.8 MHz wide, the pattern 2.5 MHz or more), so the colour share is 1; S-Video's
// own chroma filters already take it. Auto works on 15 kHz TV timings, the consoles and the Amiga,
// which reached most players through composite; arcade boards (RGB monitors) and computer monitors
// keep Dither blend as set. It follows the mode (a Mega Drive game switching between 256 and 320
// pixels), the TV standard (t.pal) and the composite settings, and only knows 1-pixel patterns.
vec2 ditherBlend(Timing t, float cable)
{
    float d = LR_DBLEND;
    bool tv = t.scan < 0.5 && t.monitor < 0.5 && !(t.id > 7.5 && t.id < 8.5);
    if (LR_DBLEND_AUTO < 0.5 || !tv) return vec2(d);
    bool pal = t.pal > 0.5;
    float fsc = pal ? 4.433619 : 3.579545;
    float f = 0.5 * t.pclk / t.scale;                 // the pattern's frequency (MHz)
    float sh = LR_SHARP * 1.4;
    // composite as decode.inc decodes it: the comb filter (NTSC, lines half a cycle apart) or the trap
    bool comb = LR_COMB > 0.5 && !pal && abs(t.lineFrac - 0.5) < 0.05;
    float fcY = (comb || pal) ? 4.2 : 3.3, fcC = pal ? 0.8 : 0.6;
    float yf = (1.0 + sh) * gaussGain(f, fcY) - sh * gaussGain(f, fcY / 2.5);
    float hf = (1.0 + sh) * gaussGain(fsc, fcY) - sh * gaussGain(fsc, fcY / 2.5);
    float notch = comb ? 0.0 : 0.92 * hf * (gaussGain(f - fsc, fcC) + gaussGain(f + fsc, fcC));
    float comp = (1.0 - LR_YTRAP * (gaussGain(f - fsc, 0.5) + gaussGain(f + fsc, 0.5))) * (yf - notch);
    float fcS = pal ? 5.0 : 4.6;
    float own = cable > 2.5 ? gaussGain(f, 6.5) : (1.0 + sh) * gaussGain(f, fcS) - sh * gaussGain(f, fcS / 2.5);
    return vec2(clamp(1.0 - comp / own, 0.0, 1.0), 1.0);
}

// Frame pixels and rows per console pixel and line, for effects sized on the glass (glow,
// misconvergence). Only the Amiga needs it: its emulators send hires frames (2 pixels per lores
// pixel) and draw every line twice or weave two fields. Other consoles keep (1, 1).
vec2 consoleUnit(Timing t) { return isAmiga(t) ? vec2(t.hres, t.interlace > 0.5 ? 2.0 : 1.0) : vec2(1.0); }

// y is a source row; rows of one upscaled block belong to the same native line. The row's centre
// is divided: for the first row of a line y / k is a whole number, and a GPU's division can land
// a hair under it (AMD at 3x), which would put the row in the line before.
float nativeLine(float y, Timing t) { return floor((y + 0.5) / t.scale); }
float physLine(float y, Timing t) { float l = nativeLine(y, t); return t.interlace > 0.5 ? floor(l * 0.5) : l; }
bool oddField(float y, Timing t) { return t.interlace > 0.5 && mod(nativeLine(y, t), 2.0) > 0.5; }

// Subcarrier phase at time tUs (microseconds from the start of the active line) on line y,
// off cycles later in the frame sequence (see steadyFrames)
float phaseAtOff(float tUs, float y, Timing t, float off)
{
    float fo = oddField(y, t) ? t.fieldStep : 0.0;
    return TAU * fract(fract(t.fsc * tUs) + fract(t.lineFrac * physLine(y, t)) + fo + t.framePhase + off);
}
float phaseAt(float tUs, float y, Timing t) { return phaseAtOff(tUs, y, t, 0.0); }

// PAL alternates the sign of V on every line; vsw: the V-switch offset of the frame
float vSignW(float y, Timing t, float vsw)
{
    if (t.pal < 0.5) return 1.0;
    float pl = physLine(y, t) + vsw + (oddField(y, t) ? 1.0 : 0.0);
    return mod(pl, 2.0) < 0.5 ? 1.0 : -1.0;
}
float vSign(float y, Timing t) { return vSignW(y, t, t.vsw); }

// No flicker: the frames the eye blends together.
// Most consoles shift the colour subcarrier from one frame to the next (a 2-frame cycle on the
// PlayStation, up to 8 in PAL), so the cross-colour and the dots along coloured edges move. At
// 50 or 60 frames a second the eye sees their average, in which they largely cancel. A single
// frozen frame would show all of them at full strength, more than anyone ever saw. So with No
// flicker on, the encoder makes the signal for two or three frames of the cycle and the decoder
// averages what they show: the three frames of a 3-frame cycle, otherwise the first frame and
// the one half a subcarrier cycle on (every 2, 4 and 8-frame cycle reaches it), which cancels the
// same artefacts. The NES and SNES alternate between two phases 2/3 cycle apart: their average
// only halves the artefacts, as on the real console. With No flicker off, one frame: the moving
// original.
// Returns the number of frames (1 to 3); off: their phase offsets (cycles), vsw: their PAL
// V-switch offsets.
int steadyFrames(Timing t, out vec3 off, out vec3 vsw)
{
    off = vec3(0.0);
    vsw = vec3(t.vsw, 0.0, 0.0);
    if (LR_STEADY < 0.5) return 1;
    if (t.altStep > 0.0)
    {
        off.y = t.altStep;
        return 2;
    }
    float s = t.fieldStep;
    if (abs(s - 1.0 / 3.0) < 0.01 || abs(s - 2.0 / 3.0) < 0.01)
    {
        off = vec3(0.0, fract(s), fract(2.0 * s));
        vsw = vec3(0.0, mod(t.vswStep, 2.0), mod(2.0 * t.vswStep, 2.0));
        return 3;
    }
    for (float k = 1.0; k <= 8.0; k += 1.0)
    {
        if (abs(fract(k * s) - 0.5) < 0.01)
        {
            off.y = 0.5;
            vsw.y = mod(k * t.vswStep, 2.0);
            return 2;
        }
    }
    // no phase change, but a PAL V-switch that flips every frame (odd line count per field)
    if (t.pal > 0.5 && t.vswStep > 0.5)
    {
        vsw.y = 1.0;
        return 2;
    }
    return 1;
}

// ---------------------------------------------------------------------------
// Monitor in millimetres: PC monitors (31 kHz modes) and the X68000's monitor always, and 15 kHz
// monitors such as the Commodore 1084S when "15 kHz monitor in mm" is on. The tube is described
// like on its spec sheet (size, mask pitch, beam spot on dark and on white), so every video mode
// follows from the same tube: 320x200 doubled to 400 lines or 1024x768 on a PC monitor, PAL or
// NTSC on the 1084S (NTSC lines sit further apart, so they show more), 240 lines at 15 kHz with
// clear gaps and 512 nearly merged at 31 kHz on the X68000's.
// Typical mid-90s 15-inch PC monitor: 13.8-14 inch viewable, 0.28 mm dot pitch, a spot of
// about 0.45 mm on white (sharp at 800x600, soft at 1024x768), dynamic focus keeping the
// corners below 1.5 x the centre spot.
// ---------------------------------------------------------------------------

const float FWHM_TO_SIGMA = 0.4246609;   // Gaussian: sigma = FWHM / (2 sqrt(2 ln 2))

bool isPC(float scan) { return (scan > 0.5 && scan < 1.5) || scan > 2.5; }   // VGA, and the X68000's monitor

// the tube is described in mm
bool inMM(float scan) { return isPC(scan) || (scan < 0.5 && LR_MON_MM > 0.5); }

// The mask: the preset's, or on the computer monitor (Frames over 300 lines 2) the PC monitor's
// dot mask, at its pitch in mm (Dot pitch); a mask turned off (0) stays off
float maskType(Timing t) { return (t.monitor > 0.5 && LR_MASK_TYPE > 0.5) ? 3.0 : LR_MASK_TYPE; }

// Viewable tube face in mm: one inch less than the nominal size, 4:3
vec2 monTubeMM()
{
    float d = (LR_MON_SIZE - 1.0) * 25.4;
    return vec2(0.8 * d, 0.6 * d);
}

// The share of the scan that shows on the tube, across and down: less than 1 when overscan is
// positive (the picture runs past the edges), more when it is negative (a black border).
// Overscan sets both; Overscan height is added to it for the height alone.
vec2 monShown() { return vec2(1.0 - LR_OVERSCAN, 1.0 - LR_OVERSCAN - LR_OVERSCAN_V); }

// The full scan (active line x active lines) in mm: smaller than the tube face when
// overscan is negative (black border), larger when it is positive
vec2 monScanMM() { return monTubeMM() / monShown(); }

// The spot grows toward the corners (deflection defocus); c is the position on the tube, -1..1
float monCornerGrowth(vec2 c) { return 1.0 + (LR_MON_CORNER - 1.0) * 0.5 * dot(c, c); }

// Share of the active line that the source covers. A 15 kHz monitor in mm shows the whole
// active line (52.6 us NTSC, 52 us PAL), so a 320-pixel Amiga line (45 us) leaves side
// borders, like the real 1084S. PC monitors and the TV model fill the width.
float activeShare(Timing t, vec2 orig)
{
    if (!(t.scan < 0.5 && LR_MON_MM > 0.5)) return 1.0;
    return min(orig.x / t.pclk / (t.pal > 0.5 ? 52.0 : 52.6), 1.0);
}

// Standard normal density and cumulative distribution
// (erf after Abramowitz & Stegun 7.1.26, error below 1.5e-7)
vec3 gaussPdf(vec3 z) { return 0.39894228 * exp(-0.5 * z * z); }
vec3 gaussCdf(vec3 z)
{
    vec3 x = abs(z) * 0.70710678;
    vec3 t = 1.0 / (1.0 + 0.3275911 * x);
    vec3 p = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t;
    return 0.5 + 0.5 * sign(z) * (1.0 - p * exp(-x * x));
}

// ---------------------------------------------------------------------------
// Colour of the TV: its chroma decoder and its phosphors
// ---------------------------------------------------------------------------

// Chroma decoder: 1 = by the standard. American and Japanese TVs demodulated R-Y and G-Y
// on shifted axes with their own gains ("red push", warmer skin tones). PAL TVs, broadcast
// monitors and RGB inputs use the standard axes. A TV show reaches the TV as composite.
float decoderType(Timing t, float cable)
{
    if (t.monitor > 0.5) return 1.0;                  // the computer monitor: RGB, no decoder
    if (LR_DEMOD > 0.5) return LR_DEMOD;
    return (t.pal < 0.5 && (cable < 2.5 || isShow(cable))) ? 2.0 : 1.0;
}

// R, G, B from Y and the demodulated U, V (U = 0.492 (B-Y), V = 0.877 (R-Y)).
// Consumer axes and gains from the Sony CXA2025AS datasheet, relative to B-Y:
// US mode R-Y 112 deg x0.83, G-Y 252 deg x0.30; Japanese mode R-Y 95 deg x0.78, G-Y 240 deg x0.30.
vec3 decodeRGB(float Y, vec2 uv, float dec)
{
    if (dec < 1.5)
        return vec3(Y + 1.13983 * uv.y, Y - 0.39465 * uv.x - 0.58060 * uv.y, Y + 2.03211 * uv.x);
    bool us = dec < 2.5;
    float ar = radians(us ? 112.0 : 95.0), gr = us ? 0.83 : 0.78;
    float ag = radians(us ? 252.0 : 240.0), gg = 0.30;
    float ry = (uv.x * cos(ar) + uv.y * sin(ar)) * gr / 0.492;
    float gy = (uv.x * cos(ag) + uv.y * sin(ag)) * gg / 0.492;
    return vec3(Y + ry, Y + gy, Y + uv.x / 0.492);
}

// Phosphors: 1 sRGB / Rec.709, 2 SMPTE-C (NTSC sets), 3 EBU (PAL sets, broadcast monitors),
// 4 Japanese P22 (Sony Trinitron and Japanese sets, arcade monitors).
float phosphorSet(Timing t)
{
    if (t.monitor > 0.5) return 1.0;                  // the computer monitor (Frames over 300 lines 2)
    if (LR_PHOS > 0.5) return LR_PHOS;
    if (t.scan > 0.5 && t.scan < 1.5) return 1.0;   // PC monitors: sRGB was defined from them
    if (t.id > 7.5) return 4.0;                       // arcade monitors, the X68000's (Japanese)
    return t.pal > 0.5 ? 3.0 : 2.0;
}

// Linear phosphor RGB -> linear Rec.709 RGB, white (D65) kept. Primaries (x, y):
// SMPTE-C R .630 .340 G .310 .595 B .155 .070; EBU R .640 .330 G .290 .600 B .150 .060;
// Japanese P22 R .625 .350 G .280 .605 B .152 .062 (Sony KV-20M20 and others, via Dogway's grade).
mat3 phosphorMatrix(float p)
{
    if (p < 2.5) return mat3(0.939542, 0.017772, -0.001622, 0.050181, 0.965793, -0.004370, 0.010277, 0.016435, 1.005991);
    if (p < 3.5) return mat3(1.044043, 0.0, 0.0, -0.044043, 1.0, 0.011793, 0.0, 0.0, 0.988207);
    return mat3(1.081942, 0.038032, -0.007481, -0.088427, 0.959991, 0.015170, 0.006485, 0.001977, 0.992311);
}

#if defined(VERTEX)
uniform mat4 MVPMatrix;
in vec4 VertexCoord;
in vec2 TexCoord;
out vec2 vTexCoord;
flat out float vScale;
flat out float vUnit;    // frame pixels per console pixel (Amiga hires: 2)

void lr_main()
{
    gl_Position = MVPMatrix * VertexCoord;
    vTexCoord = TexCoord;
    Timing T = getTiming(LR_OriginalSize.xy, LR_FrameCount);
    vScale = T.scale;
    vUnit = consoleUnit(T).x;
}

void main()
{
    lr_main();
}

#elif defined(FRAGMENT)
in vec2 vTexCoord;
flat in float vScale;
flat in float vUnit;
out vec4 FragColor;
uniform sampler2D Texture;

void lr_main()
{
    // tap spacing sets the radius: half a console pixel per unit of Glass glow size, measured
    // on the frame, so it is the same at any internal resolution and decoder width
    float dx = 2.0 * LR_GLOW_SIZE * vUnit * vScale * LR_OriginalSize.z;
    vec2 tc = vTexCoord;
    if (vScale > 1.5)
    {
        // upscaled frame: the decoder put native line l in row l, in the top 1/k of its output
        float lines = LR_SourceSize.y / vScale;
        tc.y = (floor(tc.y * lines) + 0.5) * LR_SourceSize.w;
    }
    vec3 acc = vec3(0.0);
    float ws = 0.0;
    for (int k = -6; k <= 6; k++)
    {
        float w = exp(-0.5 * float(k * k) / 9.0);
        vec2 p = tc + vec2(float(k) * dx, 0.0);
        vec3 c = 0.5 * (textureLod(Texture, p - vec2(0.25 * dx, 0.0), 0.0).rgb + textureLod(Texture, p + vec2(0.25 * dx, 0.0), 0.0).rgb);
        acc += w * pow(c, vec3(LR_GAMMA));
        ws += w;
    }
    FragColor = vec4(acc / ws, 1.0);
}

void main()
{
    lr_main();
}
#endif
