mat3 demoRot(vec3 a)
{
    vec3 c = cos(a), s = sin(a);
    return mat3(c.y * c.z, c.y * s.z, -s.y,
                s.x * s.y * c.z - c.x * s.z, s.x * s.y * s.z + c.x * c.z, s.x * c.y,
                c.x * s.y * c.z + s.x * s.z, c.x * s.y * s.z - s.x * c.z, c.x * c.y);
}
vec3 demoRainbow(float x) { return 0.5 + 0.5 * cos(TAU * (x + vec3(0.0, 0.33, 0.67))); }
// one pixel of the scroller's font: glyph g, column x and row y (0-7, top row 0)
bool demoFontPixel(int g, int x, int y)
{
    uint w = DEMO_FONT[g * 2 + (y >> 2)];
    return ((w >> uint((3 - (y & 3)) * 8 + 7 - x)) & 1u) == 1u;
}
vec3 amigaDemo(vec2 fc, vec2 hs, float t, float pix)
{
    float n = pixSize(256.0, pix);
    vec2 P = floor(fc / n);                                   // the Amiga pixel, from the centre, y up
    float L = 1.0 / (n * pix);                                // the screen's height in Amiga pixels
    vec2 s = (P + 0.5) / L;                                   // its centre, in screen heights
    // the background: black in the middle, the copper fading it to deep blue at the bottom and to
    // deep violet at the top, one colour per line
    float vy = (P.y + 0.5) / L;
    vec3 col = vec3(0.02, 0.05, 0.22) * smoothstep(-0.2, -0.5, vy) + vec3(0.12, 0.02, 0.2) * smoothstep(0.3, 0.5, vy);

    // stars flying toward the viewer: layers that grow from the centre, three shades as on a 3-plane screen
    for (int i = 0; i < 4; i++)
    {
        float k = t * 0.22 + float(i) * 0.25, z = fract(k), seed = floor(k) * 4.0 + float(i);
        float cell = 0.02 * exp2(4.0 * z);
        vec2 off = 50.0 * vec2(hash13(vec3(seed, 1.0, 81.0)), hash13(vec3(seed, 2.0, 81.0)));
        vec2 id = floor(s / cell + off);
        float h = hash13(vec3(id, seed + 3.0));
        vec2 sp = (id - off + 0.25 + 0.5 * vec2(h, fract(h * 13.0))) * cell;   // the star, in screen heights
        if (h > 0.75 && all(equal(floor(sp * L), P)) && z > 0.15)
            col = max(col, vec3(z < 0.45 ? 0.27 : z < 0.75 ? 0.6 : 1.0));
    }

    // the two objects swing from one side of the monitor to the other, opposite each other
    float sw = sin(t * 0.42), A = max(hs.x - 0.22, 0.3);
    vec2 cg = vec2(A * sw, 0.06 * sin(t * 0.9));               // the glenz vector
    vec2 cb = vec2(-A * sw, 0.06 * sin(t * 0.9 + 2.0));        // the vector balls

    // glenz vector: a tetrakis hexahedron (a cube with a low pyramid on each face). A ray from the eye
    // enters through one face and leaves through another; white faces are solid, blue ones show the
    // back faces through them, as two bitplanes of front and back faces did
    const float H = 0.6, GS = 0.1;
    vec2 u = (s - cg) / GS;
    if (dot(u, u) < 8.0)
    {
        mat3 R = demoRot(vec3(t * 0.8, t * 1.1, t * 0.5));
        vec3 o = vec3(0.0, 0.0, 5.0) * R, d = vec3(u, -5.0) * R;   // the ray, in the object's frame
        float tin = -1e9, tout = 1e9;
        int kin = 0, kout = 0;
        for (int k = 0; k < 24; k++)
        {
            int f = k / 4, e = k % 4, ax = f / 2, ex = (ax + 1 + e / 2) % 3;
            vec3 nk = (ax == 0 ? vec3(1.0, 0.0, 0.0) : ax == 1 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0)) * (f % 2 == 0 ? 1.0 : -1.0)
                    + (ex == 0 ? vec3(1.0, 0.0, 0.0) : ex == 1 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0)) * (e % 2 == 0 ? H : -H);
            float nd = dot(nk, d), tt = (1.0 + H - dot(nk, o)) / nd;
            if (nd < 0.0) { if (tt > tin) { tin = tt; kin = k; } }
            else if (tt < tout) { tout = tt; kout = k; }
        }
        if (tin < tout)
        {
            // a checkerboard of triangles; the faces turned toward the light are lighter (three
            // shades, as a light-sourced glenz had)
            bool frontWhite = kin % 4 < 2, backWhite = kout % 4 < 2;
            int f = kin / 4, e = kin % 4, ax = f / 2, ex = (ax + 1 + e / 2) % 3;
            vec3 nk = (ax == 0 ? vec3(1.0, 0.0, 0.0) : ax == 1 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0)) * (f % 2 == 0 ? 1.0 : -1.0)
                    + (ex == 0 ? vec3(1.0, 0.0, 0.0) : ex == 1 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0)) * (e % 2 == 0 ? H : -H);
            float lv = floor(clamp(dot(normalize(R * nk), vec3(-0.45, 0.55, 0.7)), 0.0, 1.0) * 2.99) / 2.0;
            vec3 back = backWhite ? vec3(0.55, 0.6, 0.85) : vec3(0.05, 0.1, 0.45);
            col = frontWhite ? vec3(0.95, 0.95, 1.0) * (0.72 + 0.28 * lv) : mix(back, vec3(0.2, 0.45, 1.0) * (0.75 + 0.45 * lv), 0.45);
        }
    }

    // vector balls: 26 balls in a 3x3x3 cube that turns into a ball and back, nearer balls in front,
    // each shaded like a bob drawn in eight shades
    const float BS = 0.085;
    vec2 ub = (s - cb) / BS;
    if (dot(ub, ub) < 10.0)
    {
        mat3 R = demoRot(vec3(t * 0.9, t * 0.6, t * 0.35));
        float m = smoothstep(-0.4, 0.4, sin(t * 0.33)), zb = -1e9;
        vec2 bd = vec2(0.0);
        int bi = 0;
        for (int i = 0; i < 27; i++)
        {
            if (i == 13) continue;
            vec3 q = vec3(float(i % 3), float((i / 3) % 3), float(i / 9)) - 1.0;
            float fi = float(i < 13 ? i : i - 1), zz = 1.0 - (2.0 * fi + 1.0) / 26.0, ph = fi * 2.39996;
            vec3 p = R * mix(q, 1.45 * vec3(sqrt(1.0 - zz * zz) * vec2(cos(ph), sin(ph)), zz), m);
            float w = 1.0 / (1.0 - p.z * 0.18), r = 0.33 * w;
            vec2 dd = (ub - p.xy * w) / r;
            if (dot(dd, dd) < 1.0 && p.z > zb) { zb = p.z; bd = dd; bi = i; }
        }
        if (zb > -1e8)
        {
            vec3 nb = vec3(bd, sqrt(max(1.0 - dot(bd, bd), 0.0)));
            float l = dot(nb, normalize(vec3(-0.5, 0.6, 0.62)));
            float lev = floor((0.25 + 0.75 * max(l, 0.0)) * 7.0 + 0.5) / 7.0;
            vec3 base = bi / 9 == 0 ? vec3(1.0, 0.35, 0.2) : bi / 9 == 1 ? vec3(1.0, 0.8, 0.25) : vec3(0.35, 0.7, 1.0);
            col = base * lev + (l > 0.93 ? 0.6 : 0.0);
        }
    }

    // the twister along the bottom: a bar with a square cross-section, turned a little more at
    // every column, its four faces in copper colours with a checked pattern
    float Yc = -0.43 * L + 3.0 * sin(P.x * 0.045 + t * 1.3);
    if (abs(P.y + 0.5 - Yc) < 16.0)
    {
        float a = t * 1.7 + P.x * 0.03 * sin(t * 0.31);
        for (int i = 0; i < 4; i++)
        {
            float a0 = a + float(i) * 1.5707963, y0 = Yc + 15.5 * sin(a0), y1 = Yc + 15.5 * sin(a0 + 1.5707963);
            float y = P.y + 0.5;
            if (y1 > y0 && y >= y0 && y < y1)
            {
                float v = (y - y0) / (y1 - y0), shade = cos(a0 + 0.7853982);
                float chk = mod(floor(v * 4.0) + floor((P.x + t * 24.0) / 8.0), 2.0);
                vec3 fcol = demoRainbow(float(i) * 0.25 + 0.08 * sin(t * 0.2));
                col = fcol * (0.3 + 0.7 * shade) * (chk < 0.5 ? 1.0 : 0.65) * (v < 0.06 || v > 0.94 ? 0.4 : 1.0);
            }
        }
    }

    // the DYCP scroller along the top: 16x16 letters, each on its own sine, coloured line by line
    // like a copper list, with a shadow
    float base = floor(0.43 * L);
    float sx = P.x + floor(t * 70.0);
    float slot = floor(sx / 16.0);
    int ch = DEMO_TEXT[int(mod(slot, float(DEMO_TEXT.length())))];
    float oy = floor(7.0 * sin(slot * 0.55 + t * 3.2));
    int gx = int(floor((sx - slot * 16.0) / 2.0)), gy = int(floor((base + oy - P.y) / 2.0));
    if (gy >= 0 && gy < 8 && demoFontPixel(ch, gx, gy))
        col = demoRainbow(P.y * 0.022 - t * 0.35) * 0.9 + 0.1;
    else
    {
        float sx2 = sx - 2.0, slot2 = floor(sx2 / 16.0);
        int ch2 = DEMO_TEXT[int(mod(slot2, float(DEMO_TEXT.length())))];
        float oy2 = floor(7.0 * sin(slot2 * 0.55 + t * 3.2));
        int gx2 = int(floor((sx2 - slot2 * 16.0) / 2.0)), gy2 = int(floor((base + oy2 - P.y - 2.0) / 2.0));
        if (gy2 >= 0 && gy2 < 8 && demoFontPixel(ch2, gx2, gy2)) col *= 0.25;
    }
    // a copper bar above and below the scroller
    float cl = min(abs(P.y - (base - 26.0)), abs(P.y - (base + 10.0)));
    if (cl < 2.0) col = demoRainbow(P.x * 0.004 + t * 0.15) * (1.0 - 0.35 * cl);

    return 0.55 * amiga12(col);
}

// Hills (9): a 16-bit side-scroller landscape in layers, each moving slower the further away it
// is: a sky with the sun, clouds near and far, birds, pale mountains far away and snowy ones nearer,
// hills with bushes, trees, and grass with flowers. Drawn at 224 lines. hs: half the screen's size.
// a pixel-art cloud: puffs on a flat base; 0 outside, 1 lit, 2 middle, 3 in shadow. a: from the
// middle of its base, in pixels; k: its size
float cloudSd(vec2 a, float k)
{
    return min(min(length(a - vec2(-12.0, 5.0) * k) - 7.5 * k, length(a - vec2(0.0, 9.0) * k) - 11.0 * k),
               min(length(a - vec2(13.0, 5.0) * k) - 7.5 * k, length(a - vec2(-3.0, 4.0) * k) - 9.0 * k));
}
int cloudPix(vec2 a, float k)
{
    if (a.y < 0.0 || cloudSd(a, k) > 0.0) return 0;
    if (a.y < 2.0 || cloudSd(a + vec2(-2.5, 2.5), k) > 0.0) return 3;   // the bottom and lower right
    if (cloudSd(a + vec2(2.0, -2.5), k) > 0.0) return 1;                // the upper left catches the sun
    return 2;
}
vec3 hills(vec2 fc, vec2 hs, float t, float pix)
{
    float n = pixSize(224.0, pix);
    vec2 P = floor(fc / n);
    float y = P.y + 0.5, L = 1.0 / (n * pix);
    bool dt = mod(P.x + P.y, 2.0) < 1.0;
    // the sky, in bands with dithered edges, and the sun at the upper left with rings of light
    vec3 col = mix(rgb8(150.0, 205.0, 255.0), rgb8(48.0, 96.0, 208.0), clamp(floor((y + 40.0) / 19.0 + 0.4 * (bayer4(P) - 0.47)) / 7.0, 0.0, 1.0));
    float sr = y > 0.5 * L - 60.0 ? length(vec2(P.x + 0.5 + hs.x * L - 44.0, y - 0.5 * L + 36.0)) : 99.0;
    if (sr < 7.5) col = rgb8(255.0, 252.0, 228.0);
    else if (sr < 9.5) col = dt ? rgb8(255.0, 244.0, 190.0) : col;
    else if (abs(sr - 13.0) < 1.0 || (abs(sr - 17.5) < 1.0 && dt)) col = mix(col, rgb8(255.0, 250.0, 220.0), 0.35);
    // clouds: small ones far away, moving slowly, and big ones nearer
    for (int i = 0; i < 2; i++)
    {
        float W = i == 0 ? 70.0 : 110.0, k = i == 0 ? 0.55 : 1.0;
        if (y < (i == 0 ? 61.0 : 29.0) || y > (i == 0 ? 101.0 : 86.0)) continue;
        float x = layerX(fc.x, t, i == 0 ? 0.002 : 0.004, n, pix) + 0.5;
        float c = floor(x / W), hc = hash13(vec3(c, float(i), 41.0));
        if (hc < 0.35) continue;
        int cp = cloudPix(vec2(x - c * W - 0.5 * W - (hc - 0.5) * 16.0, y - (i == 0 ? 62.0 : 30.0) - (i == 0 ? 26.0 : 34.0) * fract(hc * 7.0)), k);
        if (cp > 0) col = cp == 1 ? rgb8(255.0, 255.0, 255.0) : cp == 2 ? rgb8(232.0, 240.0, 255.0) : rgb8(188.0, 204.0, 240.0);
    }
    // birds, far off, flapping slowly as they cross
    if (y > 24.0 && y < 74.0)
    for (int i = 0; i < 3; i++)
    {
        float h = hash13(vec3(float(i), 9.0, 44.0)), span = 2.0 * hs.x * L + 40.0;
        vec2 bp = vec2(mod(h * span - t * (5.0 + 3.0 * h), span) - 0.5 * span, 28.0 + 40.0 * fract(h * 7.0) + 3.0 * sin(t * 0.5 + h * 9.0));
        vec2 d = spritePix(fc, bp, n) - 0.5;
        float up = mod(floor(t * 3.0 + h * 10.0), 2.0) < 1.0 ? 1.0 : -1.0;
        if (abs(d.x) <= 2.0 && d.y == (abs(d.x) == 2.0 ? up : 0.0)) col = rgb8(44.0, 54.0, 96.0);
    }
    // mountains far away, pale in the haze
    float x = layerX(fc.x, t, 0.006, n, pix) + 0.5;
    float fh = -34.0 + 30.0 * (0.6 * (1.0 - abs(2.0 * noise1(x * 0.02 + 70.0) - 1.0)) + 0.4 * noise1(x * 0.07 + 90.0));
    if (y < fh) col = y > fh - 1.0 ? rgb8(176.0, 186.0, 236.0) : rgb8(150.0, 162.0, 222.0);
    // nearer mountains, cut in faces, lit from the left, snow on the high peaks
    x = layerX(fc.x, t, 0.009, n, pix) + 0.5;
    float W = 40.0, c = floor(x / W), f = x / W - c;
    bool pk0 = mod(c, 2.0) < 0.5;                             // peaks and valleys take turns
    float h0 = hash13(vec3(c, 2.0, 41.0)), h1 = hash13(vec3(c + 1.0, 2.0, 41.0));
    float hp = 22.0 + 36.0 * (pk0 ? h0 : h1), hv = 6.0 + 8.0 * (pk0 ? h1 : h0);
    float mh = -40.0 + mix(pk0 ? hp : hv, pk0 ? hv : hp, f);
    if (y < mh)
    {
        bool litFace = !pk0;                                   // rising toward a peak on the right: faces left
        col = litFace ? rgb8(124.0, 132.0, 204.0) : rgb8(92.0, 98.0, 168.0);
        if (mod(x - (litFace ? 1.0 : -1.0) * y * 0.8, 11.0) < 1.0 && y < mh - 3.0 && hash13(vec3(floor(x / 11.0), c, 46.0)) > 0.4)
            col = litFace ? rgb8(104.0, 112.0, 186.0) : rgb8(78.0, 82.0, 150.0);   // cracks in the rock
        float snow = -40.0 + hp - 13.0 - 3.0 * abs(sin(x * 0.7)) - 2.0 * abs(sin(x * 1.9));
        if (hp > 38.0 && y > snow) col = litFace ? rgb8(240.0, 244.0, 255.0) : rgb8(196.0, 206.0, 240.0);
    }
    // hills in stripes, with bushes along their tops
    x = layerX(fc.x, t, 0.018, n, pix) + 0.5;
    float hh = -52.0 + 9.0 * sin(x * 0.045) + 5.0 * sin(x * 0.11 + 1.3);
    if (y < hh) col = y > hh - 2.0 ? rgb8(120.0, 205.0, 95.0) : mod(floor(y / 3.0), 2.0) < 0.5 ? rgb8(62.0, 150.0, 72.0) : rgb8(52.0, 134.0, 64.0);
    if (abs(y - hh) < 8.0)
    {
        float bcell = floor(x / 9.0), hbsh = hash13(vec3(bcell, 6.0, 41.0));
        vec2 bd = vec2(x - bcell * 9.0 - 4.5, y - (-52.0 + 9.0 * sin((bcell * 9.0 + 4.5) * 0.045) + 5.0 * sin((bcell * 9.0 + 4.5) * 0.11 + 1.3)));
        if (hbsh > 0.55 && length(bd * vec2(1.0, 1.3)) < 3.2 && bd.y > -2.0) col = bd.y > 1.0 && bd.x < 0.0 ? rgb8(88.0, 176.0, 80.0) : rgb8(40.0, 112.0, 56.0);
    }
    // trees: round ones and pines
    x = layerX(fc.x, t, 0.032, n, pix) + 0.5;
    float tc = floor(x / 26.0), ht = hash13(vec3(tc, 3.0, 41.0));
    if (ht > 0.2)
    {
        float cy = -66.0 + 6.0 * fract(ht * 7.0);
        vec2 d = vec2(x - tc * 26.0 - 13.0 - (ht - 0.5) * 8.0, y - cy);
        if (fract(ht * 31.0) < 0.6)
        {
            float r = 8.0 + 4.0 * fract(ht * 13.0);
            if (abs(d.x) < 1.5 && d.y < 0.0 && d.y > -18.0) col = d.x < 0.0 ? rgb8(130.0, 84.0, 44.0) : rgb8(96.0, 60.0, 30.0);
            float bl = length(d - vec2(0.0, 0.0)) - r;
            if (bl < 0.0)
            {
                float l = -0.6 * d.x + 0.8 * d.y;
                col = l > 0.45 * r ? rgb8(104.0, 184.0, 80.0) : l > -0.2 * r ? rgb8(58.0, 140.0, 62.0) : rgb8(32.0, 98.0, 46.0);
                if (hash13(vec3(floor(d / 3.0), tc + 50.0)) > 0.8 && l > -0.2 * r) col = rgb8(104.0, 184.0, 80.0);   // clumps of leaves
            }
        }
        else
        {
            float H = 26.0 + 10.0 * fract(ht * 13.0), yy = d.y + 18.0;   // a pine: tiers narrowing upward
            float w = (H - yy) * 0.36 + 1.5 * mod(yy, 6.0) / 6.0;
            if (abs(d.x) < 1.0 && yy > -2.0 && yy < 4.0) col = rgb8(96.0, 60.0, 30.0);
            if (yy > 2.0 && yy < H && abs(d.x) < w) col = d.x < -0.3 * w ? rgb8(64.0, 136.0, 86.0) : rgb8(30.0, 92.0, 62.0);
        }
    }
    // grass with tufts and flowers, earth with stones
    x = layerX(fc.x, t, 0.05, n, pix) + 0.5;
    float hx = hash13(vec3(floor(x), 4.0, 41.0));
    float g = -84.0 + (hx > 0.6 ? 1.0 : 0.0) + (hx > 0.88 ? 1.0 : 0.0);
    if (y < g)
    {
        col = y > g - 4.0 ? (y > g - 1.0 && hx > 0.75 ? rgb8(150.0, 220.0, 96.0) : rgb8(96.0, 196.0, 64.0)) : rgb8(150.0, 98.0, 52.0);
        if (y < g - 4.0 && y > g - 6.0) col = rgb8(118.0, 76.0, 40.0);                    // the edge of the earth
        vec2 sq = vec2(floor(x / 5.0), floor(y / 4.0)), sf = vec2(x - sq.x * 5.0, y - sq.y * 4.0);
        if (y < g - 7.0 && hash13(vec3(sq, 42.0)) > 0.8)                                  // stones
        {
            if (sf.y > 2.0 && sf.x > 1.0 && sf.x < 4.0) col = rgb8(176.0, 150.0, 120.0);
            else if (sf.y > 1.0 && sf.y < 2.0 && sf.x > 2.0 && sf.x < 4.0) col = rgb8(112.0, 70.0, 38.0);
        }
    }
    float fl = hash13(vec3(floor(x), 5.0, 43.0));
    if (fl > 0.96 && y >= g && y < g + 2.0)
        col = y > g + 0.5 ? (fract(fl * 91.0) < 0.4 ? rgb8(255.0, 255.0, 255.0) : fract(fl * 91.0) < 0.7 ? rgb8(255.0, 220.0, 60.0) : rgb8(240.0, 80.0, 80.0))
                          : rgb8(60.0, 150.0, 50.0);
    return 0.45 * col;
}

// Night city (10): a skyline at night in three layers moving at their own speeds. A full moon
// with a halo, stars, thin clouds drifting past, now and then a plane blinking across; far towers
// in the haze, nearer ones with windows lighting up and going dark, rooftops in front with water
// tanks, antennas with red lights and a hotel sign, cars passing on the street below. Drawn at
// 224 lines. hs: half the screen's size.
const uint CITY_FONT[5] = uint[5](0x5BEDu, 0x7B6Fu, 0x7492u, 0x79A7u, 0x4927u);   // H O T E L, 3x5, rows from the top
vec3 city(vec2 fc, vec2 hs, float t, float pix)
{
    float n = pixSize(224.0, pix);
    float yi = floor(fc.y / n), y = yi + 0.5, sx = floor(fc.x / n);
    vec2 P = vec2(sx, yi);
    float L = 1.0 / (n * pix);
    bool dt = mod(sx + yi, 2.0) < 1.0;
    // the sky: deep blue high up, purple lower, warm near the horizon from the city's lights
    vec3 col = mix(rgb8(64.0, 36.0, 96.0), rgb8(6.0, 8.0, 34.0), clamp(floor((y + 40.0) / 19.0 + 0.4 * (bayer4(P) - 0.47)) / 7.0, 0.0, 1.0));
    if (y < -20.0 && (y < -30.0 || dt)) col = mix(col, rgb8(110.0, 52.0, 90.0), 0.35);
    // stars, fewer low down where the city's light hides them
    float hsr = hash13(vec3(sx, yi, 51.0));
    if (y > 10.0 && hsr > 0.996 - 0.002 * smoothstep(10.0, 90.0, y)) col = rgb8(200.0, 200.0, 255.0) * (0.7 + 0.3 * sin(t * 2.0 + hsr * 900.0));
    // the moon, right of the monitor: shaded toward its edge, darker seas, a faint halo
    vec2 m = vec2(sx + 0.5 - 118.0, y - 66.0);
    float mr = length(m);
    if (mr < 24.0 && (abs(mr - 17.0) < 1.0 || (mr < 23.0 && mr > 14.0 && dt && mr < 19.0))) col = mix(col, rgb8(120.0, 110.0, 150.0), 0.35);
    if (mr < 12.0)
    {
        float sea = valueNoise(m * 0.35 + 3.0) + 0.5 * valueNoise(m * 0.8 + 9.0);
        col = sea > 0.95 ? rgb8(200.0, 194.0, 170.0) : rgb8(245.0, 238.0, 205.0);
        if (mr > 10.5 && dt) col = rgb8(215.0, 208.0, 180.0);
        if (mr > 11.2) col = rgb8(215.0, 208.0, 180.0);
    }
    // thin clouds drifting past, dark, lit along their tops by the moon
    float cx = layerX(fc.x, t, 0.0067, n, pix), cy = y - 40.0;
    for (int i = 0; i < 2; i++)
    {
        float cy2 = cy - float(i) * 34.0 + 10.0;
        float cc = floor((cx + float(i) * 73.0) / 120.0), hc = hash13(vec3(cc, float(i), 57.0));
        float u = (cx + float(i) * 73.0 - cc * 120.0) / (50.0 + 50.0 * hc);
        float th = 3.5 * sqrt(max(1.0 - (2.0 * u - 1.0) * (2.0 * u - 1.0), 0.0)) + 1.5 * sin(u * 9.0 + hc * 5.0);
        if (hc > 0.3 && u < 1.0 && abs(cy2 - 3.0 * hc) < th)
            col = cy2 - 3.0 * hc > th - 1.0 ? rgb8(100.0, 84.0, 130.0) : rgb8(42.0, 30.0, 70.0);
    }
    // now and then a plane, high up, its lights blinking
    float span = 2.0 * hs.x * L + 60.0, pc = floor(t / 70.0);
    vec2 pp = vec2(mix(-0.5 * span, 0.5 * span, fract(t / 70.0)), 0.5 * L - 8.0 - 12.0 * hash13(vec3(pc, 1.0, 58.0)));
    vec2 pd = spritePix(fc, pp, n) - 0.5;
    if (hash13(vec3(pc, 2.0, 58.0)) > 0.3)
    {
        if (pd.y == 0.0 && pd.x >= -2.0 && pd.x <= 2.0) col = rgb8(70.0, 70.0, 90.0);
        if (pd.y == 0.0 && pd.x == 2.0 && fract(t * 0.9) < 0.15) col = rgb8(255.0, 255.0, 255.0);
        if (pd.y == -1.0 && pd.x == 0.0 && fract(t * 0.7 + 0.5) < 0.5) col = rgb8(255.0, 60.0, 50.0);
    }
    // far towers, in the haze, a few dim windows, some with a spire
    float x = layerX(fc.x, t, 0.006, n, pix);
    float b = floor(x / 22.0), lx = x - b * 22.0;
    float bw = floor(13.0 + 8.0 * hash13(vec3(b, 1.0, 52.0))), top = floor(-20.0 + 55.0 * hash13(vec3(b, 2.0, 52.0)));
    if (lx < bw && yi < top)
    {
        col = mix(rgb8(34.0, 32.0, 70.0), rgb8(60.0, 44.0, 84.0), clamp((-yi - 40.0) / 50.0, 0.0, 1.0));
        if (mod(lx, 3.0) == 1.0 && mod(top - yi, 3.0) == 2.0 && hash13(vec3(b * 31.0 + lx, yi, 53.0)) > 0.8) col = rgb8(130.0, 120.0, 80.0);
    }
    if (hash13(vec3(b, 3.0, 52.0)) > 0.7 && lx == floor(bw * 0.5) && yi >= top && yi < top + 6.0) col = rgb8(40.0, 38.0, 74.0);
    // nearer buildings: windows that light up and go dark; flat roofs, steps or a pointed top
    x = layerX(fc.x, t, 0.014, n, pix);
    b = floor(x / 32.0); lx = x - b * 32.0;
    float w = floor(20.0 + 11.0 * hash13(vec3(b, 1.0, 54.0))), hb2 = hash13(vec3(b, 3.0, 54.0));
    top = floor(-40.0 + 60.0 * hash13(vec3(b, 2.0, 54.0)));
    float roof = top;
    if (hb2 > 0.7) roof = top + 3.0 * floor(min(lx, w - 1.0 - lx) / (0.25 * w));          // steps
    else if (hb2 > 0.5) roof = top + floor(min(lx, w - 1.0 - lx) * 0.6);                   // a pointed top
    if (lx < w && yi < roof)
    {
        col = lx < 2.0 ? rgb8(26.0, 26.0, 52.0) : rgb8(18.0, 18.0, 40.0);
        float wy = top - yi;
        if (mod(lx, 4.0) >= 1.0 && mod(lx, 4.0) <= 2.0 && lx < w - 1.0 && mod(wy, 5.0) >= 2.0 && mod(wy, 5.0) <= 3.0 && wy > 1.0)
        {
            vec3 id = vec3(b * 17.0 + floor(lx / 4.0), floor(wy / 5.0), 55.0);
            float h = hash13(id);
            if (hash13(id + floor(t / (8.0 + 20.0 * h) + h)) > 0.55)
                col = 0.7 * (fract(h * 11.0) > 0.25 ? rgb8(255.0, 214.0, 130.0) : rgb8(150.0, 205.0, 255.0));
        }
    }
    // rooftops in front: walls with lit windows, water tanks, boxes, antennas with red lights,
    // and on some a hotel sign, its letters glowing (one of them flickers now and then)
    x = layerX(fc.x, t, 0.03, n, pix);
    b = floor(x / 44.0); lx = x - b * 44.0;
    float hb = hash13(vec3(b, 1.0, 56.0)), hk = hash13(vec3(b, 4.0, 56.0));
    float fw = floor(34.0 + 10.0 * hk);
    top = floor(-74.0 + 24.0 * hb);
    if (lx < fw && yi < top)
    {
        col = yi > top - 2.0 ? rgb8(40.0, 38.0, 60.0) : rgb8(12.0, 12.0, 24.0);
        float wy = top - yi - 4.0;
        if (wy > 0.0 && mod(lx, 6.0) >= 2.0 && mod(lx, 6.0) < 4.0 && mod(wy, 7.0) >= 2.0 && mod(wy, 7.0) < 5.0 && lx < fw - 2.0)
        {
            vec3 id = vec3(b * 13.0 + floor(lx / 6.0), floor(wy / 7.0), 59.0);
            float h = hash13(id);
            if (hash13(id + floor(t / (12.0 + 30.0 * h) + h)) > 0.6) col = 0.75 * (fract(h * 7.0) > 0.3 ? rgb8(255.0, 200.0, 120.0) : rgb8(170.0, 220.0, 255.0));
        }
    }
    float dyr = yi - top;                                     // above the roof
    if (lx < fw && dyr >= 0.0)
    {
        if (hb > 0.5 && lx == 22.0 && dyr < 12.0) col = rgb8(40.0, 40.0, 52.0);
        if (hb > 0.5 && lx == 22.0 && dyr == 12.0 && fract(t * 0.8 + hb * 7.0) < 0.5) col = rgb8(255.0, 40.0, 30.0);
        if (hk > 0.45)                                        // a water tank on legs
        {
            float tx = lx - 6.0 - 6.0 * fract(hk * 9.0);
            if ((tx == 0.0 || tx == 6.0) && dyr < 3.0) col = rgb8(30.0, 30.0, 44.0);
            if (tx >= 0.0 && tx <= 6.0 && dyr >= 3.0 && dyr < 10.0 - (tx < 1.0 || tx > 5.0 ? 1.0 : 0.0)) col = tx < 2.0 ? rgb8(52.0, 46.0, 66.0) : rgb8(30.0, 28.0, 44.0);
            if (tx >= 1.0 && tx <= 5.0 && dyr == 10.0) col = rgb8(30.0, 28.0, 44.0);
        }
        if (fract(hk * 23.0) > 0.5 && lx > fw - 12.0 && lx < fw - 6.0 && dyr < 3.0) col = dyr > 1.0 ? rgb8(52.0, 52.0, 70.0) : rgb8(30.0, 30.0, 44.0);
    }
    if (fract(hb * 37.0) < 0.22 && top > -66.0)              // the hotel sign, upright on the wall
    {
        vec2 q = vec2(lx - fw + 9.0, top - 6.0 - yi);
        if (q.x >= 0.0 && q.x < 5.0 && q.y >= 0.0 && q.y < 31.0)
        {
            col = rgb8(24.0, 14.0, 30.0);
            float li = floor((q.y - 1.0) / 6.0), ly = q.y - 1.0 - li * 6.0, lc = q.x - 1.0;
            bool on = li != 2.0 || fract(t * 0.05 + hb * 3.0) > 0.06 || fract(t * 7.0) < 0.5;
            if (li >= 0.0 && li < 5.0 && ly < 5.0 && lc >= 0.0 && lc < 3.0 && on &&
                ((CITY_FONT[int(li)] >> uint((4.0 - ly) * 3.0 + 2.0 - lc)) & 1u) == 1u)
                col = rgb8(255.0, 90.0, 140.0);
        }
        else if (q.x >= -2.0 && q.x < 7.0 && q.y >= -2.0 && q.y < 33.0 && yi < top) col = dt ? mix(rgb8(12.0, 12.0, 24.0), rgb8(255.0, 90.0, 140.0), 0.25) : rgb8(12.0, 12.0, 24.0);
    }
    // the street at the bottom: cars, white lights going right, red ones going left
    if (yi < -0.5 * L + 5.0)
    {
        col = rgb8(10.0, 10.0, 18.0);
        float lane = yi < -0.5 * L + 2.0 ? 0.0 : 1.0;
        float cxp = layerX(fc.x, t, lane < 0.5 ? -0.09 : 0.09, n, pix), cc = floor(cxp / 37.0), hc = hash13(vec3(cc, lane, 60.0));
        float u = cxp - cc * 37.0;
        if (hc > 0.5 && mod(yi, 3.0) < 1.0 && (u == 3.0 || u == 7.0)) col = lane < 0.5 ? rgb8(255.0, 240.0, 200.0) : rgb8(255.0, 40.0, 40.0);
    }
    return 0.6 * col;
}

// Arcade carpet (11): neon shapes on black, like the carpets of 90s arcades and bowling alleys,
// glowing as under black light, drifting slowly: planets with rings, stars, moons, lightning,
// spirals, squiggles and more, some in two colours, with confetti in the pile between them.
float sdBox(vec2 p, vec2 b) { vec2 d = abs(p) - b; return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0); }
vec3 carpet(vec2 s, float t, float pix)
{
    const float C = 0.14;                                     // the pattern's cell, in screen heights
    const vec3 NEON[6] = vec3[6](vec3(1.0, 0.1, 0.6), vec3(0.1, 0.9, 1.0), vec3(1.0, 0.9, 0.1),
                                 vec3(0.45, 1.0, 0.1), vec3(1.0, 0.45, 0.05), vec3(0.65, 0.25, 1.0));
    vec2 qd = s + floor(t * vec2(0.012, 0.007) / pix) * pix;   // drifting, in whole screen pixels
    vec2 q = qd;
    q.x += 0.5 * C * mod(floor(q.y / C), 2.0);
    vec2 id = floor(q / C), f = q / C - id - 0.5;
    float pc = pix / C;
    float h1 = hash13(vec3(id, 21.0)), h2 = hash13(vec3(id, 22.0)), h3 = hash13(vec3(id, 23.0));
    float ca = cos(h2 * TAU), sa = sin(h2 * TAU);
    vec2 pq = mat2(ca, sa, -sa, ca) * (f - (vec2(h3, fract(h3 * 7.0)) - 0.5) * 0.12);
    int kind = int(h1 * 10.0);
    float d = 1e9, d2 = 1e9, fill = 0.0, fill2 = 0.0;     // the outline and fill in the first colour, then the second
    if (kind == 0)
    {
        // a planet with a ring, the ring's far side hidden behind the planet
        float pl = length(pq) - 0.11;
        float rg = abs(length(pq * vec2(1.0, 3.2)) - 0.25) / 2.2;
        d = abs(pl);
        fill = step(pl, 0.0);
        d2 = pl < 0.01 && pq.y > 0.0 ? 1e9 : rg;
        if (rg < 0.03 && pq.y < 0.0) d = max(d, 0.03);         // the near side passes in front
    }
    else if (kind == 1)
    {
        float st = sdStar5(pq, 0.2, 0.45);                     // a star
        d = abs(st);
        fill = step(st, 0.0);
    }
    else if (kind == 2)
    {
        for (int i = -3; i <= 3; i++)                         // a squiggle: the nearest of a few points on it, then closer
        {
            float x = clamp(pq.x + 0.03 * float(i), -0.26, 0.26);
            d = min(d, length(pq - vec2(x, 0.06 * sin(x * 24.0))));
        }
    }
    else if (kind == 3)
    {
        d = abs(sdTriangle(pq, 0.17));                        // a triangle with a smaller one inside
        d2 = abs(sdTriangle(pq, 0.07));
    }
    else if (kind == 4)
    {
        d = abs(length(pq) - 0.17);                            // a ring with a dot
        d2 = max(length(pq) - 0.045, 0.0);
        fill2 = step(length(pq), 0.045);
    }
    else if (kind == 5)
    {
        d = min(min(length(pq - vec2(-0.14, 0.05)), length(pq - vec2(0.12, 0.1))), length(pq - vec2(0.02, -0.13))) - 0.045;
        fill = step(d, 0.0);                                   // three dots
        d = abs(d);
    }
    else if (kind == 6)
        d = min(min(segPix(pq, vec2(-0.07, 0.21), vec2(0.06, 0.03)), segPix(pq, vec2(0.06, 0.03), vec2(-0.05, 0.01))),
                segPix(pq, vec2(-0.05, 0.01), vec2(0.08, -0.2)));   // a flash of lightning
    else if (kind == 7)
    {
        float mo = max(length(pq) - 0.16, -(length(pq - vec2(0.07, 0.05)) - 0.13));   // a crescent moon and a little star
        d = abs(mo);
        fill = step(mo, 0.0);
        float st = sdStar5(pq - vec2(0.1, 0.12), 0.055, 0.45);
        d2 = abs(st);
        fill2 = step(st, 0.0);
    }
    else if (kind == 8)
        d = abs(min(sdBox(pq, vec2(0.17, 0.04)), sdBox(pq, vec2(0.04, 0.17))));   // a cross
    else
    {
        float r = length(pq), k = (r / 0.03 - atan(pq.y, pq.x)) / TAU;   // a spiral
        d = max(abs(fract(k + 0.5) - 0.5) * TAU * 0.03, r - 0.19);
    }
    int ni = int(fract(h1 * 13.0) * 6.0);
    vec3 neon = NEON[ni], neon2 = NEON[int(mod(float(ni) + 2.0 + floor(h3 * 3.0), 6.0))];
    float fib = hash13(vec3(floor(qd / (2.0 * pix)), 30.0));  // the carpet's fibres
    vec3 col = vec3(0.006, 0.004, 0.012) * (0.6 + 0.8 * fib);
    float win = smoothstep(0.5, 0.38, max(abs(f.x), abs(f.y)));   // the glow ends inside the cell
    col += neon * (0.55 * smoothstep(0.018 + pc, 0.018 - pc, d) + 0.18 * win * exp(-d / 0.04) + 0.1 * fill) * (0.8 + 0.4 * fib);
    col += neon2 * (0.55 * smoothstep(0.016 + pc, 0.016 - pc, d2) + 0.15 * win * exp(-d2 / 0.04) + 0.1 * fill2) * (0.8 + 0.4 * fib);
    // confetti in the pile between the shapes: short dashes and little triangles
    vec2 cq = qd / 0.045 + 0.37, cid = floor(cq), cf = fract(cq) - 0.5;
    float hc = hash13(vec3(cid, 26.0));
    if (hc > 0.83 && min(d, d2) > 0.09)
    {
        float cb = fract(hc * 17.0) * TAU;
        vec2 cr = mat2(cos(cb), sin(cb), -sin(cb), cos(cb)) * (cf - (vec2(fract(hc * 3.0), fract(hc * 5.0)) - 0.5) * 0.3);
        float cd = fract(hc * 29.0) < 0.6 ? sdBox(cr, vec2(0.2, 0.05)) : sdTriangle(cr, 0.13);
        float cp = pix / 0.045;
        col += NEON[int(fract(hc * 41.0) * 6.0)] * 0.24 * smoothstep(cp, -cp, cd) * (0.8 + 0.4 * fib);
    }
    // specks of colour in the pile
    float hsp = hash13(vec3(floor(qd / 0.012), 24.0));
    if (hsp > 0.985) col += NEON[int(fract(hsp * 31.0) * 6.0)] * 0.25 * smoothstep(0.35, 0.2, length(fract(qd / 0.012) - 0.5));
    return col;
}

// Around the tube 2-11: the scene behind the monitor. hs: half the screen's size in screen heights.
vec3 scene(int k, vec2 s, vec2 fc, vec2 hs, float t, float pix)
{
    if (k == 2) return space(s, t, pix);
    if (k == 3) return synthwave(s, hs, t, pix);
    if (k == 4) return tiles(fc, t, pix);
    if (k == 5) return bounceLines(s, hs, t, pix);
    if (k == 6) return underwater(fc, hs, t, pix);
    if (k == 7) return copper(fc, hs, t, pix);
    if (k == 8) return amigaDemo(fc, hs, t, pix);
    if (k == 9) return hills(fc, hs, t, pix);
    if (k == 10) return city(fc, hs, t, pix);
    return carpet(s, t, pix);
}

// The colour of the light a scene casts on the casing (Room light sets how much).
vec3 sceneLight(int k, float t)
{
    if (k == 2) return vec3(0.96, 0.98, 1.0);                 // space: white, like sunlight
    if (k == 3) return vec3(1.0, 0.72, 0.95);                 // synthwave: pink, like its sun
    if (k == 4) return tilesLight(t);
    if (k == 5) return vec3(0.85, 0.9, 1.0);
    if (k == 6) return vec3(0.7, 0.9, 1.0);                   // underwater: blue-green
    if (k == 7) return vec3(1.0, 0.85, 0.9);
    if (k == 8) return vec3(0.85, 0.85, 1.0);                 // Amiga demo
    if (k == 9) return vec3(1.0, 0.98, 0.92);
    if (k == 10) return vec3(0.72, 0.76, 1.0);
    return vec3(0.82, 0.6, 1.0);                              // carpet: black light
}

// What is around the tube (Around the tube), drawn where the glass ends. Linear light, like the
// picture. c: tube position (-1..1, after curvature); dist, qq: how far outside the tube edge, in
// the same units; tc: position on the tube before curvature (0..1); tubePx: tube size in pixels.
// Sizes are in mm (the tube is Monitor size), so the casing is as large as the real one.
vec3 backdrop(vec2 c, float dist, vec2 qq, vec2 tc, vec2 tubePx)
{
    vec2 tube = monTubeMM();
    float mmpp = tube.y / tubePx.y;                               // mm per screen pixel
    float aa = mmpp;                                              // one screen pixel
    vec2 p = (tc - 0.5) * tubePx * mmpp;                          // mm from the tube centre
    p.y = -p.y;                                                   // y up
    int scn = int(LR_BACKDROP + 0.5);                      // 1 a room, 2 and up a scene
    bool inScene = scn >= 2;
    float t = float(LR_FrameCount % 1000000u) / 60.0 * LR_SCENE_SPEED;   // the scenes' clock

    // The casing, measured on photos of real monitors.
    // Amiga monitor (Commodore M1438S): warm off-white, a thick flat front, a 12.5 mm tunnel with
    //   mitred corners down to a thin black mask at the glass, a plain chin, a green light.
    // PC monitor (Compaq 151FS): aged cream, a wide front, a raised rim around a shallower
    //   recess, a blank plaque on the chin, a control strip below with buttons and a green light.
    // TV (after photos of 90s TVs): dark grey plastic, thin sides, the glass almost flush with
    //   the front, a tall chin with speaker grilles on both sides of the controls; sized to the
    //   tube (Monitor size), since TVs came from 14 to 29 inches.
    // Margins from the glass to the outline (side, top, bottom), recess width (with the mask),
    // mask width, the shell band around the front, corner radii of the outline and the recess.
    // (the X68000's monitor, a CZ-600D, was a TV set with a tuner and a speaker: the TV casing)
    bool tv = !inMM(vTiming.x) || vTiming.x > 2.5;
    bool amiga = !tv && LR_MON_MM > 0.5;
    bool pc = !tv && !amiga;
    vec3 m = amiga ? vec3(41.0, 41.0, 48.0) : pc ? vec3(44.0, 46.0, 39.0) : vec3(0.11, 0.13, 0.34) * tube.y;
    float rw = amiga ? 12.5 : pc ? 12.0 : max(0.03 * tube.y, 5.0), mw = tv ? 1.0 : 1.2, sh = amiga ? 4.0 : 3.0;
    float ro = tv ? 0.05 * tube.y : 7.0, rr = amiga ? 2.0 : tv ? 0.04 * tube.y : 6.0;
    vec3 albedo = amiga ? vec3(0.60, 0.56, 0.44) : pc ? vec3(0.66, 0.57, 0.33) : vec3(0.07, 0.07, 0.075);

    // the light: the room's (Room light: 1 a dim room with warm lamps, 20 daylight, whiter and
    // more even), brightest near the monitor. In a scene as much light as Room light gives, even,
    // in the scene's colour (white in space, pink in the synthwave scene, like its sun), so the
    // monitor shows in front of it.
    float day = smoothstep(1.0, 20.0, LR_ROOM);
    float near = mix(1.0 / (1.0 + dot(p, p) / (260.0 * 260.0)), 1.0, inScene ? 1.0 : 0.6 * day);
    vec3 light = (inScene ? sceneLight(scn, t) : mix(vec3(1.0, 0.93, 0.82), vec3(1.0), day))
               * (0.0167 * LR_ROOM * near);

    vec2 inner = 0.5 * tube;
    float d = dist * mix(1.0, tubePx.x / tubePx.y, smoothstep(-0.05, 0.05, qq.x - qq.y)) * 0.5 * tube.y;   // mm from the glass
    vec2 hs = inner + vec2(m.x, 0.5 * (m.y + m.z));               // half size of the outline
    vec2 at = p - vec2(0.0, 0.5 * (m.y - m.z));                   // from the centre of the outline
    float s = roundBox(at, hs, ro);                               // < 0 on the casing
    float u = -roundBox(p, inner + rw, rr);                       // > 0 in the recess
    float rec = smoothstep(-aa, aa, u);

    // Which way the surface faces. Away from the glass: rounded corners, mitred on the Amiga.
    vec2 nIn = boxOut(p, inner, 6.0);
    if (amiga)
    {
        vec2 e = abs(p) - inner;
        nIn = normalize(mix(vec2(0.0, sign(p.y)), vec2(sign(p.x), 0.0), smoothstep(-aa, aa, e.x - e.y)));
    }
    float phi;                                                    // < 0 toward the glass, > 0 outward
    vec2 dir = nIn;
    if (u > -5.0)
    {
        // a rounded lip, then the walls down to the glass: steep on the Amiga monitor (55 degrees),
        // shallower on the PC monitor (45 degrees) and the TV (40 degrees, a narrow chamfer)
        phi = (amiga ? -0.96 : pc ? -0.79 : -0.70) * smoothstep(-0.6, 1.2, u);
    }
    else
    {
        // the front's edge rolls over to a seam, then the casing's shell rolls away
        dir = boxOut(at, hs, ro);
        phi = s < -sh ? 0.87 * smoothstep(-sh - 2.0, -sh, s) : mix(0.44, 1.4, smoothstep(-1.5, 0.0, s));
    }
    vec3 n = tilt(dir, phi);
    if (pc)              // the top of the front slopes back a little
        n = normalize(n + vec3(0.0, 0.25 * smoothstep(inner.y + rw + 12.0, inner.y + m.y - sh, p.y), 0.0));

    // less of the room's light gets into the recess, least near the glass; the seam is dark;
    // the mask next to the glass is black
    float occ = (1.0 - rec * (0.05 + 0.15 * smoothstep(0.0, rw, u)))
              * (1.0 - 0.6 * exp(-0.5 * (s + sh) * (s + sh) / max(0.16, aa * aa)));
    vec3 alb = albedo * mix(1.0, 0.92, rec);
    if (!tv)             // the plastic has aged a little unevenly
        alb *= 1.0 - 0.03 * valueNoise(p / 30.0 + 7.0);
    float gloss = tv ? 0.6 : 0.5;
    alb = mix(alb, vec3(0.02), 1.0 - smoothstep(mw - aa, mw + aa, d));

    vec3 lamp = vec3(0.0);                                        // the power light
    vec3 stripCol = vec3(0.0);
    float strip = 0.0;
    float yb = -inner.y - m.z;                                    // bottom of the outline
    if (pc)
    {
        // a blank pill-shaped plaque on the chin, left: a grey raised rim around a light face
        vec2 pq = p - vec2(-0.406 * tube.x, -inner.y - rw - 12.0);
        float pd = pill(pq, 20.5, 7.5);
        if (pd < 1.5)
        {
            vec2 pdir = normalize(vec2(sign(pq.x) * max(abs(pq.x) - 20.5, 0.0), pq.y) + 1e-4);
            float on = 1.0 - smoothstep(-aa, aa, pd);
            float rim = on * smoothstep(-1.5 - aa, -1.5 + aa, pd);
            n = normalize(mix(n, tilt(pdir, 0.6), rim));
            alb = mix(alb, mix(vec3(0.86, 0.84, 0.79), vec3(0.55, 0.55, 0.56), rim), on);
            gloss = mix(gloss, min(gloss + 0.3, 1.0), on);   // the plaque is glossier
            occ *= 1.0 - 0.35 * (1.0 - on) * (1.0 - smoothstep(0.0, 1.5, pd)) * max(-pdir.y, 0.0);   // its shadow below
        }

        // the control strip, a separate part under the front: a recessed panel in the middle,
        // the power light and two buttons on the right, seams between the parts
        vec2 sp = p - vec2(0.0, yb - 6.0);
        strip = 1.0 - smoothstep(-aa, aa, roundBox(sp, vec2(110.5, 7.0), 2.0));
        if (strip > 0.0)
        {
            float sphi = 0.0;
            vec2 sdir = vec2(0.0, 1.0);
            float pan = roundBox(sp - vec2(8.5, -0.5), vec2(50.5, 4.5), 1.0);
            if (pan < 0.0)
            {
                sdir = boxOut(sp - vec2(8.5, -0.5), vec2(50.5, 4.5), 1.0);
                sphi = -0.8 * smoothstep(-1.0, 0.0, pan);         // its walls face inward
            }
            for (int k = 0; k < 2; k++)
            {
                vec2 bc = vec2(k == 0 ? 85.5 : 102.25, -0.5);
                vec2 bh = vec2(k == 0 ? 7.5 : 7.25, 4.5);
                float bd = roundBox(sp - bc, bh, 0.8);
                if (bd < 0.0)
                {
                    sdir = boxOut(sp - bc, bh, 0.8);
                    sphi = 0.6 * smoothstep(-0.8, 0.0, bd);        // bevelled buttons
                }
            }
            float seam = 0.0;
            for (int k = 0; k < 4; k++)
            {
                float x0 = k == 0 ? -42.0 : k == 1 ? 59.0 : k == 2 ? 77.0 : 94.0;
                seam = max(seam, exp(-0.5 * (sp.x - x0) * (sp.x - x0) / max(0.09, aa * aa)));
            }
            float socc = mix(0.7, 1.0, smoothstep(5.0, 2.5, sp.y))    // in the shadow of the front above
                       * (1.0 - 0.6 * seam);
            stripCol = plastic(albedo * 0.97, tilt(sdir, sphi), vec3(p, 0.0), light, socc, 0.5);
            float ld = roundBox(sp - vec2(70.0, -0.5), vec2(1.2, 0.6), 0.3);
            lamp += vec3(0.12, 1.0, 0.2) * (0.6 * (1.0 - smoothstep(-aa, aa, ld)) + 0.03 * exp(-0.5 * max(ld, 0.0) * max(ld, 0.0) / 9.0)) * strip;
        }
    }
    else if (tv)
    {
        // The TV's chin: a band set a little into the front, with a speaker grille on each side
        // and the controls between them: the power switch, the red light, four small buttons.
        float h = tube.y;
        float top = -inner.y - rw - 0.07 * h, bot = yb + 0.035 * h;
        vec2 bc = vec2(0.0, 0.5 * (top + bot)), bh = vec2(hs.x - 0.04 * h, 0.5 * (top - bot));
        float bd = roundBox(p - bc, bh, 2.0);
        float band = 1.0 - smoothstep(-aa, aa, bd);
        float panel = 0.36 * hs.x;                                // half width of the controls
        occ *= (1.0 - 0.6 * exp(-0.5 * bd * bd / max(0.2, aa * aa)))                       // its seam
             * (1.0 - 0.3 * band * (1.0 - smoothstep(0.0, 2.5, bh.y - (p.y - bc.y))))     // shadow at its top
             * (1.0 - 0.5 * band * exp(-0.5 * (abs(p.x) - panel) * (abs(p.x) - panel) / max(0.2, aa * aa)));
        alb *= mix(1.0, 0.85, band);
        // the grilles: holes 1.2 mm wide, 2.2 mm apart (seen as an even darker grey when they are
        // smaller than a pixel)
        float grill = (1.0 - smoothstep(-2.0 - aa, -2.0 + aa, bd)) * smoothstep(panel + 2.0 - aa, panel + 2.0 + aa, abs(p.x));
        if (grill > 0.0)
        {
            vec2 per = vec2(2.2, 3.81);
            float hd = min(length(mod(p, per) - 0.5 * per), length(mod(p + 0.5 * per, per) - 0.5 * per));
            float hole = mix(clamp((0.6 - hd) / aa + 0.5, 0.0, 1.0), 0.27, smoothstep(1.1, 2.2, aa));
            alb = mix(alb, vec3(0.006), hole * grill);
        }
        // the buttons: round, domed, in a dark ring
        for (int k = 0; k < 5; k++)
        {
            vec2 bp = p - vec2(k == 0 ? -0.6 * panel : panel * (0.04 + 0.16 * float(k)), bc.y);
            float br = (k == 0 ? 0.026 : 0.011) * h, bl = length(bp);
            if (bl < br + 2.0)
            {
                float on = 1.0 - smoothstep(br - aa, br + aa, bl);
                occ *= 1.0 - 0.6 * (1.0 - on) * exp(-0.5 * (bl - br) * (bl - br) / max(0.15, aa * aa));
                n = normalize(mix(n, tilt(bp / max(bl, 1e-3), 0.9 * bl / br), on));
            }
        }
        float ld = length(p - vec2(-0.3 * panel, bc.y));
        lamp += vec3(1.0, 0.06, 0.03) * (0.6 * (1.0 - smoothstep(1.0 - aa, 1.0 + aa, ld)) + 0.03 * exp(-0.5 * ld * ld / 9.0));
    }
    else
    {
        // the Amiga monitor's power light, under the front, right of the middle
        float ld = roundBox(p - vec2(0.356 * tube.x, yb + 2.2), vec2(1.3, 0.6), 0.4);
        lamp += vec3(0.12, 1.0, 0.2) * (0.6 * (1.0 - smoothstep(-aa, aa, ld)) + 0.03 * exp(-0.5 * max(ld, 0.0) * max(ld, 0.0) / 9.0));
    }

    // The screen lights the walls of the recess, which face the picture beside them, so they
    // change with it (Screen light on the casing). A point on a wall z mm in front of the phosphor
    // (which sits about 10 mm behind the front of the glass) sees the picture from about 0.7 z to
    // 3 z beyond the edge; a Lambert screen of luminance L gives it 0.67 L (the Amiga's 55-degree
    // walls) or 0.46 L (45 degrees) of illuminance, so the wall shines at 0.21 or 0.15 of L times
    // its albedo. On these slanted paths the tinted glass lets about 30% out, and the dot mask
    // and the lines leave about 70% of the picture's light: 0.045 and 0.03. Plastic scatters it,
    // it does not mirror the picture. Six samples of the glowing picture over that region.
    vec3 pic = vec3(0.0);
    float facing = smoothstep(-0.6, 1.2, u) * LR_SPILL;
    if (facing > 0.0)
    {
        vec2 ov = monShown();
        vec2 edge = clamp(c * 0.5 * ov + 0.5, 0.0, 1.0);          // the tube's edge on the picture
        vec2 nt = boxOut((tc - 0.5) * tube, inner, 15.0);         // outward, in texture orientation
        vec2 inward = -nt / tube * ov, side = vec2(-nt.y, nt.x) / tube * ov;   // per mm
        float z = (amiga ? 1.43 : pc ? 1.0 : 0.84) * max(d - mw, 0.0) + 10.0;
        vec3 gl = vec3(0.0);
        for (int i = 0; i < 2; i++)
            for (int j = -1; j <= 1; j++)
            {
                vec2 q = edge + inward * ((i == 0 ? 0.9 : 2.4) * z) + side * (1.3 * float(j) * z);
                gl += (j == 0 ? 0.25 : 0.125) * textureLod(LR_GlowTexture, clamp(q, 0.0, 1.0), 0.0).rgb;
            }
        pic = gl * vWhite * (amiga ? 0.045 : pc ? 0.03 : 0.026) * facing;
    }

    vec3 casing = plastic(alb, n, vec3(p, 0.0), light, occ, gloss) + alb * pic;
    vec2 sc = (vTexCoord - 0.5) * LR_OutputSize.xy * LR_OutputSize.w;   // screen heights
    vec2 fc = floor(vTexCoord * LR_OutputSize.xy) - floor(0.5 * LR_OutputSize.xy);   // screen pixel
    sc.y = -sc.y;                                                 // y up
    fc.y = -1.0 - fc.y;
    vec3 behind = inScene ? scene(scn, sc, fc, 0.5 * LR_OutputSize.xy * LR_OutputSize.w, t, LR_OutputSize.w)
                : vec3(0.20, 0.195, 0.18) * light;               // the wall, further from the light
    if (scn == 3)        // the casing's edge, turned away from the viewer, catches the sunset's light
        casing += behind * 0.2 * smoothstep(-sh - 1.0, 0.0, s);
    behind = mix(behind, stripCol, strip);
    return mix(behind, casing, 1.0 - smoothstep(-aa, aa, s)) + lamp;
}

void lr_main()
{
    float scan = vTiming.x, pal = vTiming.y, interlace = vTiming.z;

    // tube geometry: barrel curvature and rounded corners
    vec2 tc = vTexCoord;
    vec2 tubePx = LR_OutputSize.xy;                   // size of the tube face in screen pixels
    float px = 2.0 * LR_OutputSize.z;
    float va = LR_OutputSize.x * LR_OutputSize.w;
    // RetroArch: the picture area is the tube, unless something is drawn around it; then
    // it may fill the screen (Aspect Ratio: Full)
    if (LR_BACKDROP > 0.5 && abs(0.75 * va - 1.0) > 0.02)
    {
        // the picture area may be any shape: the 4:3 tube sits in its middle
        vec2 fit = va > 4.0 / 3.0 ? vec2(4.0 / 3.0 / va, 1.0) : vec2(1.0, 0.75 * va);
        tc = (tc - 0.5) / fit + 0.5;
        tubePx *= fit;
        px /= fit.x;
    }
    // real size: the tube as large as the monitor it describes (Monitor size), on a screen whose
    // height is given; the picture area must be as tall as the screen (full screen)
    if (LR_SCREEN_H > 0.0)
    {
        float screenMM = LR_SCREEN_H * (LR_SCREEN_UNIT > 0.5 ? 25.4 : 10.0);
        float s = min(LR_OutputSize.y * monTubeMM().y / (screenMM * tubePx.y), 1.0);
        tc = (tc - 0.5) / s + 0.5;
        tubePx *= s;
        px /= s;
    }
    vec2 c = tc * 2.0 - 1.0;
    // The glass bulges: seen from the front, its edges bow outwards and the corners are rounded.
    // The raster on it does not follow the glass: the deflection was corrected so that the
    // picture looks nearly rectangular from the front (a well adjusted set kept the bow of its
    // lines to about 1% of the height), and the curved edges of the glass crop its corners.
    // Raster bend is the share of the glass curvature the picture still follows: 0 a perfectly
    // corrected raster, 1 a picture bent as much as the glass.
    vec2 cs = c;                                          // straight position on the screen
    vec2 curv = vec2(LR_CURV_X, LR_CURV_Y);
    c *= 1.0 + curv * (c.yx * c.yx);                      // position on the glass
    vec2 cr = cs * (1.0 + LR_BEND * curv * (cs.yx * cs.yx));   // position in the raster
    float corner = LR_CORNER;
    vec2 qq = abs(c) - 1.0 + corner;
    float dist = length(max(qq, 0.0)) + min(max(qq.x, qq.y), 0.0) - corner;
    float inside = 1.0 - smoothstep(-px, px, dist);

    vec3 col = vec3(0.0);
    if (inside > 0.0)
    {
        vec2 ut = c * 0.5 + 0.5;                          // on the glass: mask, damper wires
        vec2 up = cr * 0.5 + 0.5;                         // the picture's place on the tube
        vec2 ua = (up - 0.5) * monShown() + 0.5;          // ... and in the scan
        // linearity errors of the deflection: one side of the picture squeezed, the other stretched
        vec2 lin = vec2(LR_LIN_X, LR_LIN_Y);
        ua += lin * ua * (1.0 - ua);
        float srcH = LR_OriginalSize.y / vTiming.w;   // native lines
        float rpl = 1.0, ph = 0.0;                         // beam rows per line, row of line 0

        // raster: TV modes sit in a 240/288-line field, VGA and 24 kHz arcade fill the screen
        bool vga = scan > 0.5 && scan < 1.5;
        bool mm = inMM(scan);                              // tube described in mm (PC monitor, 1084S)
        // position along the source line: a 15 kHz monitor in mm shows the whole active line,
        // so a source shorter than the line leaves side borders
        float xs = (ua.x - 0.5) / vShare + 0.5;
        // TV show: the studio's frame synchronizer made a standard interlaced picture out of
        // the console's 240p/288p frames, so every console line is drawn in both fields, half
        // a line apart, and the dark gaps between the lines are filled
        bool show = isShow(vSignal.x) && scan < 0.5;
        bool prog = interlace < 0.5;                       // the console's own picture: 240p/288p
        if (show) interlace = 1.0;
        bool x68 = scan > 2.5;                             // the X68000's monitor (x68Raster)
        float dbl = (vga && srcH <= 300.0) ? 2.0 : (x68 ? vSignal.z : 1.0);
        float BH = srcH * dbl;
        // the TV's field: 240 or 288 lines (480 or 576 interlaced); a frame with fewer lines leaves a
        // border, as on the real set. Picture height 1 lets the core's lines fill the height
        // instead, for cores that crop lines and set the aspect ratio from the lines they keep
        // (on a TV the picture is then a zoom of the same tube: lines and beam keep their look).
        // On a tube in mm it is the monitor's height control, as an arcade operator set it for the
        // game: the lines move apart or together, and the spot keeps its size in mm.
        // The X68000's monitor too: its 15 kHz picture is 240 lines high, so a 256-line game on
        // Console timing 11 runs 8 lines past it at the top and bottom, unless the lines fill it.
        float visField = x68 ? vSignal.w : scan > 0.5 ? BH : (pal > 0.5 ? 288.0 : 240.0) * (interlace > 0.5 ? 2.0 : 1.0);
        float visLines = (LR_FILL > 0.5 && (scan < 0.5 || x68) && !show) ? BH : visField;
        bool il = interlace > 0.5 && LR_STEADY < 0.5;
        float stepL = il ? 2.0 : 1.0;
        float offL = il ? float(LR_FrameCount % 2u) : 0.0;
        float sgk = (interlace > 0.5 && LR_STEADY > 0.5) ? 2.0 : 1.0;

        // TV show: raster line i shows programme line floor(i / rps) (rps: 2 for a 240p/288p
        // console, whose line is in both fields). A game in the other TV standard (an NTSC game
        // on a PAL programme, or the other way round) went through the studio's standards
        // converter, which scaled the console's picture to the programme's (see showLines).
        // The tv-show-broadcast preset's extra pass already made one beam row per programme
        // line; without it (Cable 4 in another preset) the conversion is done here, per pixel:
        // beam row = programme line * scv + sco.
        vec4 smap = vec4(1.0, 1.0, 0.0, 0.0);
        float rps = 1.0, scv = 1.0, sco = 0.0, beamLines = srcH;
        if (show)
        {
            smap = showLines(pal, prog ? 0.0 : 1.0, srcH);
            rps = smap.x;
            if (textureSize(Texture, 0).y == int(SHOW_LINES_ROWS))
                beamLines = smap.w;
            else
            {
                scv = smap.y;
                sco = smap.z;
            }
            BH = visLines;                                          // borders come from the console's frame
        }

        float Lf = ua.y * visLines - (visLines - BH) * 0.5;
        float u = (Lf - offL - 0.5) / stepL;
        float j0 = floor(u);

        // vertical convergence error grows toward the edges (the horizontal one is in the beam pass)
        float convV = LR_CONV * 0.5 * (0.3 + 0.7 * c.y * abs(c.y));
        // spot height in lines: TV in line units; a tube in mm from its line pitch, so the same
        // spot covers more lines in 768-line modes than in 400-line ones, and NTSC lines (fewer,
        // further apart) show more than PAL lines; with Picture height 1 the lines across the height
        // are the core's (a 224-line arcade game shows a little more of the gaps than a 240-line one)
        vec2 sig = vec2(LR_SIG_LO, max(LR_SIG_LO, LR_SIG_HI)) * sgk;
        if (mm)
            sig = vec2(LR_MON_SPOT_LO, max(LR_MON_SPOT_LO, LR_MON_SPOT_HI))
                * (FWHM_TO_SIGMA * monCornerGrowth(c) * visLines / monScanMM().y);

        // the band each line's light is averaged over (lineLight), in lines: Scanline smoothing
        // times one screen pixel's height. 0 takes the light at the pixel's centre, 1 averages it
        // over the pixel; more softens the lines a little and takes out more moire, for narrow beams.
        float hw = LR_SMOOTH * visLines * monShown().y / (tubePx.y * stepL);

        // every line within 3.5 spot widths: the lines left out are at least kn + 1 away
        // (4 lines for 240p TV, more for wide spots: merged fields, 1024x768 on a PC monitor)
        int kn = int(clamp(ceil(3.5 * sig.y + 0.5 * hw - 1.0), 1.0, 6.0));
        float lastRow = -1e6;                                // TV show: the programme line read last
        vec4 bb = vec4(0.0);
        for (int k = -kn; k <= kn + 1; k++)
        {
            float j = j0 + float(k);
            float i = j * stepL + offL;
            if (show)
            {
                // both raster lines of a programme line (merged fields) use the same beam: read it once
                float r = floor(i / rps);
                if (r != lastRow)
                {
                    bb = showBeam(r * scv + sco, xs, beamLines);
                    lastRow = r;
                }
            }
            else
                bb = beamAt(floor(i / dbl) * rpl + ph, xs, srcH * rpl + ph);
            vec3 b = bb.rgb;
            vec3 lc = b * b;                                      // linear brightness
            // beam height: TV from the local brightness per gun; PC from the spot that made the light
            vec3 isg = 1.0 / mix(vec3(sig.x), vec3(sig.y), mm ? vec3(bb.a) : b);
            vec3 d = vec3(u - j) + vec3(convV, 0.0, -convV);
            col += lc * lineLight(d, isg, hw);
        }
        col *= smoothstep(-0.002, 0.002, xs) * smoothstep(1.002, 0.998, xs);

        // phosphor mask
        float mt = vSignal.y;
        float triads = LR_MASK_TRIADS;
        // tube in mm: from the mask pitch (a dot mask's pitch is diagonal, 0.866 of it horizontal)
        if (mm) triads = monTubeMM().y / (LR_MON_PITCH * (mt > 2.5 && mt < 3.5 ? 0.866 : 1.0));
        float pitchPx = tubePx.y / triads;
        // on screen pixels (pixelMask): w pixels per triad, or with 1 (auto) the whole number nearest
        // the tube's own pitch; it does not need to fade out on fine pitches
        bool onPx = LR_MASK_PX > 0.5 && mt > 0.5 && mt < 3.5;
        float wPx = LR_MASK_PX < 1.5 ? clamp(floor(pitchPx + 0.5), 2.0, 6.0) : LR_MASK_PX;
        float str = LR_MASK_STR * (onPx ? 1.0 : smoothstep(1.6, 2.6, pitchPx));
        // the mask's share of the light at each of its points in this pixel (one without a mask or on
        // screen pixels, where pixelMask has averaged its own points)
        vec3 mf[4];
        for (int i = 0; i < 4; i++) mf[i] = vec3(1.0);
        int nm = 1;
        if (mt > 0.5 && str > 0.0)
        {
            float avg;
            if (onPx)
            {
                vec4 pm = pixelMask(floor(vTexCoord * LR_OutputSize.xy), wPx, mt);
                mf[0] = pm.rgb;
                avg = pm.a;
            }
            else
            {
                vec2 mp = ut * tubePx / pitchPx;
                float dp = 0.25 / pitchPx;
                nm = maskPoints(mp - dp, mp + dp, mt, mf);
                avg = mt < 1.5 ? 0.367 : (mt < 2.5 ? 0.31 : (mt < 3.5 ? 0.19 : 0.84));
            }
            for (int i = 0; i < 4; i++) mf[i] = mix(vec3(1.0 - str), vec3(1.0), mf[i]) / mix(1.0 - str, 1.0, avg);
        }
        float damper = 1.0;
        if (mt > 0.5 && mt < 1.5)
        {
            // aperture grille: the two horizontal damper wires (Damper wires: 1 as on the tube, less
            // fainter, 0 none; the wires were there, so leaving them out is the viewer's choice)
            float hp = tubePx.y;
            float sw = max(0.45, hp / 4000.0);
            float d1 = (ut.y - 1.0 / 3.0) * hp, d2 = (ut.y - 2.0 / 3.0) * hp;
            damper = 1.0 - 0.2 * LR_DAMPER * (exp(-0.5 * d1 * d1 / (sw * sw)) + exp(-0.5 * d2 * d2 / (sw * sw)));
        }

        // halation: light diffused in the glass (energy-conserving)
        float gy = show ? ((Lf / rps - 0.5) * smap.y + smap.z + 0.5) / srcH : Lf / BH;
        float gin = smoothstep(-0.03, 0.03, gy) * smoothstep(1.03, 0.97, gy) * smoothstep(-0.03, 0.03, xs) * smoothstep(1.03, 0.97, xs);
        vec3 glow = textureLod(LR_GlowTexture, vec2(xs, gy), 0.0).rgb * vWhite;
        float gw = LR_GLOW * gin;

        // the tube's phosphors are not exactly the display's primaries; colours outside
        // the display gamut are clipped in SDR and kept in HDR
        bool phos = vPhos > 1.5;
        mat3 pm3 = phos ? phosphorMatrix(vPhos) : mat3(1.0);
        // Each mask point's light goes through the display's shoulder on its own, and the pixel shows
        // their average. Where a lit stripe is brighter than the display can show, the shoulder
        // squeezes the stripe itself, as the eye would see it squeezed at any position. Squeezing
        // the pixel's average instead made how much a pixel lost depend on where the stripes fell
        // on it, and that brought back part of the beat between the mask and the screen's pixels
        // that the points average out (moire, about 1.6 times as strong as in HDR; trinitron at
        // 1080p, 2.84 pixels per triad, bars over the whole screen). docs/sources/mask-moire.md
        vec3 beam = col;
        col = vec3(0.0);
        for (int i = 0; i < nm; i++)
        {
            vec3 p = beam * mf[i];
            p *= damper;
            p *= vWhite;
            p = mix(p, glow, gw);
            if (phos) p = pm3 * p;
            p = shoulder(p);
            col += p;
        }
        col /= float(nm);
        float r2 = clamp(dot(c, c) * 0.5, 0.0, 1.0);
        col *= 1.0 - LR_VIGNETTE * pow(r2, 1.6);
        col += 0.01 * LR_REFLECT * LR_ROOM * vec3(0.80, 0.92, 0.87);   // Room reflection in %
        col *= inside;
    }

    vec2 fc = floor(vTexCoord * LR_OutputSize.xy);
    float n = fract(52.9829189 * fract(dot(fc, vec2(0.06711056, 0.00583715))));
    // the dither of present.slang (keep the two the same): each channel takes the 8-bit code just
    // below or just above its value, the upper one with the chance that keeps the average in
    // linear light, with interleaved gradient noise, the same for the three channels
    vec3 lin = clamp(col, 0.0, 1.0);
    vec3 code = min(floor(pow(lin, vec3(1.0 / 2.2)) * 255.0), 254.0);
    vec3 lo = pow(code / 255.0, vec3(2.2)), hi = pow((code + 1.0) / 255.0, vec3(2.2));
    vec3 up = clamp((lin - lo) / (hi - lo), 0.0, 1.0);
    FragColor = vec4((code + vec3(greaterThan(up, vec3(n)))) / 255.0, 1.0);
}

void main()
{
    lr_main();
}
#endif
