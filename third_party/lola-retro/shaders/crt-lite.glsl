// Lola Retro - pass 6 of the lite presets, for weak GPUs (older phones, see README). The pass
// itself is in crt.inc. It writes the screen itself, so the present pass and the full-screen
// float target between the two are not needed, and leaves out the phosphor afterglow (it reads a
// second full-screen float target back every frame) and Around the tube.

#define LR_NO_FEEDBACK
#define LR_NO_BACKDROP
#define LR_PRESENT
// Lola Retro - pass 6: electron beam, phosphor mask and glass, at screen resolution.
// Shared by crt.slang (SDR), crt-hdr.slang (HDR), crt-lite.slang and crt-super-lite.slang.
// - Each source line is a beam with a Gaussian profile whose width grows with brightness
//   (per colour gun), so bright lines merge and dark lines show gaps.
// - Interlaced sources alternate fields; VGA 200-line modes are scanned twice.
// - Mask: aperture grille (with damper wires), slot mask, shadow mask or a projection screen.
// - Glass: curvature, halation, white point, vignette, room reflection, phosphor afterglow.
// Options for the GLSL port (tools/make_glsl.py), off in RetroArch:
//   LR_FIELDS       an Amiga frame with every line drawn twice is one line per row pair
//                   (the fields passes find out), not an interlaced frame
//   LR_NO_FEEDBACK  no afterglow (the emulator has no feedback textures)
//   LR_FIT_43       the tube stays 4:3 whatever shape the picture area has
//   LR_PACKED_SPOT  the beam pass has no alpha channel, the spot is packed onto red
//   LR_ROWS_UP      rows count from the bottom of the screen (OpenGL), for light from above
// Options for the lite presets (crt-lite.slang), with LR_NO_FEEDBACK:
//   LR_NO_BACKDROP  nothing around the tube (Around the tube stays black)
//   LR_PRESENT      the present pass done here: 8-bit output with its dither, straight to the screen
//   LR_SUPER_LITE   (crt-super-lite.slang) 3 beam lines instead of 4, a cheaper dither

// Lola Retro - shared parameters, uniforms and helpers for every pass.
//
// The chain simulates the whole analog path:
//   console encoder -> cable -> TV decoder -> electron beam -> phosphor mask -> glass.
// Console timing (pixel clock, subcarrier cycles per line) decides how composite
// artefacts look, so it is part of the model.

const float TAU = 6.28318530718;

// Dither blend (RGB and S-Video, off by default): composite blended 1-pixel dither
// patterns into new colours or transparency; on RGB they stay visible as stripes.
// The blend finds the part of the picture that alternates from one console pixel to
// the next (a Gaussian window of 1.25 pixels with alternating signs, a narrow notch at
// half the pixel clock) and takes it out. Flat areas, gradients and wider detail are
// left alone. How much: Dither blend, or with Dither blend auto what composite would take
// (ditherBlend, below getTiming). Weights for offsets 0..4 and the normalisation 4 * (w1 + w3):
const float DBW[5] = float[5](1.0, 0.726149, 0.278037, 0.056135, 0.005976);
const float DBN = 3.129136;
float dbSign(int k) { return (abs(k) & 1) == 1 ? -1.0 : 1.0; }

// RF: the echo (multipath ghost) added by the antenna path
const float RF_ECHO = 0.12;      // strength
const float RF_ECHO_US = 0.8;    // delay in microseconds

// TV show (cable 4): the game seen on a TV programme. The console's RGB goes into the studio,
// where a frame synchronizer turns its 240p/288p frames into a standard interlaced picture
// (each console frame becomes one field, the next one lands half a line lower; the CRT pass
// draws every console line in both fields), onto Betacam SP tape (LR_TAPE copies), through
// the station's colour encoder and the transmitter, and from a roof antenna into an ordinary
// TV, which decodes it like composite. Bandwidths in MHz at -3 dB.
// Sony BVW-75P: Y 5.5 MHz -3 dB, colour 1.5 MHz -1.5 dB (about 2.1 MHz at -3 dB);
// ITU-R BT.470: PAL U and V less than 3 dB down at 1.3 MHz. The transmitter's 5 MHz limit
// (PAL B/G) and the receiving TV's IF filter: the same IF filter as on RF (IF_PAL, IF_NTSC in decode.inc).
const float SHOW_TAPE_Y = 5.5;   // Betacam SP luma, one copy
const float SHOW_TAPE_C = 2.1;   // Betacam SP colour difference signals, one copy
const float SHOW_ENC_C = 1.3;    // the station's colour encoder (U and V)
const float SHOW_GHOST_US = 1.2; // delay of the antenna ghost: a reflection about 360 m longer

bool isShow(float cable) { return cable > 3.5; }

// Echo on the antenna path: x = strength, y = delay in microseconds
vec2 rfEcho(float cable)
{
    if (cable < 0.5) return vec2(RF_ECHO, RF_ECHO_US);
    if (isShow(cable)) return vec2(LR_GHOST, SHOW_GHOST_US);
    return vec2(0.0, 1.0);
}

// The console's TV standard from the core's frame rate (OriginalFPS, docs/sources/core-frame-rates.md).
// Every 50 Hz system reports 49.7 to 50.2 frames a second, every 60 Hz one 54.7 or more (the consoles
// 59.2 to 60.1), so below 52 is PAL whatever the line count: most PAL SNES games and the Mega Drive's
// 224-line mode have 224 lines. Exactly 60 says nothing: the image viewer, Play! (PAL games too) and
// FinalBurn Neo's default report it whatever the content, and the cores that report it for NTSC
// (PicoDrive, Mupen64Plus-Next) send at most 240 lines a field, which the line count takes as NTSC
// too. Returns 1 PAL, 0 NTSC, -1 when the rate is missing (RetroArch before 1.20, the Amiberry and
// 86Box ports) or says nothing: then the line count decides (getTiming).
float rateStandard()
{
    return -1.0;
}

// TV show: how the programme's lines map to the console's. x: raster lines per console line
// (2 for a 240p/288p console, whose line is drawn in both fields), y: console lines per
// programme line (1 unless the studio's standards converter scaled the picture to the other
// TV standard), z: the console line of programme line 0 (a shorter frame sits in the middle),
// w: the programme's lines (one field for a 240p/288p console, the whole frame for an
// interlaced one). lines: the console's native lines.
vec4 showLines(float pal, float interlace, float lines)
{
    bool prog = interlace < 0.5;
    float field = pal > 0.5 ? 288.0 : 240.0;
    float plines = prog ? field : 2.0 * field;
    // the console's own standard by the same rule as TV standard auto (getTiming): the frame rate
    // where it says, otherwise the line count
    float rs = rateStandard();
    bool ownPal = rs < -0.5 ? (prog ? lines : lines * 0.5) > 240.5 : rs > 0.5;
    float own = (ownPal ? 288.0 : 240.0) * (prog ? 1.0 : 2.0);
    float scv = own / plines;
    // (lines of an upscaled frame can be a hair off a whole number: a margin)
    return vec4(prog ? 2.0 : 1.0, scv, 0.5 * scv - 0.5 - floor(0.5 * (own - lines) + 0.01), plines);
}

// The TV presets run the encoder and decoder at a fixed 1280 samples per line (about 27 MHz,
// 4 per pixel of a 320-wide console), whatever the frame's width: the signal needs no more,
// and an upscaled frame (internal resolution) then costs no more than a native one. A frame
// wider than that is averaged down to it in the native pass. (The PC and Amiga presets keep
// 4 samples per frame pixel: their beam reads every pixel exactly.)
const float ENC_SAMPLES = 1280.0;

// The tv-show-broadcast preset has one more pass (show-lines.slang) that makes one beam row
// per programme line, so the CRT pass does not interpolate at every screen pixel. Its output
// is this many rows high: more than any programme has, and a height the beam pass of the other
// presets never has, so the CRT pass can tell which rows it gets.
const float SHOW_LINES_ROWS = 577.0;

float hash13(vec3 p3)
{
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}

// ---------------------------------------------------------------------------
// Console timing
// ---------------------------------------------------------------------------
// Console ids: 1 SNES/NES, 2 Mega Drive H40, 3 Mega Drive H32 and Master System, 4 PlayStation,
// 5 PlayStation 2, 6 Amiga, 7 PC VGA (also the PC-98's 640x400), 8 Arcade 15 kHz, 9 Arcade 24 kHz,
// 10 Sharp X68000 on its own monitor, 11 the same with 256-line frames at 15 kHz (see x68Raster).
// Other systems use the id with their timing (PC Engine, Saturn, N64: 4).

float autoConsole(vec2 s)
{
    float w = s.x, h = s.y;
    bool mon15 = LR_MON_MM > 0.5;    // a 15 kHz monitor cannot show 31 kHz VGA
    // 640x400 is VGA's 400 lines and the PC-98's: on a computer monitor the same picture
    if (!mon15 && ((w == 320.0 && h == 200.0) || (w == 640.0 && (h == 350.0 || h == 400.0)))) return 7.0;
    if (h == 256.0 || h == 512.0 || (w == 640.0 && h == 200.0)) return 6.0;
    if (mon15 && (h == 200.0 || h == 400.0) && (w == 320.0 || w == 640.0)) return 6.0;
    // PUAE's default frames: the whole overscan area, 360, 720 or 1440 wide (PAL 287 or 574 rows, NTSC 242 or 484)
    if ((w == 360.0 || w == 720.0 || w == 1440.0) && (h == 287.0 || h == 574.0 || h == 242.0 || h == 484.0)) return 6.0;
    if (h >= 336.0 && h <= 400.0 && w >= 400.0) return 9.0;
    if (h > 300.0) return 5.0;
    if (w > 420.0) return 4.0;
    // 192 lines: the Master System (and MSX, ColecoVision), 228 cycles per line like the Mega Drive
    if (w == 256.0 && h == 192.0) return 3.0;
    if (w <= 300.0) return 1.0;
    if (h >= 232.0) return 4.0;
    return 2.0;
}

// a: pixel clock NTSC, pixel clock PAL (MHz), nominal width, scan mode (0 TV, 1 VGA, 2 fill,
//    3 the X68000's monitor: 15 and 31 kHz on one tube, see x68Raster)
// b: subcarrier phase step per line (NTSC, PAL), per field (NTSC, PAL)
// c: x = 1 when the PAL line count per field is odd (V-switch flips every field)
void consoleTable(float id, out vec4 a, out vec4 b, out float c)
{
    if (id < 1.5)      { a = vec4(5.369318, 5.320342, 256.0, 0.0); b = vec4(1.0 / 3.0, 1.0 / 6.0, 1.0 / 3.0, 0.0);  c = 0.0; }
    else if (id < 2.5) { a = vec4(6.711647, 6.650428, 320.0, 0.0); b = vec4(0.0, 0.0, 0.0, 0.0);                    c = 1.0; }
    else if (id < 3.5) { a = vec4(5.369318, 5.320342, 256.0, 0.0); b = vec4(0.0, 0.0, 0.0, 0.0);                    c = 1.0; }
    else if (id < 4.5) { a = vec4(6.711647, 6.652800, 320.0, 0.0); b = vec4(0.5, 0.75, 0.5, 0.5);                  c = 0.0; }
    else if (id < 5.5) { a = vec4(13.5, 13.5, 640.0, 0.0);        b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else if (id < 6.5) { a = vec4(7.15909, 7.09379, 320.0, 0.0);  b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else if (id < 7.5) { a = vec4(12.5875, 12.5875, 320.0, 1.0);  b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else if (id < 8.5) { a = vec4(6.711647, 6.711647, 320.0, 0.0); b = vec4(0.5, 0.75, 0.5, 0.5);                  c = 0.0; }
    else if (id < 9.5) { a = vec4(16.0, 16.0, 496.0, 2.0);        b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else               { a = vec4(34.78, 34.78, 768.0, 3.0);      b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
}

// TV timings (and auto): everything but the Amiga, VGA, 24 kHz arcade and X68000 (6, 7, 9, 10, 11)
bool tvTiming(float id) { return id < 5.5 || (id > 7.5 && id < 8.5); }

// The Sharp X68000 on its own monitor (Console timing 10 and 11): the CZ-600D and its family took
// 15, 24 and 31 kHz on one tube, and Sharp's manuals (CZ-605D/613D, CZ-614D) give one picture size,
// 278 x 209 mm, for all of them: 240 active lines at 15 kHz (52.69 us of each line), 400 at 24 kHz,
// 512 at 31 kHz (22.08 us). px68k sends the CRTC's display window, no borders (TextDotX x TextDotY),
// so the frame's rows tell the mode (docs/sources/x68000-video.md):
// - up to 240 rows: 15 kHz, one raster per row, in the 240 lines of the picture: the gaps show;
// - 241-300 rows: 31 kHz with every line scanned twice (512 rasters, no gaps), the X68000's usual
//   game mode (256x256, 512x256). Console timing 11 takes them as 15 kHz instead, for the games
//   with a 256-line window at 15 kHz: the frame alone cannot tell (only the frame rate, 55 or 61 Hz);
// - more: every row is a raster, filling the height: 512 lines at 31 kHz (768x512, the Human68k
//   prompt), both fields of 15 kHz interlace (512x480), 24 kHz modes (400 lines).
// Returns x: rasters per row, y: rasters across the picture height, z: active line time (us).
vec3 x68Raster(float rows, float id)
{
    bool k15 = id > 10.5;
    if (rows <= 240.5 || (k15 && rows <= 300.0)) return vec3(1.0, 240.0, 52.69);
    if (rows <= 300.0) return vec3(2.0, 512.0, 22.08);
    return vec3(1.0, rows, rows <= 480.5 ? 52.69 : 22.08);
}

// Internal resolution: an upscaled frame (more than 576 lines, or a console set by hand
// whose native mode is smaller) is read as k x k blocks of one native pixel.
// The frame's size cannot tell a console's own 480i from a 240-line game at 2x: both are 480
// lines. Frames over 300 lines 1 says it is always the console's 480i/576i, on every TV timing:
// the 480-line base of the PlayStation 2 (Console timing 5). For cores that never upscale
// (Beetle Saturn sends its 480i as 640x448 or 704x480) and cores at 1x. An upscaled interlaced
// frame is still found: 960 lines are 480i at 2x, 1152 lines 576i at 2x. 0 keeps the guess below.
// 2 (the computer monitor, see getTiming) finds the native lines the same way.
// More than one k can fit: 1440 lines are 240 lines at 6x and 288 at 5x, 1120 lines 224 at 5x
// and 280 at 4x. A k that gives a standard height wins: 240 or 224 lines for NTSC, 288 or 256
// for PAL (twice that in the 480i class), NTSC first unless TV standard is set to PAL or, on auto,
// the frame rate says PAL (rateStandard). Without one, the smallest k that fits
// (docs/sources/internal-resolution.md).
// Returns k (1 for native frames).
float upscaleOf(vec2 orig)
{
    float id = LR_CONSOLE;
    bool tv = tvTiming(id);                              // VGA, Amiga and 24 kHz modes are never scaled
    // 480i class: PS2 by hand, or any TV timing with Frames over 300 lines 1 or 2; otherwise 240p class
    bool il = tv && (LR_HIRES > 0.5 || (id > 4.5 && id < 5.5));
    float base = il ? 480.0 : 240.0;
    bool scaled = (id < 0.5 && !il) ? orig.y > 576.0 : (tv && orig.y > base * 1.5);
    if (!scaled) return 1.0;
    // the standard heights, the preferred one first
    bool palFirst = LR_NORM > 1.5 || (LR_NORM < 0.5 && rateStandard() > 0.5);
    vec4 hs = (palFirst ? vec4(288.0, 256.0, 240.0, 224.0) : vec4(240.0, 224.0, 288.0, 256.0))
            * (il ? 2.0 : 1.0);
    float first = 0.0, best = 0.0, rank = 4.0;
    for (float k = 2.0; k <= 16.0; k += 1.0)
    {
        // whole lines: rounded and multiplied back, as a division can land a hair off a whole number
        float lines = floor(orig.y / k + 0.5);
        if (lines * k != orig.y || lines < base * 0.83 || lines > base * 1.21) continue;
        if (first < 0.5) first = k;
        for (int j = 0; j < 4; j++)
        {
            if (lines == hs[j] && float(j) < rank) { best = k; rank = float(j); }
        }
    }
    if (best > 0.5) return best;
    if (first > 0.5) return first;
    // the computer monitor takes any other frame as it is: 1024x768 is a computer's own mode
    if (il && LR_HIRES > 1.5) return 1.0;
    return max(1.0, floor(orig.y / base + 0.5));
}

struct Timing
{
    float pclk;        // pixel clock for this source width (MHz)
    float fsc;         // colour subcarrier (MHz)
    float lineFrac;    // subcarrier phase advance per line (cycles)
    float fieldStep;   // phase advance per field (cycles)
    float framePhase;  // phase offset of the current field (cycles)
    float altStep;     // > 0: the phase only alternates between 0 and this from frame to frame (NES, SNES)
    float vsw;         // PAL V-switch offset for this field
    float vswStep;     // change of the V-switch offset per field (1 when the line count per field is odd)
    float pal;         // 1 = PAL
    float scan;        // 0 TV raster, 1 VGA line doubling, 2 fill (24 kHz arcade)
    float interlace;   // 1 = 480i/576i source
    float scale;       // internal resolution factor of the core (1 = native)
    float id;          // console timing id (see consoleTable)
    float hres;        // frame pixels per console pixel (Amiga: 1 lores, 2 hires, 4 superhires)
    float monitor;     // 1 = drawn on the computer monitor (Frames over 300 lines 2)
    float cable;       // the cable in use: Cable, or 3 (RGB) on the computer monitor
};

bool isAmiga(Timing t) { return t.id > 5.5 && t.id < 6.5; }

Timing getTiming(vec2 orig, uint frameCount)
{
    Timing t;
    t.scale = upscaleOf(orig);
    vec2 nat = orig / t.scale;                          // the console's native mode
    float id = LR_CONSOLE < 0.5 ? autoConsole(nat) : LR_CONSOLE;
    // Frames over 300 lines 2: a frame with more than 300 native lines on a TV timing is drawn
    // as if the user had switched to a separate computer monitor, as people did (an Atari ST
    // owner had a high-res monitor for the desktop and a TV for games). That monitor is the PC
    // monitor model: VGA timing (scan mode 1: every line once, filling the height), the tube in
    // mm from the Monitor values, RGB, sRGB phosphors and a dot mask (phosphorSet, maskType),
    // whatever the preset's cable and timing; frames of 300 lines or fewer keep the preset.
    // A compromise: one screen stands in for two and switches by itself, and the rest of the
    // preset (the glass and its curvature, overscan, convergence, white point, the TV's knobs)
    // stays as it is. Passes read the cable from here (t.cable), never from Cable directly.
    t.monitor = (LR_HIRES > 1.5 && tvTiming(id) && nat.y > 300.0) ? 1.0 : 0.0;
    if (t.monitor > 0.5) id = 7.0;
    bool x68 = id > 9.5;                                // the X68000's monitor: RGB only
    t.cable = (t.monitor > 0.5 || x68) ? 3.0 : LR_CABLE;
    vec4 a; vec4 b; float c;
    consoleTable(id, a, b, c);
    t.id = id;
    if (id > 4.5 && id < 5.5 && nat.x > 700.0) a.z = 720.0;   // PS2 720-wide modes keep 13.5 MHz
    t.scan = a.w;
    t.interlace = (t.scan < 0.5 && nat.y > 300.0) ? 1.0 : 0.0;
    bool amiga = id > 5.5 && id < 6.5;
    if (t.monitor > 0.5) t.pal = 0.0;                   // a computer monitor has no TV standard
    else if (LR_NORM > 1.5) t.pal = 1.0;
    else if (LR_NORM > 0.5) t.pal = 0.0;
    else
    {
        // the core's frame rate where it says (rateStandard), otherwise the line count: an Amiga
        // NTSC frame with its overscan border has up to 243 lines, a PAL one 256 or more
        float lines = t.interlace > 0.5 ? nat.y * 0.5 : nat.y;
        float rs = rateStandard();
        bool palLines = lines > (amiga ? 249.5 : 240.5);
        t.pal = (t.scan < 0.5 && (rs < -0.5 ? palLines : rs > 0.5)) ? 1.0 : 0.0;
    }
    // full source width: a wider (upscaled) line still takes the same time
    float base = mix(a.x, a.y, t.pal);
    t.pclk = base * orig.x / a.z;
    // Amiga: the width tells lores, hires or superhires. Emulators often send the whole
    // overscan area (PUAE and Amiberry: 720 wide in hires), so a wider frame is a longer
    // line at the same pixel clock, not faster pixels.
    float cls = orig.x < 480.0 ? 1.0 : (orig.x < 960.0 ? 2.0 : 4.0);
    if (amiga) t.pclk = base * (320.0 * cls) / a.z;
    // SVGA modes run faster lines: VESA 75 Hz clocks (800x600 49.5 MHz, 1024x768 78.75 MHz)
    if (t.scan > 0.5 && t.scan < 1.5 && orig.x > 720.0) t.pclk = 78.75 * orig.x * orig.y / (1024.0 * 768.0);
    // the computer monitor: an upscaled frame runs at its native mode's clock (k pixels per pixel)
    if (t.monitor > 0.5) t.pclk = (nat.x > 720.0 ? 78.75 * nat.x * nat.y / (1024.0 * 768.0) : base * nat.x / a.z) * t.scale;
    // X68000: the window's pixels across the mode's active line time
    if (x68) t.pclk = orig.x / x68Raster(orig.y, id).z;
    t.hres = amiga ? cls : orig.x / a.z;
    t.fsc = t.pal > 0.5 ? 4.433619 : 3.579545;
    // TV show: the station's encoder makes the subcarrier of a standard interlaced broadcast,
    // so its rhythm is the standard's (the PlayStation 2 row), not the console's
    if (isShow(t.cable)) { b = vec4(0.5, 0.75, 0.75, 0.875); c = 0.0; }
    // PlayStation, Saturn and N64 in 480i/576i: 525 (625) lines per frame, as the standard, not
    // twice their 263 (314) progressive lines: psx-spx gives 262.5 lines per NTSC field and 312.5
    // per PAL field, n64brew 525 half-lines (VI_V_TOTAL 524), Mednafen's Saturn alternates fields
    // of 263 and 262 lines. With 227.5 (283.75) cycles per line the phase then moves 3/4 (7/8) of
    // a cycle per field, as on the PlayStation 2.
    if (id > 3.5 && id < 4.5 && t.interlace > 0.5) { b.z = 0.75; b.w = 0.875; }
    t.lineFrac = mix(b.x, b.y, t.pal);
    t.fieldStep = mix(b.z, b.w, t.pal);
    // 24 is a multiple of every field cycle above (1, 2, 3, 4, 8), so the phase never drifts
    float fc = LR_STEADY > 0.5 ? 0.0 : float(frameCount % 24u);
    // NES and SNES (NTSC, not interlaced): 1364 master clocks per line, 227 1/3 cycles, so a
    // 262-line frame moves the phase by 1/3 cycle. But every other frame is 4 clocks short (the
    // NES skips a dot, the SNES shortens one line), which moves it by 2/3 instead, so the phase
    // only alternates between two values, 2/3 cycle apart: the dots jitter instead of crawling.
    // (A 3-frame crawl only happens in the few NES games that blank the start of the frame.)
    t.altStep = (id < 1.5 && t.pal < 0.5 && t.interlace < 0.5) ? 2.0 / 3.0 : 0.0;
    t.framePhase = t.altStep > 0.0 ? t.altStep * mod(fc, 2.0) : fract(fc * t.fieldStep);
    t.vsw = mod(fc * c, 2.0);
    t.vswStep = c;
    return t;
}

// The gain of a Gaussian low-pass with -3 dB at fc (MHz) at frequency f (MHz), the filters of the
// encoder and decoder: exp(-2 pi^2 (0.1325 / fc)^2 f^2)
float gaussGain(float f, float fc)
{
    float s = 0.1325 / fc;
    return exp(-19.7392 * s * s * f * f);
}

// How much Dither blend takes out of a 1-pixel pattern (the part that alternates from one console
// pixel to the next, at half the pixel clock): x of its luma, y of its colour. Dither blend sets both.
// Dither blend auto takes what composite would have taken (docs/sources/dither-blend.md): the luma
// share from the filters of the composite path at that frequency, the console's luma trap
// (encode.inc) and the TV's luma filter with Sharpness and its trap or comb filter (decode.inc),
// against the path in use (cable 3 RGB: the video amplifier; 2 S-Video: its luma filter), so the
// pattern keeps the contrast it would have had on composite. Composite took all of its colour (the
// chroma band is 0.6 to 0.8 MHz wide, the pattern 2.5 MHz or more), so the colour share is 1; S-Video's
// own chroma filters already take it. Auto works on 15 kHz TV timings, the consoles and the Amiga,
// which reached most players through composite; arcade boards (RGB monitors) and computer monitors
// keep Dither blend as set. It follows the mode (a Mega Drive game switching between 256 and 320
// pixels), the TV standard (t.pal) and the composite settings, and only knows 1-pixel patterns.
vec2 ditherBlend(Timing t, float cable)
{
    float d = LR_DBLEND;
    bool tv = t.scan < 0.5 && t.monitor < 0.5 && !(t.id > 7.5 && t.id < 8.5);
    if (LR_DBLEND_AUTO < 0.5 || !tv) return vec2(d);
    bool pal = t.pal > 0.5;
    float fsc = pal ? 4.433619 : 3.579545;
    float f = 0.5 * t.pclk / t.scale;                 // the pattern's frequency (MHz)
    float sh = LR_SHARP * 1.4;
    // composite as decode.inc decodes it: the comb filter (NTSC, lines half a cycle apart) or the trap
    bool comb = LR_COMB > 0.5 && !pal && abs(t.lineFrac - 0.5) < 0.05;
    float fcY = (comb || pal) ? 4.2 : 3.3, fcC = pal ? 0.8 : 0.6;
    float yf = (1.0 + sh) * gaussGain(f, fcY) - sh * gaussGain(f, fcY / 2.5);
    float hf = (1.0 + sh) * gaussGain(fsc, fcY) - sh * gaussGain(fsc, fcY / 2.5);
    float notch = comb ? 0.0 : 0.92 * hf * (gaussGain(f - fsc, fcC) + gaussGain(f + fsc, fcC));
    float comp = (1.0 - LR_YTRAP * (gaussGain(f - fsc, 0.5) + gaussGain(f + fsc, 0.5))) * (yf - notch);
    float fcS = pal ? 5.0 : 4.6;
    float own = cable > 2.5 ? gaussGain(f, 6.5) : (1.0 + sh) * gaussGain(f, fcS) - sh * gaussGain(f, fcS / 2.5);
    return vec2(clamp(1.0 - comp / own, 0.0, 1.0), 1.0);
}

// Frame pixels and rows per console pixel and line, for effects sized on the glass (glow,
// misconvergence). Only the Amiga needs it: its emulators send hires frames (2 pixels per lores
// pixel) and draw every line twice or weave two fields. Other consoles keep (1, 1).
vec2 consoleUnit(Timing t) { return isAmiga(t) ? vec2(t.hres, t.interlace > 0.5 ? 2.0 : 1.0) : vec2(1.0); }

// y is a source row; rows of one upscaled block belong to the same native line. The row's centre
// is divided: for the first row of a line y / k is a whole number, and a GPU's division can land
// a hair under it (AMD at 3x), which would put the row in the line before.
float nativeLine(float y, Timing t) { return floor((y + 0.5) / t.scale); }
float physLine(float y, Timing t) { float l = nativeLine(y, t); return t.interlace > 0.5 ? floor(l * 0.5) : l; }
bool oddField(float y, Timing t) { return t.interlace > 0.5 && mod(nativeLine(y, t), 2.0) > 0.5; }

// Subcarrier phase at time tUs (microseconds from the start of the active line) on line y,
// off cycles later in the frame sequence (see steadyFrames)
float phaseAtOff(float tUs, float y, Timing t, float off)
{
    float fo = oddField(y, t) ? t.fieldStep : 0.0;
    return TAU * fract(fract(t.fsc * tUs) + fract(t.lineFrac * physLine(y, t)) + fo + t.framePhase + off);
}
float phaseAt(float tUs, float y, Timing t) { return phaseAtOff(tUs, y, t, 0.0); }

// PAL alternates the sign of V on every line; vsw: the V-switch offset of the frame
float vSignW(float y, Timing t, float vsw)
{
    if (t.pal < 0.5) return 1.0;
    float pl = physLine(y, t) + vsw + (oddField(y, t) ? 1.0 : 0.0);
    return mod(pl, 2.0) < 0.5 ? 1.0 : -1.0;
}
float vSign(float y, Timing t) { return vSignW(y, t, t.vsw); }

// No flicker: the frames the eye blends together.
// Most consoles shift the colour subcarrier from one frame to the next (a 2-frame cycle on the
// PlayStation, up to 8 in PAL), so the cross-colour and the dots along coloured edges move. At
// 50 or 60 frames a second the eye sees their average, in which they largely cancel. A single
// frozen frame would show all of them at full strength, more than anyone ever saw. So with No
// flicker on, the encoder makes the signal for two or three frames of the cycle and the decoder
// averages what they show: the three frames of a 3-frame cycle, otherwise the first frame and
// the one half a subcarrier cycle on (every 2, 4 and 8-frame cycle reaches it), which cancels the
// same artefacts. The NES and SNES alternate between two phases 2/3 cycle apart: their average
// only halves the artefacts, as on the real console. With No flicker off, one frame: the moving
// original.
// Returns the number of frames (1 to 3); off: their phase offsets (cycles), vsw: their PAL
// V-switch offsets.
int steadyFrames(Timing t, out vec3 off, out vec3 vsw)
{
    off = vec3(0.0);
    vsw = vec3(t.vsw, 0.0, 0.0);
    if (LR_STEADY < 0.5) return 1;
    if (t.altStep > 0.0)
    {
        off.y = t.altStep;
        return 2;
    }
    float s = t.fieldStep;
    if (abs(s - 1.0 / 3.0) < 0.01 || abs(s - 2.0 / 3.0) < 0.01)
    {
        off = vec3(0.0, fract(s), fract(2.0 * s));
        vsw = vec3(0.0, mod(t.vswStep, 2.0), mod(2.0 * t.vswStep, 2.0));
        return 3;
    }
    for (float k = 1.0; k <= 8.0; k += 1.0)
    {
        if (abs(fract(k * s) - 0.5) < 0.01)
        {
            off.y = 0.5;
            vsw.y = mod(k * t.vswStep, 2.0);
            return 2;
        }
    }
    // no phase change, but a PAL V-switch that flips every frame (odd line count per field)
    if (t.pal > 0.5 && t.vswStep > 0.5)
    {
        vsw.y = 1.0;
        return 2;
    }
    return 1;
}

// ---------------------------------------------------------------------------
// Monitor in millimetres: PC monitors (31 kHz modes) and the X68000's monitor always, and 15 kHz
// monitors such as the Commodore 1084S when "15 kHz monitor in mm" is on. The tube is described
// like on its spec sheet (size, mask pitch, beam spot on dark and on white), so every video mode
// follows from the same tube: 320x200 doubled to 400 lines or 1024x768 on a PC monitor, PAL or
// NTSC on the 1084S (NTSC lines sit further apart, so they show more), 240 lines at 15 kHz with
// clear gaps and 512 nearly merged at 31 kHz on the X68000's.
// Typical mid-90s 15-inch PC monitor: 13.8-14 inch viewable, 0.28 mm dot pitch, a spot of
// about 0.45 mm on white (sharp at 800x600, soft at 1024x768), dynamic focus keeping the
// corners below 1.5 x the centre spot.
// ---------------------------------------------------------------------------

const float FWHM_TO_SIGMA = 0.4246609;   // Gaussian: sigma = FWHM / (2 sqrt(2 ln 2))

bool isPC(float scan) { return (scan > 0.5 && scan < 1.5) || scan > 2.5; }   // VGA, and the X68000's monitor

// the tube is described in mm
bool inMM(float scan) { return isPC(scan) || (scan < 0.5 && LR_MON_MM > 0.5); }

// The mask: the preset's, or on the computer monitor (Frames over 300 lines 2) the PC monitor's
// dot mask, at its pitch in mm (Dot pitch); a mask turned off (0) stays off
float maskType(Timing t) { return (t.monitor > 0.5 && LR_MASK_TYPE > 0.5) ? 3.0 : LR_MASK_TYPE; }

// Viewable tube face in mm: one inch less than the nominal size, 4:3
vec2 monTubeMM()
{
    float d = (LR_MON_SIZE - 1.0) * 25.4;
    return vec2(0.8 * d, 0.6 * d);
}

// The share of the scan that shows on the tube, across and down: less than 1 when overscan is
// positive (the picture runs past the edges), more when it is negative (a black border).
// Overscan sets both; Overscan height is added to it for the height alone.
vec2 monShown() { return vec2(1.0 - LR_OVERSCAN, 1.0 - LR_OVERSCAN - LR_OVERSCAN_V); }

// The full scan (active line x active lines) in mm: smaller than the tube face when
// overscan is negative (black border), larger when it is positive
vec2 monScanMM() { return monTubeMM() / monShown(); }

// The spot grows toward the corners (deflection defocus); c is the position on the tube, -1..1
float monCornerGrowth(vec2 c) { return 1.0 + (LR_MON_CORNER - 1.0) * 0.5 * dot(c, c); }

// Share of the active line that the source covers. A 15 kHz monitor in mm shows the whole
// active line (52.6 us NTSC, 52 us PAL), so a 320-pixel Amiga line (45 us) leaves side
// borders, like the real 1084S. PC monitors and the TV model fill the width.
float activeShare(Timing t, vec2 orig)
{
    if (!(t.scan < 0.5 && LR_MON_MM > 0.5)) return 1.0;
    return min(orig.x / t.pclk / (t.pal > 0.5 ? 52.0 : 52.6), 1.0);
}

// Standard normal density and cumulative distribution
// (erf after Abramowitz & Stegun 7.1.26, error below 1.5e-7)
vec3 gaussPdf(vec3 z) { return 0.39894228 * exp(-0.5 * z * z); }
vec3 gaussCdf(vec3 z)
{
    vec3 x = abs(z) * 0.70710678;
    vec3 t = 1.0 / (1.0 + 0.3275911 * x);
    vec3 p = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t;
    return 0.5 + 0.5 * sign(z) * (1.0 - p * exp(-x * x));
}

// ---------------------------------------------------------------------------
// Colour of the TV: its chroma decoder and its phosphors
// ---------------------------------------------------------------------------

// Chroma decoder: 1 = by the standard. American and Japanese TVs demodulated R-Y and G-Y
// on shifted axes with their own gains ("red push", warmer skin tones). PAL TVs, broadcast
// monitors and RGB inputs use the standard axes. A TV show reaches the TV as composite.
float decoderType(Timing t, float cable)
{
    if (t.monitor > 0.5) return 1.0;                  // the computer monitor: RGB, no decoder
    if (LR_DEMOD > 0.5) return LR_DEMOD;
    return (t.pal < 0.5 && (cable < 2.5 || isShow(cable))) ? 2.0 : 1.0;
}

// R, G, B from Y and the demodulated U, V (U = 0.492 (B-Y), V = 0.877 (R-Y)).
// Consumer axes and gains from the Sony CXA2025AS datasheet, relative to B-Y:
// US mode R-Y 112 deg x0.83, G-Y 252 deg x0.30; Japanese mode R-Y 95 deg x0.78, G-Y 240 deg x0.30.
vec3 decodeRGB(float Y, vec2 uv, float dec)
{
    if (dec < 1.5)
        return vec3(Y + 1.13983 * uv.y, Y - 0.39465 * uv.x - 0.58060 * uv.y, Y + 2.03211 * uv.x);
    bool us = dec < 2.5;
    float ar = radians(us ? 112.0 : 95.0), gr = us ? 0.83 : 0.78;
    float ag = radians(us ? 252.0 : 240.0), gg = 0.30;
    float ry = (uv.x * cos(ar) + uv.y * sin(ar)) * gr / 0.492;
    float gy = (uv.x * cos(ag) + uv.y * sin(ag)) * gg / 0.492;
    return vec3(Y + ry, Y + gy, Y + uv.x / 0.492);
}

// Phosphors: 1 sRGB / Rec.709, 2 SMPTE-C (NTSC sets), 3 EBU (PAL sets, broadcast monitors),
// 4 Japanese P22 (Sony Trinitron and Japanese sets, arcade monitors).
float phosphorSet(Timing t)
{
    if (t.monitor > 0.5) return 1.0;                  // the computer monitor (Frames over 300 lines 2)
    if (LR_PHOS > 0.5) return LR_PHOS;
    if (t.scan > 0.5 && t.scan < 1.5) return 1.0;   // PC monitors: sRGB was defined from them
    if (t.id > 7.5) return 4.0;                       // arcade monitors, the X68000's (Japanese)
    return t.pal > 0.5 ? 3.0 : 2.0;
}

// Linear phosphor RGB -> linear Rec.709 RGB, white (D65) kept. Primaries (x, y):
// SMPTE-C R .630 .340 G .310 .595 B .155 .070; EBU R .640 .330 G .290 .600 B .150 .060;
// Japanese P22 R .625 .350 G .280 .605 B .152 .062 (Sony KV-20M20 and others, via Dogway's grade).
mat3 phosphorMatrix(float p)
{
    if (p < 2.5) return mat3(0.939542, 0.017772, -0.001622, 0.050181, 0.965793, -0.004370, 0.010277, 0.016435, 1.005991);
    if (p < 3.5) return mat3(1.044043, 0.0, 0.0, -0.044043, 1.0, 0.011793, 0.0, 0.0, 0.988207);
    return mat3(1.081942, 0.038032, -0.007481, -0.088427, 0.959991, 0.015170, 0.006485, 0.001977, 0.992311);
}

#if defined(VERTEX)
uniform mat4 MVPMatrix;
in vec4 VertexCoord;
in vec2 TexCoord;
out vec2 vTexCoord;
flat out vec3 vWhite;
flat out vec4 vTiming;   // scan mode, PAL, interlaced, internal resolution
flat out float vPhos;    // phosphor set
flat out float vShare;   // share of the active line the source covers
flat out vec4 vSignal;  // the cable in use, the mask type (Timing: monitor switch),
                                             // X68000: rasters per row and across the picture (x68Raster)

// Blackbody colour of the TV's white, relative to D65
vec3 kelvinRGB(float T)
{
    float t = T / 100.0;
    float r = t <= 66.0 ? 255.0 : 329.698727446 * pow(t - 60.0, -0.1332047592);
    float g = t <= 66.0 ? 99.4708025861 * log(t) - 161.1195681661 : 288.1221695283 * pow(t - 60.0, -0.0755148492);
    float b = t >= 66.0 ? 255.0 : (t <= 19.0 ? 0.0 : 138.5177312231 * log(t - 10.0) - 305.0447927307);
    return clamp(vec3(r, g, b), 1.0, 255.0) / 255.0;
}

void lr_main()
{
    gl_Position = MVPMatrix * VertexCoord;
    vTexCoord = TexCoord;
    // keep white equally bright and only shift its tint
    vec3 c = pow(kelvinRGB(LR_WHITE) / kelvinRGB(6500.0), vec3(2.2));
    vWhite = c / dot(c, vec3(0.2126, 0.7152, 0.0722));
    Timing T = getTiming(LR_OriginalSize.xy, LR_FrameCount);
    vTiming = vec4(T.scan, T.pal, T.interlace, T.scale);
    vPhos = phosphorSet(T);
    vShare = activeShare(T, LR_OriginalSize.xy);
    vec3 xr = T.scan > 2.5 ? x68Raster(LR_OriginalSize.y, T.id) : vec3(1.0, 0.0, 0.0);
    vSignal = vec4(T.cable, maskType(T), xr.xy);
    // the white is set on the phosphor drives so that it ends up at the chosen colour temperature
    if (vPhos > 1.5) vWhite = inverse(phosphorMatrix(vPhos)) * vWhite;
}

void main()
{
    lr_main();
}

#elif defined(FRAGMENT)
in vec2 vTexCoord;
flat in vec3 vWhite;
flat in vec4 vTiming;
flat in float vPhos;
flat in float vShare;
flat in vec4 vSignal;
out vec4 FragColor;
uniform sampler2D Texture;
uniform sampler2D LR_GlowTexture;

// Beam of source line i at position x along the line (from the beam pass):
// rgb = square root of its linear brightness, a = which spot made it (PC monitor);
// 0 outside the picture
vec4 beamAt(float i, float x, float lines)
{
    if (i < 0.0 || i >= lines) return vec4(0.0);
    vec2 bs = vec2(textureSize(Texture, 0));
    return textureLod(Texture, vec2(x + 0.5 / bs.x, (i + 0.5) / bs.y), 0.0);
}

// TV show: the beam row at position p. A whole number is that row; between two console lines
// (a standards converter scaling NTSC to PAL or back, when the preset has no show-lines pass)
// the converter's vertical filter interpolates them, here a Catmull-Rom cubic over four lines.
vec4 showBeam(float p, float x, float lines)
{
    float g = floor(p), f = p - g;
    if (f < 1e-3) return beamAt(g, x, lines);
    vec4 a = beamAt(g - 1.0, x, lines), b = beamAt(g, x, lines);
    vec4 c = beamAt(g + 1.0, x, lines), d = beamAt(g + 2.0, x, lines);
    vec4 r = b + 0.5 * f * (c - a) + f * f * (a - 2.5 * b + 2.0 * c - 0.5 * d)
           + f * f * f * (1.5 * (b - c) + 0.5 * (d - a));
    return max(r, 0.0);
}

// The light of one line on this screen pixel: the beam's Gaussian profile (1 / isg wide, d from
// its centre, in lines) averaged over a band hw lines high around the pixel's centre, instead of
// taken at the centre alone. A screen pixel shows the average light over its height, and a narrow
// beam then keeps its brightness and shape wherever it falls between two pixel rows, so dark
// scanlines do not beat against the rows (moire). hw 0: the centre alone.
vec3 lineLight(vec3 d, vec3 isg, float hw)
{
    if (hw < 1e-3) return exp(-0.5 * d * d * isg * isg) * isg * 0.39894228;
    vec3 e = 0.5 * hw * isg;
    return (gaussCdf(d * isg + e) - gaussCdf(d * isg - e)) / hw;
}

// Rear-projection screen: lenticular sheet with thin black stripes, no RGB pattern
float lenticular(float x)
{
    float f = fract(x);
    return smoothstep(0.0, 0.18, f) * smoothstep(1.0, 0.82, f);
}

// Shadow mask: staggered round dots. s counts dot columns (3 per triad), r dot rows.
vec3 dots(float s, float r)
{
    float ci = floor(s), fx = fract(s);
    float fy = fract(r + mod(ci, 2.0) * 0.5);
    float dt = smoothstep(0.52, 0.30, length(vec2(fx - 0.5, fy - 0.5)));
    float chn = mod(ci, 3.0);
    return vec3(chn < 0.5 ? dt : 0.0, (chn > 0.5 && chn < 1.5) ? dt : 0.0, chn > 1.5 ? dt : 0.0);
}
// on the tube: 1.732 rows of dots per triad height; mp in triads
vec3 shadowDots(vec2 mp) { return dots(mp.x * 3.0, mp.y * 1.732); }

// Aperture grille / slot mask: vertical RGB stripes
vec3 stripes(float x)
{
    float s = x * 3.0;
    vec3 m;
    for (int ch = 0; ch < 3; ch++)
    {
        float d = abs(fract((s - (float(ch) + 0.5)) / 3.0 + 0.5) - 0.5) * 3.0;
        m[ch] = smoothstep(0.75, 0.35, d);
    }
    return m;
}

// Slot mask: horizontal breaks, staggered per triad column
float slotGate(float x, float y)
{
    float yy = fract(y * 0.5 + mod(floor(x), 2.0) * 0.5);
    return smoothstep(0.0, 0.12, yy) * smoothstep(1.0, 0.88, yy);
}

// The mask at 2 points across a screen pixel, or 2x2 for the slot and dot masks (a and b are the
// corners), to keep moire down. The CRT pass takes each point's light through the display's
// shoulder before averaging them (see there). Parts that only depend on x are evaluated once per
// column. Returns how many points s holds.
int maskPoints(vec2 a, vec2 b, float mt, inout vec3 s[4])
{
    if (mt > 3.5) { s[0] = vec3(lenticular(a.x)); s[1] = vec3(lenticular(b.x)); return 2; }
    if (mt > 2.5)
    {
        s[0] = shadowDots(a); s[1] = shadowDots(vec2(b.x, a.y)); s[2] = shadowDots(vec2(a.x, b.y)); s[3] = shadowDots(b);
        return 4;
    }
    vec3 ma = stripes(a.x), mb = stripes(b.x);
    if (mt > 1.5)
    {
        s[0] = ma * slotGate(a.x, a.y); s[1] = ma * slotGate(a.x, b.y); s[2] = mb * slotGate(b.x, a.y); s[3] = mb * slotGate(b.x, b.y);
        return 4;
    }
    s[0] = ma; s[1] = mb;
    return 2;
}

// Mask on screen pixels (Mask on screen pixels 1-6): the same mask with one triad every w screen
// pixels, each pixel the average of the pattern over its area (4 points across, 4 down). The
// pattern then repeats exactly every few pixels and cannot beat against the screen's own pixels
// (no moire); the number of triads follows the screen's resolution instead of the tube. The rows
// of the slot and dot masks are moved to whole pixels too, a slot's break and a dot's centre onto
// the middle of a pixel row. Two pixels cannot hold three stripes: w = 2 is magenta and green
// (a checkerboard for the dot mask), as in pixel masks for low-resolution screens.
// p: the screen pixel. Returns the mask, and in a its average (the masks' averages on the tube).
vec4 pixelMask(vec2 p, float w, float mt)
{
    vec3 m = vec3(0.0);
    if (mt > 2.5 && w > 2.5)
    {
        // dot rows: the whole number of pixels nearest the tube's spacing (1.732 rows per triad)
        float R = max(1.0, floor(w / 1.732 + 0.5));
        for (float i = 0.125; i < 1.0; i += 0.25)
            for (float j = 0.125; j < 1.0; j += 0.25)
                m += dots(3.0 * (p.x + i) / w, (p.y + j - 0.5) / R + 0.5);
        return vec4(m / 16.0, 0.19);
    }
    float avg;
    if (w < 2.5)
    {
        m = mod(p.x + (mt > 2.5 ? p.y : 0.0), 2.0) < 0.5 ? vec3(1.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        avg = 0.5;
    }
    else
    {
        for (float i = 0.125; i < 1.0; i += 0.25) m += stripes((p.x + i) / w);
        m *= 0.25;
        avg = 0.367;
    }
    if (mt > 1.5 && mt < 2.5)
    {
        // slot mask: the breaks, half a slot (w rows) lower from one triad column to the next
        float x = (p.x + 0.5) / w, g = 0.0;
        for (float j = 0.125; j < 1.0; j += 0.25) g += slotGate(x, (p.y + j - 0.5) / w);
        m *= 0.25 * g;
        avg *= w < 2.5 ? 0.88 : 0.31 / 0.367;
    }
    return vec4(m, avg);
}

vec3 shoulder(vec3 x)
{
    const float k = 0.8;
    vec3 e = max(x - k, 0.0);
    return min(x, vec3(k)) + (1.0 - k) * (1.0 - exp(-e / (1.0 - k)));
}

// Signed distance from p to a box of half size b with corners of radius r (negative inside)
float roundBox(vec2 p, vec2 b, float r)
{
    vec2 q = abs(p) - b + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

// Direction away from that box at p
vec2 boxOut(vec2 p, vec2 b, float r)
{
    return sign(p) * normalize(max(abs(p) - b + r, 1e-3));
}

// A surface turned by phi radians from facing the viewer, toward dir (z toward the viewer)
vec3 tilt(vec2 dir, float phi) { return vec3(dir * sin(phi), cos(phi)); }

// Plastic lit by the room. Diffuse: light from above, a little from the right and in front (as in
// the photos of the real monitors), plus some from the rest of the room; 1 on a surface facing
// the viewer. Sheen of a satin finish (gloss 0.5: 4% reflection head-on, more at grazing angles;
// 1 is twice that and sharper), seen from 60 cm in front of the tube: the room reflected, blurred
// (a light ceiling above, a darker desk and floor below, so faces and edges turned up look
// lighter), and the ceiling lamp, 1.2 m above the monitor, in front of it and a little to the
// right, as a soft highlight. P: position in mm (y up, z toward the viewer), n: which way the
// surface faces, occ: how much of the room's light reaches it.
vec3 plastic(vec3 albedo, vec3 n, vec3 P, vec3 light, float occ, float gloss)
{
    const vec3 L = vec3(0.3, 0.45, 0.84);
    float diffuse = 0.45 + 0.55 * max(dot(n, L), 0.0) / 0.84;
    vec3 col = albedo * diffuse;
    if (gloss > 0.0)
    {
        vec3 v = normalize(vec3(0.0, 0.0, 600.0) - P);
        vec3 r = reflect(-v, n);
        float F = 0.04 + 0.96 * pow(1.0 - max(dot(v, n), 0.0), 5.0);
        float room = 0.45 * (0.4 + 2.3 * smoothstep(-0.3, 0.7, r.y));
        vec3 l = normalize(vec3(250.0, 1200.0, 900.0) - P);
        float s = mix(12.0, 80.0, gloss);
        float lamp = 0.55 / 0.84 * max(dot(n, l), 0.0) * (s + 8.0) / 8.0 * pow(max(dot(n, normalize(l + v)), 0.0), s);
        col += 2.0 * gloss * F * (room + lamp);
    }
    return light * occ * col;
}

// Signed distance to a pill (a horizontal capsule): straight part 2h long, radius r
float pill(vec2 q, float h, float r)
{
    q.x = max(abs(q.x) - h, 0.0);
    return length(q) - r;
}

// Smooth value noise, 0..1
float valueNoise(vec2 p)
{
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash13(vec3(i, 5.0)), hash13(vec3(i + vec2(1.0, 0.0), 5.0)), f.x),
               mix(hash13(vec3(i + vec2(0.0, 1.0), 5.0)), hash13(vec3(i + 1.0, 5.0)), f.x), f.y);
}

// Smooth value noise along a line, 0..1
float noise1(float x)
{
    float i = floor(x), f = fract(x);
    return mix(hash13(vec3(i, 5.0, 1.0)), hash13(vec3(i + 1.0, 5.0, 1.0)), f * f * (3.0 - 2.0 * f));
}

// Fractal noise: three octaves of value noise, 0..1
float fbm3(vec2 p)
{
    return (4.0 * valueNoise(p) + 2.0 * valueNoise(p * 2.03 + 17.0) + valueNoise(p * 4.12 + 51.5)) / 7.0;
}

// Space (Around the tube 2): floating through space. Far away the Milky Way crosses the sky, with
// dark lanes of dust, a few clouds of glowing gas, bright stars with spikes of light and now and
// then a small galaxy; nearer stars slowly come closer and drift past. Decoration, not a
// simulation. s: screen position from the centre in screen heights, t: seconds, pix: one screen
// pixel in screen heights.
vec3 space(vec2 s, float t, float pix)
{
    vec2 drift = vec2(sin(t * 0.013), sin(t * 0.0091 + 1.3)) * 0.08;
    vec2 b = s + 0.2 * drift + vec2(0.003 * t, 0.0);          // the far sky, moving slowly
    vec3 sum = vec3(0.0);

    // the Milky Way: a band of light across the sky, warmer and brighter along its middle, in
    // clouds of stars, with dark lanes of dust
    float along = dot(b, vec2(0.92, 0.39));
    float across = dot(b, vec2(-0.39, 0.92)) + 0.05 * sin(along * 2.3 + 1.0) - 0.04;
    float mw = exp(-0.5 * across * across / 0.02), fine = 0.0;
    if (mw > 0.05)
    {
        float cl = 0.65 * valueNoise(b * 2.4 + 3.0) + 0.35 * valueNoise(b * 5.1 + 8.0);
        fine = (2.0 * valueNoise(b * 9.0 + 5.0) + valueNoise(b * 18.3 + 22.0)) / 3.0;
        float core = exp(-0.5 * across * across / 0.004);
        float ac = across + 0.012, lane = 0.0;
        if (abs(ac) < 0.13)                                  // dark lanes of dust, near its middle
            lane = smoothstep(0.5, 0.66, fbm3(vec2(along * 3.0, across * 10.0) + 11.0 + 0.4 * fine)) * exp(-0.5 * ac * ac / 0.0025);
        float g = mw * smoothstep(0.05, 0.15, mw) * (0.15 + 0.85 * cl * cl) * (0.5 + fine * fine) * (1.0 - 0.85 * lane);
        sum += mix(vec3(0.6, 0.7, 1.0), vec3(1.0, 0.94, 0.86), core) * 0.036 * g * (1.0 + core);
        fine *= 1.0 - lane;
    }

    // clouds of glowing gas, red and blue-green, in a few places, folded into filaments
    float nm = valueNoise(b * 0.8 + 31.0);
    if (nm > 0.62)
    {
        float w = (2.0 * valueNoise(b * 1.9 + 7.0) + valueNoise(b * 3.86 + 24.0)) / 3.0;
        float f = smoothstep(0.4, 0.75, fbm3(b * 3.6 + 2.5 * w + 19.0));
        float fil = 1.0 - abs(2.0 * fbm3(b * 8.0 + 3.0 * w + 23.0) - 1.0);
        float f2 = fil * fil, f8 = f2 * f2;
        f8 *= f8;
        vec3 neb = mix(vec3(0.9, 0.12, 0.35), vec3(0.15, 0.55, 0.75), smoothstep(0.4, 0.6, w));
        sum += neb * smoothstep(0.62, 0.88, nm) * f * (0.03 * f + 0.06 * f8 * f2);
    }

    // many faint stars, most of them in the Milky Way, and the dust of even fainter ones there
    for (int i = 0; i < 2; i++)
    {
        float C = i == 0 ? 0.0055 : 0.0026;
        vec2 q = b / C + float(i) * 0.37, id = floor(q);
        float h = hash13(vec3(id, 41.0 + float(i)));
        if (h < (i == 0 ? 0.1 + 0.4 * mw : 0.9 * mw * fine * fine))
        {
            vec2 at = 0.15 + 0.7 * vec2(hash13(vec3(id, 42.0)), hash13(vec3(id, 43.0)));
            float d = length(fract(q) - at) * C;
            float r0 = 0.0002, r = max(r0, 0.55 * pix);
            float hue = fract(h * 91.0);
            vec3 tint = hue < 0.5 ? vec3(0.8, 0.88, 1.0) : hue < 0.8 ? vec3(1.0) : vec3(1.0, 0.85, 0.65);
            float u = fract(h * 17.0), u3 = u * u * u;
            float br = i == 0 ? 0.04 + 0.6 * u3 * u3 : 0.025 + 0.04 * u;
            sum += tint * br * (r0 * r0) / (r * r) * exp(-0.5 * d * d / (r * r));
        }
    }

    // far away: bright stars with four spikes of light, and now and then a small galaxy
    vec2 q = b / 0.24 + 7.0, id = floor(q);
    float h = hash13(vec3(id, 71.0));
    vec2 d = (fract(q) - 0.3 - 0.4 * vec2(hash13(vec3(id, 72.0)), hash13(vec3(id, 73.0)))) * 0.24;
    if (h > 0.6)
    {
        float r = max(0.0004, 0.6 * pix), br = 0.5 + 1.5 * fract(h * 29.0);
        vec2 e = mat2(0.94, 0.34, -0.34, 0.94) * d;           // the spikes, a little turned
        float L = 0.004 + 0.01 * fract(h * 29.0);
        float spikes = (exp(-abs(e.x) / L - 0.5 * e.y * e.y / (r * r)) + exp(-abs(e.y) / L - 0.5 * e.x * e.x / (r * r)))
                     * smoothstep(0.07, 0.035, length(d));            // fading out inside the star's cell
        vec3 tint = fract(h * 13.0) < 0.6 ? vec3(0.85, 0.92, 1.0) : vec3(1.0, 0.88, 0.7);
        float dd = dot(d, d);
        sum += tint * br * (0.6 * exp(-0.5 * dd / (r * r)) + 0.025 * exp(-sqrt(dd) / 0.004) + 0.12 * spikes);
    }
    else if (h < 0.07)
    {
        float an = h * 300.0, ca = cos(an), sa = sin(an);
        vec2 g = mat2(ca, sa, -sa, ca) * d;
        g.y /= 0.3 + 0.5 * fract(h * 37.0);                   // seen at a slant
        float R = 0.026 + 0.02 * fract(h * 53.0), r = length(g) / R;
        float arms = 0.5 + 0.5 * cos(2.0 * atan(g.y, g.x) - 6.0 * log(r + 0.06));
        float disk = exp(-3.2 * r) * (0.3 + 0.7 * arms * smoothstep(0.05, 0.35, r));
        sum += vec3(0.55, 0.65, 1.0) * 0.06 * disk + vec3(1.0, 0.85, 0.65) * 0.3 * exp(-r * r / 0.01);
    }

    // nearer stars, in layers that slowly come closer
    for (int i = 0; i < 4; i++)
    {
        float k = t * 0.008 + float(i) * 0.25;
        float z = fract(k);                                   // 0 far away, 1 close
        float seed = floor(k) * 4.0 + float(i);
        float cell = 0.016 * exp2(3.0 * z);                   // stars spread apart as they come closer
        q = (s + drift * (0.15 + z)) / cell + 97.0 * fract(seed * vec2(0.6180340, 0.4142136));
        id = floor(q);
        h = hash13(vec3(id, seed + 11.0));
        if (h < 0.44) continue;
        vec2 at = 0.2 + 0.6 * vec2(hash13(vec3(id, seed + 3.0)), hash13(vec3(id, seed + 7.0)));
        float dn = length(fract(q) - at) * cell;              // in screen heights
        float r0 = mix(0.00026, 0.0007, z) * (0.7 + 0.6 * fract(h * 13.0));
        float r = max(r0, 0.6 * pix);                         // at least about a pixel, same light
        float u = fract(h * 37.0);
        float br = mix(0.15, 1.5, z * z) * (0.12 + 0.88 * u * u * u) * (r0 * r0) / (r * r);
        br *= smoothstep(0.0, 0.3, z) * (1.0 - smoothstep(0.85, 1.0, z));
        br *= 1.0 + 0.35 * (1.0 - z) * sin(t * (1.5 + 3.0 * fract(h * 53.0)) + h * 100.0);
        float hue = fract(h * 91.0);
        vec3 tint = hue < 0.5 ? vec3(0.78, 0.86, 1.0) : hue < 0.85 ? vec3(1.0) : vec3(1.0, 0.86, 0.68);
        sum += br * tint * (exp(-0.5 * dn * dn / (r * r)) + 0.07 * exp(-0.5 * dn * dn / (16.0 * r * r)));
    }
    return sum;
}

// A palm tree's silhouette, < 0 inside (roughly the distance, in screen heights). p: from the foot
// of the trunk, y up; H: its height; lean: how far the top leans to the side; sway: the crown's
// sway. Each frond is a rib that arches out and droops, with leaflets hanging from it.
float palmTree(vec2 p, float H, float lean, float sway)
{
    float yy = clamp(p.y / H, 0.0, 1.0), top = lean + sway;
    float d = abs(p.x - top * yy * yy) - mix(0.0095, 0.0055, yy) * (1.0 + 0.12 * abs(sin(p.y * 260.0)));
    d = max(d, max(-p.y, p.y - H));                           // the trunk, bending, with rings
    vec2 q = p - vec2(top, H);                                // from the crown
    if (dot(q, q) > 0.12) return d;
    float sa = 3.0 * sway;                                    // the crown turns a little as it sways
    q = mat2(cos(sa), sin(sa), -sin(sa), cos(sa)) * q;
    d = min(d, length(q) - 0.01);
    d = min(d, min(length(q - vec2(-0.008, -0.012)), length(q - vec2(0.007, -0.013))) - 0.0055);   // coconuts
    for (int i = 0; i < 10; i++)
    {
        float fi = float(i);
        float a = -0.5 + fi * 0.46 + 0.12 * sin(fi * 7.1);
        vec2 e = vec2(cos(a), sin(a));
        float L = 0.07 + 0.16 * abs(e.x) + 0.03 * fract(fi * 0.618);
        float u = dot(q, e), uu = u / L;
        if (uu <= 0.0 || uu >= 1.0) continue;
        float sx = e.x < 0.0 ? -1.0 : 1.0;
        float vb = (dot(q, vec2(-e.y, e.x)) + e.x * (0.25 + 0.4 * abs(e.x)) * L * uu * uu) * sx;   // across, > 0 above the rib
        float rib = abs(vb) - 0.0028 * (1.0 - uu * uu);
        float lf = (vb < 0.0 ? 0.042 : 0.013) * sqrt(4.0 * uu * (1.0 - uu));   // leaflets, hanging below
        float k = abs(vb) / max(lf, 1e-4);
        float ph = abs(fract((u + 1.4 * abs(vb)) / 0.0105) - 0.5);   // from the middle of the nearest leaflet
        float leaf = max(abs(vb) - lf, (ph - 0.3 * (1.0 - 0.7 * k)) * 0.0105);
        d = min(d, min(rib, leaf));
    }
    return d;
}

// Synthwave (Around the tube 3): a big striped sun behind the monitor, two ranges of mountains
// (the near one with neon lines along its slopes), palm trees at the sides, a neon grid floor that
// runs toward the viewer, a purple sky full of stars. Decoration, not a simulation. s: screen
// position from the centre in screen heights (y up), hs: half the screen's size, t: seconds,
// pix: one screen pixel in screen heights.
vec3 synthwave(vec2 s, vec2 hs, float t, float pix)
{
    const float hz = -0.12;                                       // the horizon
    float y = s.y - hz;
    vec3 col;
    if (y > 0.0)
    {
        // the sky: deep indigo above, magenta at the horizon
        col = mix(vec3(0.16, 0.008, 0.14), vec3(0.006, 0.0015, 0.025), smoothstep(0.0, 0.5, y));
        // stars, more of them high up, twinkling
        for (int i = 0; i < 2; i++)
        {
            float C = i == 0 ? 0.014 : 0.0075;
            vec2 q = s / C + 0.5 * float(i), id = floor(q);
            float h = hash13(vec3(id, 91.0 + 3.0 * float(i)));
            if (h > (i == 0 ? 0.9 : 0.86))
            {
                vec2 at = 0.2 + 0.6 * vec2(hash13(vec3(id, 92.0)), hash13(vec3(id, 93.0)));
                float d = length(fract(q) - at) * C, r = max(0.0003, 0.6 * pix);
                float br = (i == 0 ? 0.3 : 0.1) * (0.7 + 0.3 * sin(t * (1.0 + 2.0 * fract(h * 41.0)) + h * 60.0));
                col += (fract(h * 23.0) < 0.3 ? vec3(1.0, 0.7, 0.9) : vec3(0.85, 0.8, 1.0)) * br
                     * exp(-0.5 * d * d / (r * r)) * 9e-8 / (r * r) * smoothstep(0.08, 0.45, y);
            }
        }
        // the sun: yellow at the top, orange, then hot pink toward the horizon, cut by bands that
        // thicken toward the horizon and slowly move down; a glow around it
        vec2 sp = s - vec2(0.0, hz + 0.10);
        float R = 0.56, sd = length(sp) - R, v = sp.y / R;
        vec3 sun = mix(vec3(1.0, 0.04, 0.38), vec3(1.0, 0.32, 0.07), smoothstep(-0.3, 0.35, v));
        sun = mix(sun, vec3(1.0, 0.78, 0.14), smoothstep(0.35, 0.95, v)) * 0.55;
        float band = 1.0;
        if (v < 0.45)
        {
            float k = fract(v * 7.0 + t * 0.12), w = max(0.01, 7.0 * pix / R);
            float gap = mix(0.06, 0.55, smoothstep(0.45, -0.4, v));
            band = smoothstep(gap - w, gap + w, k) * smoothstep(1.0, 1.0 - w, k);
        }
        float disk = 1.0 - smoothstep(-pix, pix, sd);
        col = mix(col, sun, disk * band);
        col += sun * (1.0 - disk) * (0.35 * exp(-max(sd, 0.0) / 0.05) + 0.1 * exp(-max(sd, 0.0) / 0.25));
        // two ranges of mountains, cut in flat faces like the 3D graphics of the time: the side of a
        // peak that faces the sun is lighter. The far range is dark violet with a ridge the sun
        // behind it lights; the near one nearly black, with a neon ridge and neon lines along its
        // slopes. Both are lower toward the middle, where the sun sets (the monitor hides it anyway).
        float side = abs(s.x);
        for (int r = 0; r < 2; r++)
        {
            float W = r == 0 ? 0.075 : 0.05;
            float xw = s.x + 0.25 * W * sin(s.x * 9.0 / W * 0.1 + float(r));          // uneven spacing
            float c = floor(xw / W), f = xw / W - c;
            float h0 = hash13(vec3(c, float(r), 31.0)), h1 = hash13(vec3(c + 1.0, float(r), 31.0));
            bool peak0 = mod(c, 2.0) < 0.5;                                          // peaks and valleys take turns
            float hp = r == 0 ? 0.05 + 0.12 * (peak0 ? h0 : h1) : 0.02 + 0.05 * (peak0 ? h0 : h1);
            float hv = (r == 0 ? 0.015 : 0.006) + 0.35 * hp * (peak0 ? h1 : h0);
            float a0 = peak0 ? hp : hv, a1 = peak0 ? hv : hp;
            float lowMid = smoothstep(r == 0 ? 0.06 : 0.15, r == 0 ? 0.5 : 0.45, side);
            float mh = mix(a0, a1, f) * lowMid;                                       // the ridge here
            float md = y - mh;
            // which face: the crease runs from the peak down and a little sideways
            float px = peak0 ? c : c + 1.0;
            float facing = sign((xw / W - px - 0.35 * (mh - y) / (W * max(hp * lowMid, 1e-3))) * sign(s.x)) ;
            vec3 face = r == 0 ? (facing < 0.0 ? vec3(0.085, 0.016, 0.115) : vec3(0.035, 0.007, 0.065))
                               : (facing < 0.0 ? vec3(0.02, 0.004, 0.04) : vec3(0.008, 0.001, 0.02));
            if (r == 1 && md < 0.0)
                for (int i = 1; i < 4; i++)
                {
                    float k = float(i) * 0.25, dl = abs(y - k * mh) / max(0.0015, pix);
                    face += vec3(1.0, 0.1, 0.7) * 0.05 * k * exp(-dl) * smoothstep(0.01, 0.04, mh);
                }
            col = mix(col, face, 1.0 - smoothstep(-pix, pix, md));
            vec3 rim = r == 0 ? mix(vec3(1.0, 0.3, 0.3), vec3(0.7, 0.1, 0.8), smoothstep(0.2, 0.7, side)) * 0.12
                              : vec3(1.0, 0.1, 0.7) * 0.2;
            col += rim * exp(-abs(md) / max(0.002, pix)) * smoothstep(0.002, 0.004, mh);
        }
    }
    else
    {
        // the floor: a neon grid in perspective, running toward the viewer, fading into the haze
        float z = 1.0 / max(-y, 1e-4);
        vec2 g = vec2(s.x * z, z + 0.6 * t) * 1.5;               // grid units
        vec2 gd = abs(fract(g + 0.5) - 0.5);                     // to the nearest line
        vec2 gw = vec2(z + abs(s.x) * z * z, z * z) * 1.5 * pix; // one pixel in grid units
        vec2 line = (1.0 - smoothstep(0.03 - gw, 0.03 + gw, gd)) * (1.0 - smoothstep(0.15, 0.5, gw));
        vec2 glow = exp(-gd / (0.12 + gw)) * (1.0 - smoothstep(0.15, 0.5, gw));
        float lines = max(max(line.x, line.y), 0.3 * max(glow.x, glow.y));
        col = vec3(0.006, 0.0, 0.014) + vec3(1.0, 0.06, 0.65) * (0.55 * lines * exp(-0.08 * z));
    }
    // haze and a bright line at the horizon
    col += vec3(0.25, 0.015, 0.2) * exp(-abs(y) / 0.04) + vec3(1.0, 0.1, 0.6) * 0.25 * exp(-abs(y) / max(0.002, pix));
    // palm trees at both sides, black against the sky, with a little light from the sun on their
    // edges; their crowns sway a little
    float px = hs.x - 0.15;
    if (abs(s.x) > px - 0.2 && s.y < 0.38)
    {
        float sg = sign(s.x);
        vec2 pp = vec2(sg * s.x - px, s.y + 0.56);                  // the feet, below the bottom of the screen
        float pd = palmTree(pp, 0.64, 0.08, 0.004 * sin(t * 0.6 + sg));
        pd = min(pd, palmTree(pp - vec2(0.12, 0.0), 0.51, 0.1, 0.004 * sin(t * 0.5 + 2.0 + sg)));
        col = mix(col, vec3(0.004, 0.001, 0.01), 1.0 - smoothstep(-pix, pix, pd));
        col += vec3(1.0, 0.15, 0.55) * 0.08 * exp(-abs(pd) / max(0.0015, pix)) * smoothstep(-pix, 0.0, pd);
    }
    return col;
}

// ---------------------------------------------------------------------------
// More scenes (Around the tube 4-11). Decoration, not a simulation, all drawn here (no pictures).
// fc: the screen pixel, counted from the centre (y up). The pixel-art scenes draw their pixels as
// squares of a whole number of screen pixels and scroll in whole screen pixels, so they stay sharp.
// ---------------------------------------------------------------------------

// a colour given as 0-255 sRGB, in linear light like the picture
vec3 rgb8(float r, float g, float b) { return pow(vec3(r, g, b) / 255.0, vec3(2.2)); }

// screen pixels per pixel of a picture this many lines tall on the screen
float pixSize(float lines, float pix) { return max(1.0, floor(1.0 / (lines * pix) + 0.5)); }

// the pixel column of a layer that moves left at v screen heights per second; pixels n screen pixels wide
float layerX(float fx, float t, float v, float n, float pix) { return floor((fx + floor(t * v / pix)) / n); }

// 4x4 ordered dither threshold, 0..15/16
float bayer2(vec2 a) { return 2.0 * a.x + 3.0 * a.y - 4.0 * a.x * a.y; }
float bayer4(vec2 p) { return (4.0 * bayer2(mod(p, 2.0)) + bayer2(mod(floor(p * 0.5), 2.0))) / 16.0; }

// Tiles (4): a 90s desktop wallpaper, a small pattern in the 16 Windows colours repeated over a
// 640x480 desktop, scrolling slowly and diagonally. Eight patterns take turns every two minutes,
// dissolving into each other. p: the pattern's pixel (y up).
bool dith(vec2 p) { return mod(p.x + p.y, 2.0) < 1.0; }
// the face of the isometric cubes a pattern pixel is on: 0 top, 1 left, 2 right
int cubeFace(vec2 p)
{
    vec2 q = (p + 0.5) / 16.0;
    q.x *= 0.8660254;                                     // 2:1 pixel slopes
    float j = floor(q.y / 1.5);
    vec2 best = vec2(1e9);
    for (int i = 0; i < 2; i++)
    {
        float jj = j + float(i), sh = 0.5 * mod(jj, 2.0);
        vec2 d = q - vec2((floor(q.x / 1.7320508 - sh + 0.5) + sh) * 1.7320508, 1.5 * jj);
        if (dot(d, d) < dot(best, best)) best = d;
    }
    if (best.y * 1.7320508 > abs(best.x)) return 0;
    return best.x < 0.0 ? 1 : 2;
}
vec3 tilePattern(int k, vec2 p)
{
    const vec3 BLACK = vec3(0.0), WHITE = vec3(1.0);
    vec3 SILVER = rgb8(192.0, 192.0, 192.0), GREY = rgb8(128.0, 128.0, 128.0);
    vec3 c;
    if (k == 0)
    {
        // cubes: light on top, teal on the left, dark teal on the right; the top's upper edges catch
        // the light, the cubes' lower edges are dark
        int f = cubeFace(p), fu = cubeFace(p + vec2(0.0, 1.0)), fd = cubeFace(p - vec2(0.0, 1.0));
        c = f == 0 ? SILVER : f == 1 ? rgb8(0.0, 128.0, 128.0) : dith(p) ? rgb8(0.0, 128.0, 128.0) : BLACK;
        if (f == 0 && fu != 0) c = WHITE;
        if (f != 0 && fd == 0) c = BLACK;
    }
    else if (k == 1)
    {
        // studs: little pyramids, purple, lit from the top left, with dark lines between them
        vec2 f = mod(p, 16.0) - 7.5;
        float ax = abs(f.x), ay = abs(f.y);
        if (max(ax, ay) > 7.0) c = BLACK;
        else if (f.y >= ax) c = dith(p) ? rgb8(255.0, 0.0, 255.0) : rgb8(128.0, 0.0, 128.0);
        else if (-f.y >= ax) c = rgb8(0.0, 0.0, 128.0);
        else if (f.x < 0.0) c = rgb8(128.0, 0.0, 128.0);
        else c = dith(p) ? rgb8(128.0, 0.0, 128.0) : rgb8(0.0, 0.0, 128.0);
        if (ax < 1.0 && ay < 1.0) c = rgb8(255.0, 0.0, 255.0);   // the tip catches the light
    }
    else if (k == 2)
    {
        // bricks, raised like 90s buttons: light on the top and left edges
        float row = floor(p.y / 16.0);
        vec2 f = vec2(mod(p.x + 16.0 * mod(row, 2.0), 32.0), p.y - row * 16.0);
        c = SILVER;
        if (f.x > 30.5 || f.y < 0.5) c = BLACK;
        else if (f.x > 29.5 || f.y < 1.5) c = GREY;
        else if (f.x < 0.5 || f.y > 14.5) c = WHITE;
    }
    else if (k == 3)
    {
        // scales: rows of green scales, each row lying over the top of the row below like roof
        // tiles; a dark rim, lighter toward the middle, a shadow under the row above
        float yd = -p.y - 0.5, x = p.x + 0.5;
        float j0 = floor(yd / 8.0);
        c = BLACK;
        for (int i = 0; i < 3; i++)
        {
            float j = j0 - 1.0 + float(i);
            float cx = (floor((x - 8.0 * mod(j, 2.0)) / 16.0) + 0.5) * 16.0 + 8.0 * mod(j, 2.0);
            vec2 d = vec2(x - cx, yd - 8.0 * j);
            float r = length(d);
            if (r < 9.0 && d.y > -1.0)
            {
                c = r > 8.0 ? BLACK : r > 6.5 ? rgb8(0.0, 128.0, 0.0) : r > 4.0 ? (dith(p) ? rgb8(0.0, 255.0, 0.0) : rgb8(0.0, 128.0, 0.0)) : rgb8(0.0, 255.0, 0.0);
                if (d.y < 1.5) c = dith(p) ? rgb8(0.0, 128.0, 0.0) : BLACK;   // in the shadow of the row above
                break;
            }
        }
    }
    else if (k == 4)
    {
        // pearls on navy, round and shiny, each with a shadow at its lower right
        float row = floor(p.y / 16.0);
        vec2 f = vec2(mod(p.x + 8.0 * mod(row, 2.0), 16.0), p.y - row * 16.0) - 7.5;
        float r = length(f);
        if (r < 6.6)
        {
            vec3 n = vec3(f / 6.6, sqrt(max(1.0 - r * r / 43.56, 0.0)));
            float l = dot(n, vec3(-0.45, 0.55, 0.7));
            c = l > 0.93 ? WHITE : l > 0.6 ? rgb8(0.0, 255.0, 255.0) : l > 0.38 ? (dith(p) ? rgb8(0.0, 255.0, 255.0) : rgb8(0.0, 128.0, 128.0))
              : l > 0.1 ? rgb8(0.0, 128.0, 128.0) : (dith(p) ? rgb8(0.0, 128.0, 128.0) : rgb8(0.0, 0.0, 128.0));
        }
        else
            c = length(f - vec2(1.5, -1.5)) < 6.6 && dith(p) ? BLACK : rgb8(0.0, 0.0, 128.0);
    }
    else if (k == 5)
    {
        // weave: a straw mat, strips going across and up in turn, olive with maroon shadows
        vec2 b = floor(p / 16.0), f = p - b * 16.0;
        float w = mod(mod(b.x + b.y, 2.0) < 0.5 ? f.y : f.x, 4.0);
        c = w < 0.5 ? rgb8(128.0, 0.0, 0.0) : rgb8(128.0, 128.0, 0.0);
        if (w > 2.5 && dith(p)) c = rgb8(255.0, 255.0, 0.0);
    }
    else if (k == 6)
    {
        // honeycomb: blue cells with bevelled edges, lit from the upper left, black between them
        vec2 q = (p + 0.5) / 20.0;
        const vec2 R = vec2(1.0, 1.7320508);
        vec2 a = mod(q, R) - 0.5 * R, b = mod(q - 0.5 * R, R) - 0.5 * R;
        vec2 g = dot(a, a) < dot(b, b) ? a : b;
        float hd = max(abs(g.x), dot(abs(g), vec2(0.5, 0.8660254)));   // 0.5 at the edge
        float lit = dot(normalize(g + 1e-4), vec2(-0.6, 0.8));
        if (hd > 0.46) c = BLACK;
        else if (hd > 0.36) c = lit > 0.3 ? (dith(p) ? rgb8(0.0, 255.0, 255.0) : rgb8(0.0, 0.0, 255.0))
                              : lit < -0.3 ? (dith(p) ? rgb8(0.0, 0.0, 128.0) : BLACK) : rgb8(0.0, 0.0, 128.0);
        else c = dith(p) ? rgb8(0.0, 0.0, 255.0) : rgb8(0.0, 0.0, 128.0);
    }
    else
    {
        // argyle: maroon and grey diamonds, crossed by thin stitched white lines through their middles
        vec2 uv = vec2((p.x + 0.5) / 24.0 + (p.y + 0.5) / 36.0, (p.x + 0.5) / 24.0 - (p.y + 0.5) / 36.0);
        c = mod(floor(uv.x) + floor(uv.y), 2.0) < 0.5 ? rgb8(128.0, 0.0, 0.0) : GREY;
        vec2 dl = abs(fract(uv) - 0.5) * 14.4;                // about pixels from the lines
        if (min(dl.x, dl.y) < 0.55 && mod(p.y, 4.0) < 3.0) c = SILVER;
    }
    return c;
}
vec3 tiles(vec2 fc, float t, float pix)
{
    float n = pixSize(480.0, pix);
    vec2 p = floor((fc - floor(t * 0.012 / pix) * vec2(1.0, -1.0)) / n);   // moving right and down
    float turn = t / 120.0;
    int k = int(mod(floor(turn), 8.0));
    vec3 c = tilePattern(k, p);
    if (fract(turn) * 120.0 - 118.0 > 2.0 * bayer4(p))                    // the last two seconds: dissolve
        c = tilePattern(int(mod(float(k + 1), 8.0)), p);
    return 0.4 * c;
}
vec3 tilesLight(float t)
{
    float turn = t / 120.0;
    int k = int(mod(floor(turn), 8.0)), k1 = int(mod(float(k + 1), 8.0));
    vec3 l[8] = vec3[8](vec3(0.86, 0.98, 0.98), vec3(0.95, 0.82, 1.0), vec3(1.0), vec3(0.86, 1.0, 0.86),
                        vec3(0.8, 0.92, 1.0), vec3(1.0, 0.97, 0.8), vec3(0.82, 0.88, 1.0), vec3(1.0, 0.86, 0.84));
    return mix(l[k], l[k1], clamp(fract(turn) * 60.0 - 59.0, 0.0, 1.0));
}

// Bouncing lines (5): two four-cornered shapes whose corners bounce off the edges of the screen,
// each followed by fading copies of itself that slowly change colour along the trail, on black
// (in the spirit of the 90s screensavers). hs: half the screen's size in screen heights.
float segDist2(vec2 p, vec2 a, vec2 b)
{
    vec2 ba = b - a, pa = p - a;
    vec2 e = pa - ba * clamp(dot(pa, ba) / max(dot(ba, ba), 1e-8), 0.0, 1.0);
    return dot(e, e);
}
vec4 triWave(vec4 u) { return abs(fract(u) * 2.0 - 1.0) * 2.0 - 1.0; }
float triWave(float u) { return abs(fract(u) * 2.0 - 1.0) * 2.0 - 1.0; }
vec3 bounceLines(vec2 s, vec2 hs, float t, float pix)
{
    const float DT = 0.15, SPAN = 1.05;                       // between the copies; the whole trail
    vec3 col = vec3(0.0);
    float w = max(pix, 1.0 / 960.0);                          // half the line's width
    float m = w + 110.0 * pix;                                // as far as the glow reaches
    vec2 box = hs - 0.02;
    for (int sh = 0; sh < 2; sh++)
    {
        // where the four corners start and how fast they move (fractions of the screen per second)
        float h = float(sh * 4);
        vec4 phx = vec4(hash13(vec3(h, 1.0, 7.0)), hash13(vec3(h + 1.0, 1.0, 7.0)), hash13(vec3(h + 2.0, 1.0, 7.0)), hash13(vec3(h + 3.0, 1.0, 7.0)));
        vec4 phy = vec4(hash13(vec3(h, 2.0, 7.0)), hash13(vec3(h + 1.0, 2.0, 7.0)), hash13(vec3(h + 2.0, 2.0, 7.0)), hash13(vec3(h + 3.0, 2.0, 7.0)));
        vec4 rx = 0.035 + 0.04 * vec4(hash13(vec3(h, 3.0, 7.0)), hash13(vec3(h + 1.0, 3.0, 7.0)), hash13(vec3(h + 2.0, 3.0, 7.0)), hash13(vec3(h + 3.0, 3.0, 7.0)));
        vec4 ry = 0.035 + 0.04 * vec4(hash13(vec3(h, 4.0, 7.0)), hash13(vec3(h + 1.0, 4.0, 7.0)), hash13(vec3(h + 2.0, 4.0, 7.0)), hash13(vec3(h + 3.0, 4.0, 7.0)));
        // where each corner goes during the trail: between its newest and oldest place, or up to
        // the edge of the screen if it bounced there in between
        vec4 ux = phx + rx * t, uy = phy + ry * t;
        vec4 x1 = triWave(ux), x0 = triWave(ux - rx * SPAN), y1 = triWave(uy), y0 = triWave(uy - ry * SPAN);
        vec4 kx = floor(2.0 * ux), ky = floor(2.0 * uy);
        vec4 bx = step(0.5, kx - floor(2.0 * (ux - rx * SPAN))), by = step(0.5, ky - floor(2.0 * (uy - ry * SPAN)));
        vec4 ex = step(mod(kx, 2.0), vec4(0.5)), ey = step(mod(ky, 2.0), vec4(0.5));   // 1: bounced at the top end
        vec4 xlo = min(min(x0, x1), mix(vec4(1.0), vec4(-1.0), bx * (1.0 - ex))), xhi = max(max(x0, x1), mix(vec4(-1.0), vec4(1.0), bx * ex));
        vec4 ylo = min(min(y0, y1), mix(vec4(1.0), vec4(-1.0), by * (1.0 - ey))), yhi = max(max(y0, y1), mix(vec4(-1.0), vec4(1.0), by * ey));
        // which of the four sides (corner i to corner i+1) come near this pixel during the trail
        vec4 near = step(min(xlo, xlo.yzwx) * box.x - m, vec4(s.x)) * step(vec4(s.x), max(xhi, xhi.yzwx) * box.x + m)
                  * step(min(ylo, ylo.yzwx) * box.y - m, vec4(s.y)) * step(vec4(s.y), max(yhi, yhi.yzwx) * box.y + m);
        if (dot(near, near) < 0.5) continue;
        float d2[8];
        for (int k = 0; k < 8; k++) d2[k] = 1e9;
        for (int e = 0; e < 4; e++)
        {
            if (near[e] < 0.5) continue;
            int f = (e + 1) % 4;
            // unless a corner bounced during the trail, the copies lie evenly between the newest
            // and the oldest
            bool straight = bx[e] + by[e] + bx[f] + by[f] < 0.5;
            vec2 a0 = vec2(x1[e], y1[e]) * box, a7 = vec2(x0[e], y0[e]) * box;
            vec2 b0 = vec2(x1[f], y1[f]) * box, b7 = vec2(x0[f], y0[f]) * box;
            for (int k = 0; k < 8; k++)
            {
                vec2 a, b;
                if (straight)
                {
                    a = mix(a0, a7, float(k) / 7.0);
                    b = mix(b0, b7, float(k) / 7.0);
                }
                else
                {
                    float tk = t - DT * float(k);
                    a = vec2(triWave(phx[e] + rx[e] * tk), triWave(phy[e] + ry[e] * tk)) * box;
                    b = vec2(triWave(phx[f] + rx[f] * tk), triWave(phy[f] + ry[f] * tk)) * box;
                }
                d2[k] = min(d2[k], segDist2(s, a, b));
            }
        }
        // the colour drifts slowly, and a little further along the trail; the newest copy is the
        // brightest, with a whiter core; the glow comes from the nearest copies
        float fade = 1.0, gd = 1e9;
        vec3 gt = vec3(0.0);
        vec3 ang = TAU * (t * 0.013 + 0.5 * float(sh) + vec3(0.0, 0.33, 0.67));
        vec3 cs = cos(ang), sn = sin(ang);
        const float CD = 0.9758, SD = 0.2187;                 // cos and sin of 0.035 turns
        for (int k = 0; k < 8; k++)
        {
            vec3 tint = 0.5 + 0.5 * cs;
            tint *= tint;
            vec3 c2 = cs * CD + sn * SD;                      // the next copy's colour
            sn = sn * CD - cs * SD;
            cs = c2;
            if (d2[k] < 1e8)
            {
                float d = sqrt(d2[k]);
                float core = clamp((w - d) / pix + 0.5, 0.0, 1.0);
                col += fade * (0.8 * core * tint + (k == 0 ? 0.25 * core : 0.0));
                float dg = d + 4.0 * pix * float(k);
                if (dg < gd) { gd = dg; gt = tint; }
            }
            fade *= 0.76;
        }
        col += gt * (0.09 * exp(-gd / (3.0 * pix)) + 0.025 * exp(-gd / (12.0 * pix)));
    }
    return col;
}

// a sprite's own pixel (its centre), seen from screen pixel fc: the sprite stands at pos, in scene
// pixels of n screen pixels; it moves in whole screen pixels and keeps its big pixels
vec2 spritePix(vec2 fc, vec2 pos, float n) { return floor((fc - floor(pos * n)) / n) + 0.5; }

// signed distances to a five-pointed star and to a triangle (< 0 inside)
float sdStar5(vec2 p, float r, float rf)
{
    const vec2 k1 = vec2(0.809016994, -0.587785252), k2 = vec2(-0.809016994, -0.587785252);
    p.x = abs(p.x);
    p -= 2.0 * max(dot(k1, p), 0.0) * k1;
    p -= 2.0 * max(dot(k2, p), 0.0) * k2;
    p.x = abs(p.x);
    p.y -= r;
    vec2 ba = rf * vec2(-k1.y, k1.x) - vec2(0.0, 1.0);
    float h = clamp(dot(p, ba) / dot(ba, ba), 0.0, r);
    return length(p - ba * h) * sign(p.y * ba.x - p.x * ba.y);
}
float sdTriangle(vec2 p, float r)
{
    const float k = 1.7320508;
    p.x = abs(p.x) - r;
    p.y = p.y + r / k;
    if (p.x + k * p.y > 0.0) p = vec2(p.x - k * p.y, -k * p.x - p.y) / 2.0;
    p.x -= clamp(p.x, -2.0 * r, 0.0);
    return -length(p) * sign(p.y);
}

// Underwater (6): a calm sea floor from a 16-bit game, drawn at 224 lines. The surface ripples at
// the top; light falls in slanted rays that sway slowly; far away a reef, fish passing and now and
// then a school of small fish; on the sand rocks, corals, sponges, kelp and seaweed swaying,
// patches of light moving over it, shells and starfish; bubbles rise, specks drift down.
// hs: half the screen's size in screen heights.
float segPix(vec2 p, vec2 a, vec2 b)                         // distance to a segment
{
    vec2 ba = b - a, pa = p - a;
    return length(pa - ba * clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0));
}
vec3 underwater(vec2 fc, vec2 hs, float t, float pix)
{
    float n = pixSize(224.0, pix);
    vec2 p = floor(fc / n);
    float x = p.x + 0.5, y = p.y + 0.5;
    float L = 1.0 / (n * pix);                                // the screen's height in scene pixels
    bool dt = mod(p.x + p.y, 2.0) < 1.0;                      // every other pixel, for dithering
    // the water, lighter toward the surface, in bands with dithered edges
    float wb = clamp(floor((y + 100.0) / 26.0 + 0.4 * (bayer4(p) - 0.47)) / 7.0, 0.0, 1.0);
    vec3 col = mix(rgb8(8.0, 30.0, 70.0), rgb8(40.0, 120.0, 156.0), wb);
    // the surface, seen from below: a bright rippling edge at the top of the screen
    float ys = 0.5 * L - 7.0 + 1.6 * sin(x * 0.07 + t * 0.7) + 1.2 * sin(x * 0.19 - t * 0.5);
    if (y > ys - 1.0)
    {
        col = y < ys ? rgb8(150.0, 215.0, 230.0) : mix(col, rgb8(110.0, 190.0, 215.0), 0.45);
        if (y > ys + 1.0 && sin(x * 0.31 + 3.0 * sin(y * 0.5 + t * 0.6) - t * 0.4) > 0.6 && dt) col = rgb8(150.0, 215.0, 230.0);
    }
    // light falling in slanted rays, swaying slowly, fainter deeper down (dithered at the edges)
    float u = x + 0.5 * y;
    float ray = sin(u * 0.045 + 0.8 * sin(t * 0.13)) + 0.6 * sin(u * 0.11 - t * 0.07);
    float lit = ray > 0.95 || (ray > 0.75 && dt) ? 0.3 * smoothstep(-60.0, 90.0, y) : 0.0;
    col = mix(col, rgb8(110.0, 190.0, 210.0), lit);
    // the sand line
    float sand = -84.0 + 3.0 * sin(x * 0.06) + 2.0 * sin(x * 0.17 + 1.0);
    // a reef far away, blue in the distance, lit a little at the top
    if (y < sand + 52.0)
    {
        float spire = max(sin(x * 0.045 + 1.0), 0.0);         // now and then a taller rock
        spire *= spire;
        spire *= spire;
        float reef = sand + 6.0 + 30.0 * (0.65 * noise1(x * 0.03 + 20.0) + 0.35 * noise1(x * 0.11 + 50.0))
                   + 14.0 * spire * spire;
        if (y < reef) col = y > reef - 1.0 ? rgb8(30.0, 84.0, 110.0) : mix(rgb8(14.0, 50.0, 78.0), rgb8(20.0, 64.0, 92.0), lit * 2.0);
    }
    // fish far away, dark, crossing slowly
    float span = 2.0 * hs.x / (n * pix) + 40.0;
    if (y > -18.0 && y < 58.0)
    for (int i = 0; i < 3; i++)
    {
        float h = hash13(vec3(float(i), 3.0, 63.0));
        vec2 fp = vec2(mod(h * span + t * (4.0 + 4.0 * h), span) - 0.5 * span,
                       -10.0 + 60.0 * fract(h * 7.0) + 4.0 * sin(t * 0.4 + h * 9.0));
        vec2 d = spritePix(fc, fp, n);
        if (d.x * d.x / 36.0 + d.y * d.y / 9.0 < 1.0 || (d.x < -5.0 && d.x > -10.0 && abs(d.y) < (-4.0 - d.x) * 0.7))
            col = mix(col, rgb8(6.0, 22.0, 52.0), 0.75);
    }
    // now and then a school of small silvery fish, swimming to the left together
    float sc = t / 80.0, ci = floor(sc);
    vec2 sp = vec2(mix(0.5 * span + 30.0, -0.5 * span - 30.0, fract(sc)),
                   -30.0 + 70.0 * hash13(vec3(ci, 5.0, 66.0)) + 5.0 * sin(t * 0.35));
    if (abs(x - sp.x) < 30.0 && abs(y - sp.y) < 15.0)
        for (int i = 0; i < 12; i++)
        {
            float h = hash13(vec3(float(i), ci, 67.0));
            vec2 fp = sp + vec2(40.0 * (h - 0.5) + 2.0 * sin(t * 0.9 + h * 30.0), 18.0 * (fract(h * 13.0) - 0.5) + 1.5 * sin(t * 1.3 + h * 17.0));
            vec2 d = spritePix(fc, fp, n);
            if (d.x * d.x / 16.0 + d.y * d.y / 3.2 < 1.0)
                col = d.x < -2.0 && d.x > -3.0 && d.y > 0.0 && d.y < 1.0 ? rgb8(20.0, 40.0, 60.0)
                    : d.y > 0.0 ? rgb8(92.0, 132.0, 160.0) : rgb8(150.0, 188.0, 204.0);
            else if (d.x > 3.0 && d.x < 6.0 && abs(d.y) < 0.75 * (d.x - 2.6) && abs(d.y) > 0.9 * (d.x - 5.0))
                col = rgb8(92.0, 132.0, 160.0);
        }
    // the sand: little ripples, lighter at the top, patches of light moving over it, pebbles,
    // shells and now and then a starfish
    if (y < sand)
    {
        float dep = clamp((sand - y) / 26.0 + 0.3 * (bayer4(p) - 0.47), 0.0, 1.0);
        col = mix(rgb8(118.0, 120.0, 112.0), rgb8(78.0, 86.0, 92.0), floor(dep * 3.0) / 2.0);
        if (y > sand - 2.0) col = rgb8(138.0, 140.0, 128.0);
        else if (sin(x * 0.42 + 2.0 * sin(x * 0.05) + y * 1.3) > 0.75 && dt) col *= 0.82;
        // light through the rippling surface, in patches that drift over the sand, flattened by the
        // low angle and fading deeper into it
        float cs = sin(x * 0.17 + t * 0.5 + 1.6 * sin(y * 0.9 + x * 0.05 - t * 0.4)) + sin(x * 0.07 - t * 0.3 + y * 0.6);
        cs -= 0.04 * (sand - y);
        if (cs > 1.4 && (cs > 1.6 || dt)) col = mix(col, rgb8(175.0, 190.0, 170.0), 0.55);
        float hp = hash13(vec3(floor(x / 3.0), floor(y / 2.0), 64.0));
        if (y < sand - 2.0)
        {
            if (hp > 0.975 && mod(p.x, 3.0) < 2.0 && mod(p.y, 2.0) < 1.0) col = rgb8(70.0, 78.0, 84.0);
            else if (hp < 0.004) col = rgb8(200.0, 175.0, 170.0);
        }
        vec2 sf = vec2(x - (floor(x / 70.0) * 70.0 + 35.0 + 20.0 * (hash13(vec3(floor(x / 70.0), 1.0, 65.0)) - 0.5)), y - (sand - 12.0));
        if (hash13(vec3(floor(x / 70.0), 2.0, 65.0)) > 0.7 && sdStar5(sf, 4.2, 0.45) < 0.0) col = rgb8(196.0, 120.0, 84.0);
    }
    // on the sand: rocks, corals, sponges and kelp, one in each stretch of 30 pixels
    float c0 = floor(x / 30.0);
    if (y < -18.0)
    for (int i = -1; i <= 1; i++)
    {
        float c = c0 + float(i);
        float h = hash13(vec3(c, 11.0, 68.0)), hk = hash13(vec3(c, 12.0, 68.0));
        float ax = floor(c * 30.0 + 15.0 + 10.0 * (hk - 0.5)) + 0.5;
        float by = floor(-84.0 + 3.0 * sin(ax * 0.06) + 2.0 * sin(ax * 0.17 + 1.0));
        vec2 d = vec2(x - ax, y - by);
        if (abs(d.x) > 15.0 || d.y < -4.0 || d.y > 60.0) continue;
        float sz = 0.8 + 0.5 * fract(hk * 7.0);
        if (h < 0.25)
        {
            // a rock, lit from above
            vec2 e = vec2(d.x / (6.0 + 6.0 * fract(hk * 3.0)), (d.y + 1.0) / (4.0 + 5.0 * fract(hk * 5.0)));
            if (dot(e, e) < 1.0)
            {
                float l = -0.5 * e.x + 0.85 * e.y;
                col = l > 0.45 ? rgb8(104.0, 122.0, 130.0) : l > -0.1 ? rgb8(68.0, 86.0, 100.0) : rgb8(40.0, 54.0, 70.0);
                if (e.y > 0.55 && hash13(vec3(p, 69.0)) > 0.75) col = rgb8(52.0, 92.0, 72.0);
            }
        }
        else if (h < 0.37)
        {
            // a brain coral: a low dome with winding grooves
            float r = 7.0 * sz;
            vec2 e = vec2(d.x / r, (d.y + 0.5) / (0.75 * r));
            if (dot(e, e) < 1.0 && d.y > -1.5)
                col = sin(d.x * 1.1 + 2.5 * sin(d.y * 0.8 + hk * 9.0)) > 0.45 ? rgb8(104.0, 86.0, 74.0)
                    : (e.y > 0.5 ? rgb8(160.0, 138.0, 104.0) : rgb8(134.0, 114.0, 90.0));
        }
        else if (h < 0.52)
        {
            // a branching coral, pink, lighter at the tips
            vec2 q = vec2(d.x * (hk > 0.5 ? 1.0 : -1.0), d.y) / sz;
            float dd = min(min(segPix(q, vec2(0.0, -1.0), vec2(0.0, 8.0)), segPix(q, vec2(0.0, 4.0), vec2(-5.0, 11.0))),
                           min(segPix(q, vec2(0.0, 6.0), vec2(4.0, 13.0)), segPix(q, vec2(0.0, 8.0), vec2(0.0, 15.0))));
            dd = min(dd, min(min(segPix(q, vec2(-5.0, 11.0), vec2(-7.0, 17.0)), segPix(q, vec2(-5.0, 11.0), vec2(-3.0, 18.0))),
                             min(segPix(q, vec2(4.0, 13.0), vec2(7.0, 18.0)), segPix(q, vec2(4.0, 13.0), vec2(2.0, 20.0)))));
            if (dd * sz < 1.1) col = q.y > 15.0 ? rgb8(214.0, 136.0, 146.0) : d.x < 0.0 ? rgb8(178.0, 98.0, 114.0) : rgb8(150.0, 80.0, 100.0);
        }
        else if (h < 0.62)
        {
            // a sea fan: a flat fan on a short stem, purple, its branches darker
            vec2 q = vec2(d.x / (10.0 * sz), (d.y - 3.0) / (12.0 * sz));
            float r = length(q), an = atan(d.x, d.y - 1.0);
            if ((q.y > -0.05 && r < 1.0) || (abs(d.x) < 1.0 && d.y < 4.0 && d.y > -1.0))
                col = abs(fract(an / 0.3 + 0.5) - 0.5) < 0.12 || abs(d.x) < 1.0 ? rgb8(104.0, 62.0, 120.0)
                    : r > 0.82 ? rgb8(170.0, 116.0, 178.0) : rgb8(136.0, 88.0, 150.0);
        }
        else if (h < 0.74)
        {
            // tube sponges: three tubes, open at the top
            for (int k = 0; k < 3; k++)
            {
                float ox = float(k - 1) * 4.0 * sz, th = (9.0 + 9.0 * fract(hk * float(k + 3) * 1.7)) * sz;
                float dx = d.x - ox;
                if (abs(dx) < 2.0 && d.y > -1.0 && d.y < th)
                    col = d.y > th - 2.0 && abs(dx) < 1.0 ? rgb8(60.0, 56.0, 40.0) : dx < 0.0 ? rgb8(170.0, 156.0, 92.0) : rgb8(132.0, 118.0, 70.0);
            }
        }
        else if (h < 0.88)
        {
            // kelp: a tall stem swaying, with leaves on alternate sides
            float ht = (32.0 + 20.0 * fract(hk * 11.0)) * min(sz, 1.1);
            if (d.y > -1.0 && d.y < ht)
            {
                float k = d.y / ht;
                float sx = 4.0 * k * k * sin(t * 0.6 + hk * 20.0 + d.y * 0.05);
                float dx = d.x - sx;
                float li = floor(d.y / 6.0), side = mod(li, 2.0) < 0.5 ? -1.0 : 1.0;
                vec2 lq = vec2(dx - side * 3.0, d.y - li * 6.0 - 3.0 - side * dx * 0.3);
                if (abs(dx) < 1.0) col = rgb8(76.0, 104.0, 52.0);
                else if (li > 0.0 && lq.x * lq.x / 9.0 + lq.y * lq.y / 2.2 < 1.0) col = lq.y > 0.0 ? rgb8(104.0, 138.0, 64.0) : rgb8(68.0, 100.0, 50.0);
            }
        }
    }
    // seaweed swaying over the sand
    float sw = floor(x / 11.0), hw = y < -40.0 ? hash13(vec3(sw, 8.0, 61.0)) : 0.0;
    if (hw > 0.45)
    {
        float top = sand + 10.0 + 24.0 * fract(hw * 7.0);
        float k = clamp((y - sand) / (top - sand), 0.0, 1.0);
        float dx = abs(x - (sw * 11.0 + 5.5 + 3.0 * k * k * sin(t * 0.7 + hw * 20.0 + y * 0.08)));
        if (y < top && y > sand - 1.0 && dx < 1.5) col = dx < 0.5 ? rgb8(50.0, 120.0, 90.0) : rgb8(22.0, 78.0, 66.0);
    }
    // bubbles rising from a few places, now and then, in different sizes, wobbling
    float bc = floor(x / 48.0), hb = hash13(vec3(bc, 7.0, 61.0));
    if (hb > 0.6)
    {
        float yy = fc.y / n - t * 9.0 - 300.0 * hb, cell = floor(yy / 22.0);
        float hc = hash13(vec3(bc, cell, 62.0)), r = 1.0 + 2.8 * hc * hc;
        vec2 bp = vec2(bc * 48.0 + 8.0 + 32.0 * hb + 1.5 * sin(cell * 1.7 + t * 1.6),
                       cell * 22.0 + 11.0 + 7.0 * (fract(hc * 17.0) - 0.5) + t * 9.0 + 300.0 * hb);
        vec2 d = spritePix(fc, bp, n);
        float Lb = length(d);
        if (hc > 0.35 && Lb < r + 0.5 && y > sand + 2.0)
        {
            float a = r < 2.0 ? 0.45 : Lb > r - 1.0 ? 0.5 : 0.08;          // small ones are just a dot
            if (r >= 2.0 && length(d - vec2(-0.45, 0.45) * r) < 0.75) a = 0.75;   // the light caught on top
            col = mix(col, rgb8(170.0, 225.0, 240.0), a);
        }
    }
    // specks drifting slowly down through the water
    vec2 mq = vec2(x + 3.0 * sin(t * 0.2 + floor(y / 40.0)), y + t * 2.5);
    vec2 mc = floor(mq / 18.0);
    float hm = hash13(vec3(mc, 70.0));
    if (hm > 0.6 && all(equal(floor(mq) - mc * 18.0, floor(vec2(hm, fract(hm * 7.0)) * 17.0))) && y > sand)
        col = mix(col, rgb8(160.0, 200.0, 205.0), 0.35);
    return 0.55 * col;
}

// Copper bars (7): Amiga demo raster bars, shiny bands swinging up and down around an invisible
// cylinder, stars flying sideways behind them over a sky that the copper fades from black to
// violet, a checkerboard floor rushing toward the viewer, polished so the bars show in it.
// Drawn at 256 lines, in the Amiga's 4096 colours.
vec3 amiga12(vec3 c) { return pow(floor(clamp(c, 0.0, 1.0) * 15.0 + 0.5) / 15.0, vec3(2.2)); }
// the bars at line y (from the centre, y up; L lines on the screen): their colour (before the
// 4096 colours), and a = 1 where there is one
vec4 copperBars(float y, float t, float L)
{
    const vec3 BAR[6] = vec3[6](vec3(1.0, 0.25, 0.2), vec3(1.0, 0.6, 0.1), vec3(1.0, 0.95, 0.3),
                                vec3(0.3, 1.0, 0.35), vec3(0.2, 0.75, 1.0), vec3(0.75, 0.35, 1.0));
    vec4 c = vec4(0.0);
    float zb = -2.0;
    for (int i = 0; i < 6; i++)
    {
        float a = t * 1.1 + float(i) * TAU / 6.0, z = cos(a);
        float dy = abs(y - (0.17 * L + 0.17 * L * sin(a))) / 10.0;
        if (dy < 1.0 && z > zb)                               // the nearer ones in front, darker at the back
        {
            zb = z;
            float e = (1.0 - dy) * (1.0 - dy) * (1.0 - dy);
            c = vec4(BAR[i] * (1.0 - dy * dy) * (0.6 + 0.4 * z) + 0.25 * e * e, 1.0);
        }
    }
    return c;
}
vec3 copper(vec2 fc, vec2 hs, float t, float pix)
{
    float n = pixSize(256.0, pix);
    vec2 p = floor(fc / n);
    float L = 1.0 / (n * pix);                                // the screen's height in lines
    float y = p.y + 0.5, hz = -0.2 * L;
    vec3 col;
    if (y > hz)
    {
        // the sky: one colour per line, black high up, violet toward the horizon, which glows
        float up = (y - hz) / L;
        vec3 sky = mix(vec3(0.16, 0.06, 0.3), vec3(0.0), smoothstep(0.0, 0.35, up)) + vec3(0.35, 0.4, 0.8) * exp(-(y - hz) / 5.0);
        // stars flying to the left at three speeds, one on most lines
        if (hash13(vec3(p.y, 3.0, 17.0)) > 0.35)
        {
            float lay = floor(hash13(vec3(p.y, 4.0, 17.0)) * 3.0), w = 2.0 * hs.x * L;
            float x = mod(hash13(vec3(p.y, 5.0, 17.0)) * w - t * (14.0 + 22.0 * lay), w) - 0.5 * w;
            if (p.x == floor(x)) sky = max(sky, vec3(0.3 + 0.35 * lay));
            else if (lay > 1.5 && p.x > floor(x) && p.x < floor(x) + 4.0) sky = max(sky, vec3(0.25 - 0.06 * (p.x - floor(x))));   // a short trail
        }
        vec4 bar = copperBars(y, t, L);
        col = amiga12(bar.a > 0.0 ? bar.rgb : sky);
        if (abs(y - hz - 0.5) < 0.6) col = amiga12(vec3(0.55, 0.65, 1.0));   // the horizon
    }
    else
    {
        // the floor: a checkerboard in perspective, fading out in the distance; the bars show in
        // it upside down, clearest near the horizon
        float dy = (hz - y) / L;
        float z = 0.09 / dy;
        vec2 g = vec2((p.x + 0.5) / L * z * 7.0, z * 7.0 + t * 1.6);
        float ch = mod(floor(g.x) + floor(g.y), 2.0);
        vec3 c = mix(vec3(0.85, 0.85, 1.0), vec3(0.2, 0.1, 0.55), ch);
        float cell = max(z * 7.0 / L, 0.09 / (dy * dy) * 7.0 / L);   // cell size against a pixel
        c = mix(c, vec3(0.52, 0.48, 0.78), smoothstep(0.25, 0.6, cell));
        c *= exp(-0.12 * z);
        vec4 bar = copperBars(2.0 * hz - y, t, L);
        c = mix(c, bar.rgb, bar.a * (0.3 + 0.35 * ch) * exp(-(hz - y) / 60.0));
        c += vec3(0.2, 0.22, 0.45) * exp(-(hz - y) / 4.0);    // the horizon's glow, mirrored
        col = amiga12(c);
    }
    return 0.5 * col;
}

