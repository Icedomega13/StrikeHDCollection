# Writes a C file holding every .glsl and .glslp file under DIR (relative
# paths, NUL-terminated contents) as a table:
#   const char *embedded_file_find("curved/x.glslp", &size);
# usage: cmake -DDIR=<dir> -DOUT=<file.c> -P embed_files.cmake
file(GLOB_RECURSE files RELATIVE ${DIR} ${DIR}/*.glsl ${DIR}/*.glslp)
list(SORT files)
set(body "/* Generated by cmake/embed_files.cmake. Do not edit. */\n#include <stddef.h>\n#include <string.h>\n\n")
set(table "")
set(i 0)
foreach(f ${files})
    file(READ ${DIR}/${f} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    file(SIZE ${DIR}/${f} n)
    string(APPEND body "static const unsigned char f${i}[] = {${hex}0};\n")
    string(APPEND table "    { \"${f}\", f${i}, ${n} },\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "\nstatic const struct { const char *path; const unsigned char *data; size_t size; } files[] = {\n${table}};\n\n")
string(APPEND body "const char *embedded_file_find(const char *path, size_t *size)\n{\n")
string(APPEND body "    for (size_t i = 0; i < sizeof files / sizeof files[0]; i++)\n")
string(APPEND body "        if (!strcmp(files[i].path, path)) { if (size) *size = files[i].size; return (const char *)files[i].data; }\n")
string(APPEND body "    return NULL;\n}\n")
file(WRITE ${OUT}.tmp "${body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
file(REMOVE ${OUT}.tmp)
